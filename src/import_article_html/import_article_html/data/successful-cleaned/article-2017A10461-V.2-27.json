  "transformedHtml": "<article class=\"legal-article\" id=\"art-V-2-27\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article V.2-27</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        Dans des cas exceptionnels où, en raison de la nature du travail, l'utilisation complète et appropriée des protecteurs auditifs individuels serait susceptible d'entraîner un risque plus grand pour \n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2024-05-12/20\" data-law-type=\"AR\" data-article-number=\"105\">le bien-être</span> \n        que leur non-utilisation, une dérogation aux dispositions des articles V.2-16 et V.2-19, alinéa 1er,\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">peut être accordée.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
