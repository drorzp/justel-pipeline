  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le Comité peut uniquement délibérer valablement lorsque la moitié des membres est présente et si trois des groupes, tels que mentionnés à l'article 4, § 2,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">de la loi, sont représentés.</span></li>\n      </ol>\n      <p class=\"closing-text\">Au terme d'une deuxième convocation, le Comité délibère cependant valablement, indépendamment du nombre de membres présents.</p>\n    </div>\n  </div>\n</article>",
