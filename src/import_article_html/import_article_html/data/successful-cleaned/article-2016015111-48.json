  "transformedHtml": "<article class=\"legal-article\" id=\"art-48\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 48</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le rapport de justification financière de la subvention des coupoles et fédérations comprend les éléments suivants :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">pour la partie forfaitaire visée à l'article 28, § 3, alinéa 1er, 1°, la liste des employés à charge de la subvention en spécifiant leur fonction et leur durée totale de travail sur l'année, exprimé en équivalent temps plein;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">pour les coûts opérationnels additionnels visés à l'article 28, § 3, alinéa 1er, 2°, les informations prévues à l'article 47, § 1,</span>\n                    <ol class=\"sub-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"1°\">\n                            <span class=\"sub-provision-text\">1°</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"2°\">\n                            <span class=\"sub-provision-text\">2°</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"4°\">\n                            <span class=\"sub-provision-text\">4°</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"6°\">\n                            <span class=\"sub-provision-text\">et 6°.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
