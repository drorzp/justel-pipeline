  "transformedHtml": "<article class=\"legal-article\" id=\"art-99\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 99</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article XI 86, § 1, du même statut, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au point 3° sont ajoutés les mots &quot; du fonctionnaire, de son époux/épouse ou du partenaire cohabitant &quot;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">aux points 5° et 6°, les mots &quot; parent ou allié &quot; sont suivis par les mots &quot; du fonctionnaire ou du partenaire cohabitant &quot;.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
