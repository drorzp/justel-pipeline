  "transformedHtml": "<article class=\"legal-article\" id=\"art-98\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 98</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 28 du même décret, les modifications suivantes sont introduites:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1.\">\n          <span class=\"provision-text\">à l'alinéa 1er, la première phrase est remplacée par la phrase suivante: \" Il est institué un ou plusieurs jurys de l'épreuve de certification composés de la manière suivante: \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"2.\">\n          <span class=\"provision-text\">aux points </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">2°</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">3°</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"4°\">\n              <span class=\"provision-text\">4°</span>\n            </li>\n          </ol>\n          <span class=\"provision-text\">de l'alinéa 1er, le mot \" trois \" est remplacé par le mot \" deux \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"3.\">\n          <span class=\"provision-text\">au point </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">2° de l'alinéa 1er, le terme \" définitifs \" est supprimé</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"4.\">\n          <span class=\"provision-text\">à l'alinéa 4, les termes \" ce jury \" sont remplacés par \" ce ou ces jurys \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"5.\">\n          <span class=\"provision-text\">à l'alinéa 5, les termes \" du jury \" sont remplacés par les termes \" du ou des jurys \"</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
