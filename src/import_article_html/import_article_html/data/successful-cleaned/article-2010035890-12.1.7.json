  "transformedHtml": "<article class=\"legal-article\" id=\"art-12-1-7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 12.1.7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 7, § 1er du même arrêté, modifié par l'arrêté du Gouvernement flamand du 13 mars 2009, les mots \" l'article 18quater, § 1er, alinéa premier,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à</span>\n                </li>\n                <li class=\"provision\" data-number=\"9°\">\n                    <span class=\"provision-text\">compris, du décret du 17 juillet 2000 relatif à l'organisation du marché de l'électricité, ou telle que visée à l'article 17ter, § 1er, alinéa premier,</span>\n                </li>\n            </ol>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à</span>\n                </li>\n                <li class=\"provision\" data-number=\"8°\">\n                    <span class=\"provision-text\">compris, du décret du 6 juillet 2001 relatif à l'organisation du marché du gaz \" sont remplacés par les mots \" l'article 6.1.2, § 1er,</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">1°, 2°, 3°, 4°, 5°, 6°,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">8°, du décret relatif à l'énergie du 8 mai 2009 \".</p>\n        </div>\n    </div>\n</article>",
