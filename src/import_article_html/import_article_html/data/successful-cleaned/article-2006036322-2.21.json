  "transformedHtml": "<article class=\"legal-article\" id=\"art-2-21\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2.21</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 139 du même décret, modifié par le décret du 28 juin 2002, est remplacé par la disposition suivante :</p>\n      <p class=\"intro-text\">\" Article 139 Le Gouvernement flamand précise les conditions pour l'obtention des périodes complémentaires visées à l'article 138,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\"></span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\"></span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\"></span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\"></span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <p class=\"closing-text\">7°, ainsi que le nombre et le mode de calcul.</p>\n    </div>\n  </div>\n</article>",
