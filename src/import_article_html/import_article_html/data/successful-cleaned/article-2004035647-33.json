  "transformedHtml": "<article class=\"legal-article\" id=\"art-33\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 33</h2>\n    </header>\n    <div class=\"article-content\">\n        A l'article 42 du même décret, modifié par le décret du 20 décembre 1996, sont apportées les modifications suivantes :\n        <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n                <span class=\"provision-text\">au § 2, 3°, les mots \"à trois mois\" sont remplacés par les mots \" à douze mois au maximum\";</span>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n                <span class=\"provision-text\">\n                    le § 4 est remplacé par la disposition suivante :\n                    <section class=\"paragraph\">\n                        <h3 class=\"paragraph-marker\">§ 4.</h3>\n                        <div class=\"paragraph-content\">\n                            Le Gouvernement peut imposer une ou plusieurs des sanctions visées au § 2,\n                            <ol class=\"numbered-provisions\">\n                                <li class=\"sub-provision\" data-marker=\"1°\">1°,</li>\n                                <li class=\"sub-provision\" data-marker=\"2°\">2° et</li>\n                                <li class=\"sub-provision\" data-marker=\"3°\">3° à toute association sportive qui n'obtempère pas à la sommation visée au § 1er et qui, en violation des dispositions de l'article 4, alinéa premier,</li>\n                            </ol>\n                            <ol class=\"numbered-provisions\">\n                                <li class=\"sub-provision\" data-marker=\"1°\">1°,</li>\n                                <li class=\"sub-provision\" data-marker=\"2°\">2°,</li>\n                                <li class=\"sub-provision\" data-marker=\"3°\">3° et</li>\n                                <li class=\"sub-provision\" data-marker=\"4°\">4°, l'article 4, alinéa deux et les articles 5, 6, 7 et 8 néglige de concrétiser les dispositions du présent décret. \"</li>\n                            </ol>\n                        </div>\n                    </section>\n                </span>\n            </li>\n        </ol>\n    </div>\n</article>",
