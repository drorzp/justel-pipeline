  "transformedHtml": "<article class=\"legal-article\" id=\"art-89\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 89</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 148 de la loi du 27 décembre 2006 portant des dispositions diverses (I), remplacé par la loi du 27 avril 2007, l'alinéa 2 est remplacé par ce qui suit :</p>\n            <p class=\"intro-text\">\"Par dérogation aux dispositions de l'alinéa 1er, les articles 114 et 115 produisent leurs effets le 1er janvier 2007 et les articles 116,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à 3°, 121, 122, 125 et 146,</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"18°\"><span class=\"provision-text\">produisent leurs effets le 1er janvier 2009.\"</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
