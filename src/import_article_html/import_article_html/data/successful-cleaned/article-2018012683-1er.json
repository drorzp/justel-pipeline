  "transformedHtml": "<article class=\"legal-article\" id=\"art-1er\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1er</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2022-04-25/01\" data-law-type=\"DIVERS\" data-article-number=\"1\">\n                <p class=\"intro-text\">Au sein de l'Administration générale de la Documentation patrimoniale, l'Administration Sécurité juridique est chargée de l'exécution des tâches décrites à l'article 6 de l'arrêté royal du 3 décembre 2009 organique des services opérationnels du Service public fédéral Finances, à l'exception :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">\n                            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-11-09/01\" data-law-type=\"ARR\" data-article-number=\"1\">\n                                des points\n                                <ol class=\"numbered-provisions\">\n                                    <li class=\"sub-provision\" data-marker=\"4°\">\n                                        <span class=\"provision-text\">à</span>\n                                    </li>\n                                    <li class=\"sub-provision\" data-marker=\"7°\">\n                                        <span class=\"provision-text\">et</span>\n                                    </li>\n                                    <li class=\"sub-provision\" data-marker=\"13°\">\n                                        <span class=\"provision-text\">de l'alinéa 1er de cet article ;</span>\n                                    </li>\n                                </ol>\n                            </span>\n                        </span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">des tâches dont est chargée, en particulier, l'Administration Mesures et Evaluations ou l'Administration Collecte et Echange d'informations.</span>\n                    </li>\n                </ol>\n            </span>\n        </div>\n    </div>\n</article>",
