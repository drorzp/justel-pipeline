  "transformedHtml": "<article class=\"legal-article\" id=\"art-5N\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5N</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">5. ANNULATION DE VOYAGES PAR SUITE DE CIRCONSTANCES IMPREVISIBLES.</p>\n            <p class=\"intro-text\">Lorsqu'un ou plusieurs voyages cargo sont annulés, programmés ou à la suite de circonstances imprévisibles, les membres du personnel restent à bord du cargo pour la durée prévue de la prestation ou du voyage cargo.</p>\n        </div>\n    </div>\n</article>\n\n<article class=\"legal-article\" id=\"art-6N\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6N</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 6.1.</h3>\n                <div class=\"paragraph-content\">\n                    <p>Aucune des dispositions de la présente réglementation ne peut faire obstacle à l'exécution de travaux visés à l'article 26, § 1,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">de la loi sur le travail du 16 mars 1971.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 6.2.</h3>\n                <div class=\"paragraph-content\">\n                    <p>Les prestations afférentes à de tels travaux ne constituent jamais une infraction aux dispositions de la présente réglementation et sont, pour l'application de cette dernière, censées ne pas exister.</p>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 6.3.</h3>\n                <div class=\"paragraph-content\">\n                    <p>Les prestations visées à l'article 26, § 1,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">de la loi sur le travail du 16 mars 1971, sont réglées conformément aux dispositions de cette loi.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <p class=\"closing-text\">Vu pour être annexé à Notre arrêté du 2 décembre 1999.</p>\n            <p class=\"closing-text\">ALBERT</p>\n            <p class=\"closing-text\">Par le Roi :</p>\n            <p class=\"closing-text\">La Ministre de la Mobilité et des Transports, Mme I. DURANT</p>\n        </div>\n    </div>\n</article>",
