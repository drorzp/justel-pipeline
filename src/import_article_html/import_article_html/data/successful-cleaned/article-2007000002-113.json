  "transformedHtml": "<article class=\"legal-article\" id=\"art-113\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 113</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le Ministre détermine l'entrée en vigueur des dispositions visées aux articles 51 à 53 inclus. Dans l'attente, les examens sont dispensés par l'organisme de formation où le candidat a suivi la formation.</p>\n            <p class=\"intro-text\">(NOTE : entrée en vigueur des articles suivants :</p>\n            <ul class=\"hyphenated-items\">\n                <li class=\"hyphenated-item\"><span class=\"item-text\">2, 3°, c), 2, 5°, 4, 23, 24, 27, 28, 29, 30, 31, 32, 33, 59, (74, 4° et 5°, et 105), [...] fixée au 03-05-2007 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 1°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">25, 41, 42 fixée au 01-06-2007</span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">9, 10, 12, 74, 1°, 2°, 102, 103, 106, 107 fixée au 01-01-2008</span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(104) fixée au 01-02-2008 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 2°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(3, 1°) fixée au 01-03-2008 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 3°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(22) fixée au 01-04-2008 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 4°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(2, 1° et 2°, 2, 3°, a) et b)) fixée au 01-05-2008 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 5°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(17 et 18) fixée au 01-06-2008 <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"MB\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;MB 2008-02-21/39, art. 2, 6°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">3, 10° fixée au 01-04-2008, sauf pour l'obligation d'être détenteur de l'&quot; attestation - exercices de tir &quot;, qui est applicable à partir du 01-04-2007</span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(3, 3° et 13°) fixée au 01-01-2009 par AM [2007-04-13/31](https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2007041331), art. 1) <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"MB\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;MB 2008-02-21/39, art. 2, 7°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">(- 3, 6°, 3, 7°, 13 et 15, fixée au 01-07-2008; </span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">3, 2° et 3, 4°, fixée au 01-08-2008; </span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">16, fixée au 01-09-2008; </span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">3, 5°, fixée au 01-10-2008; </span></li>\n                <li class=\"hyphenated-item\"><span class=\"item-text\">14, fixée au 01-12-2008.) <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2008-02-21/39\" data-law-type=\"AM\" data-article-number=\"2\" data-citation-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&amp;lg_txt=f&amp;cn_search=2008022139\">&lt;AM 2008-02-21/39, art. 2, 10°, 002; En vigueur : 20-03-2008&gt;</span></span></li>\n            </ul>",
