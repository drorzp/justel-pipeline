  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Lorsqu'un numéro de client est lié contractuellement à plusieurs cartes ou terminaux, l'opérateur envoie le message d'alerte :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à la personne qui est responsable du paiement de la facture ou</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au numéro auquel se rapporte le dépassement du plafond ou</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">aux deux destinataires mentionnés en 1° et 2°.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
