  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 7 du même arrêté, modifié par les arrêtés royaux des 19 septembre 1962, 25 avril 1966 et 9 juillet 1976, sont apportées les modifications suivantes :</p>\n      <ol class=\"sub-provisions\">\n        <li class=\"sub-provision\" data-marker=\"a)\">\n          <span class=\"provision-text\">le 1° est remplacé par la disposition suivante :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">être citoyen de l'Union européenne</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"sub-provision\" data-marker=\"b)\">\n          <span class=\"provision-text\">les dispositions 5°, 6° et 7° sont abrogées.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
