  "transformedHtml": "<article class=\"legal-article\" id=\"art-XI-235\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article XI.235</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        Les auteurs ont droit à une rémunération pour la reproduction sur papier ou sur un support similaire de leurs oeuvres, \n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-12-22/03\" data-law-type=\"L\" data-article-number=\"27\">\n          lorsque cette reproduction est effectuée dans les conditions fixées par les articles XI.190, 5° et XI.191, § 1er, 1°.\n        </span>\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">et XI.191, § 1er,</span>\n        </li>\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\"></span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
