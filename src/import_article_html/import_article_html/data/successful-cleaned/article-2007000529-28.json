  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 28</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2018-12-06/34\" data-law-type=\"AR\" data-article-number=\"3\">\n                Dans l'attente de l'entrée en vigueur de l'arrêté ministériel visé à l'article 25/3, § 1er, 2°, alinéa 4, la centrale d'alarme pour eCalls privés évalue, en l'absence de contact vocal, si les conditions:\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">1°</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">de l'article 25/2 sont remplies en se basant sur les données disponibles et les éventuels sons ambiants.</span>\n                    </li>\n                </ol>\n            </span>\n        </div>\n    </div>\n</article>",
