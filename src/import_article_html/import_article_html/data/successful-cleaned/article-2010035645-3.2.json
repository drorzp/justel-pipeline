  "transformedHtml": "<article class=\"legal-article\" id=\"art-3-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3.2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">La dispense, visée à l'article 3.1, vaut uniquement lorsque les actes remplissent toutes les conditions suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-07-15/42\" data-law-type=\"AGF\" data-article-number=\"9\">les actes visés à l'art. 3.1, 1° à 5° et <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2024-06-07/26\" data-law-type=\"AGF\" data-article-number=\"6\">7° /2 à 13°</span>, sont exécutés entièrement dans un rayon de 30 mètres <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2024-06-07/26\" data-law-type=\"AGF\" data-article-number=\"6\">du bâtiment principalement autorisé ou censé autorisé concerné</span>;</span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">aucune modification de fonction soumise à autorisation n'est réalisée.</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-07-15/42\" data-law-type=\"AGF\" data-article-number=\"9\">...</span>\n          </span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
