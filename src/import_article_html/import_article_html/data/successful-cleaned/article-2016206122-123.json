  "transformedHtml": "<article class=\"legal-article\" id=\"art-123\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 123</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 390.D, alinéa 1er, du même Code, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"a)\">\n          <span class=\"provision-text\">les 1° et 2 sont remplacés par ce qui suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">2.500 euros par meublé de vacances pouvant accueillir au maximum quinze personnes;</span>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">7.000 euros par meublé de vacances pouvant accueillir plus de quinze personnes;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"b)\">\n          <span class=\"provision-text\">le 3° est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
