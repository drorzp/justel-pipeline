  "transformedHtml": "<article class=\"legal-article\" id=\"art-36\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 36</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le Gouvernement flamand fixe la date d'entrée en vigueur du présent décret.</p>\n      <p class=\"note-text\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2006-03-31/54\" data-law-type=\"AGF\" data-article-number=\"77\">\n          NOTE : Entrée en vigueur fixée le 01-04-2006 par AGF \n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2006033154\" class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2006-03-31/54\" data-law-type=\"AGF\" data-article-number=\"77\">[2006-03-31/54]</a>, art. 77, 2°, à l'exception de :\n        </span>\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"a)\">\n          <span class=\"provision-text\">l'article 32, 1° et 2°;</span>\n        </li>\n        <li class=\"provision\" data-number=\"b)\">\n          <span class=\"provision-text\">l'article 32, 3°, dans la mesure où il s'agit des dispositions mentionnées à l'article 62 d'AGF \n            <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2006033154\" class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2006-03-31/54\" data-law-type=\"AGF\" data-article-number=\"62\">[2006-03-31/54]</a>\n          </span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
