  "transformedHtml": "<article class=\"legal-article\" id=\"art-255\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 255</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Sont applicables aux stagiaires les dispositions suivantes du Livre I :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">du Titre premier, Des droits et devoirs des agents</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">du Titre V, chapitre III, section III, de la dispense de service pour formation de carrière</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">du Titre VII, Des incompatibilités</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">du Titre X, Du régime disciplinaire</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">du Titre XI, De la Chambre de recours</span>\n                </li>\n                <li class=\"provision\" data-number=\"6°\">\n                    <span class=\"provision-text\">du Titre XII, De la suspension dans l'intérêt du service</span>\n                </li>\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">des articles 177 à 181, 1° et 2° du titre XIII, chapitre premier, Des positions administratives</span>\n                </li>\n                <li class=\"provision\" data-number=\"8°\">\n                    <span class=\"provision-text\">du Titre XIV, De la perte de la qualité d'agent et de la cessation des fonctions</span>\n                </li>\n                <li class=\"provision\" data-number=\"9°\">\n                    <span class=\"provision-text\">du Titre XV, Du statut pécuniaire.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
