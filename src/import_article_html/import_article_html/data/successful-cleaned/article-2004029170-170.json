  "transformedHtml": "<article class=\"legal-article\" id=\"art-170\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 170</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 33 du décret du 5 août 1995 précité sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au 2°, les mots \" 2 années \" sont remplacés par \" 3 années \";</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">le 3° est remplacé par \" au moins 1 ou 2 années pour l'obtention d'un des grades visés à l'article 18, § 2; \";</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">le 4° est supprimé;</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">les 5° et 6° deviennent 4° et 5°.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
