  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 12</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Sont exemptés des dispositions prévues à l'article 8,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1°</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">2°</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">3°</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">4°</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5°</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">7°</span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">du présent arrêté, les organisateurs de concours de paris, dont l'entreprise répond aux conditions suivantes :</span>\n                    <ol class=\"nested-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"a)\"><span class=\"provision-text\">aucun bénéfice pour l'organisateur :</span></li>\n                        <li class=\"sub-provision\" data-marker=\"b)\"><span class=\"provision-text\">frais généraux inférieurs à 5 % du montant brut des enjeux;</span></li>\n                        <li class=\"sub-provision\" data-marker=\"c)\"><span class=\"provision-text\">nombre d'intermédiaires éventuels ne dépassant pas trois;</span></li>\n                        <li class=\"sub-provision\" data-marker=\"d)\"><span class=\"provision-text\">recette brute inférieure à 10 000 F par concours.</span></li>\n                    </ol>\n                </li>\n            </ol>\n            <p class=\"closing-text\">(NOTE : Pour la Communauté française, le montant de 10 000 F est remplacé par 250 EUR \n                <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2001-11-08/51\" data-law-type=\"ACF\" data-article-number=\"32\">\n                    &lt;ACF 2001-11-08/51, art. 32, 002; En vigueur : 01-01-2002&gt;\n                </span>\n            )</p>\n        </div>\n    </div>\n</article>",
