  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 28</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\" id=\"para-1er\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">Doivent faire l'objet d'une communication préalable écrite au fonctionnaire désigné par l'<span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-11-16/05\" data-law-type=\"AM\" data-article-number=\"1\" data-referenced-text=\"administrateur général\" data-direct-article-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2011111605\">administrateur général</span> :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">toute modification aux activités exercées dans l'entrepôt fiscal;</span></li>\n          <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">toute modification à l'établissement;</span></li>\n          <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">toute modification aux installations.</span></li>\n        </ol>\n      </div>\n    </section>\n    <section class=\"paragraph\" id=\"para-2\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">Dans les cas visés au § 1er, 2° et 3°, l'entrepositaire agréé est tenu d'introduire un nouveau plan.</p>\n      </div>\n    </section>\n  </div>\n</article>",
