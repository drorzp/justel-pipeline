  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les coûts suivants sont éligibles à l'aide visée à l'article 3 :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">investissements immobiliers ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">investissements dans des installations, machines et outillage ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">investissements dans des logiciels et programmes de commande ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">les frais généraux liés aux coûts énoncés aux points 1°, 2° et 3°, à savoir les frais de recherche, d'étude et d'accompagnement.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
