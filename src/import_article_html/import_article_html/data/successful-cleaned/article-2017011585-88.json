  "transformedHtml": "<article class=\"legal-article\" id=\"art-88\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 88</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Pour la mission de conseil visée à l'article 35, alinéa premier, 1°, du décret du 12 juillet 2013, seuls les membres visés à l'article 82, alinéa premier, 2°, 3°, 7° et 8° du présent arrêté, ont voix délibérative.</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">du décret du 12 juillet 2013, seuls les membres visés à l'article 82, alinéa premier,</span>\n                            <ol>\n                                <li class=\"sub-provision\" data-marker=\"2°\">2°</li>\n                                <li class=\"sub-provision\" data-marker=\"3°\">3°</li>\n                                <li class=\"sub-provision\" data-marker=\"7°\">7°</li>\n                                <li class=\"sub-provision\" data-marker=\"8°\">8°</li>\n                            </ol>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 2.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Pour les missions de conseil visées à l'article 35, alinéa premier, 2° et 3°, du décret du 12 juillet 2013, tous les membres visés à l'article 82 du présent arrêté, ont voix délibérative.</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">du décret du 12 juillet 2013, tous les membres visés à l'article 82 du présent arrêté, ont voix délibérative.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
