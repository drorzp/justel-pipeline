  "transformedHtml": "<article class=\"legal-article\" id=\"art-25\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 25</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 19/1, alinéa 1er, du même décret, inséré par le décret du 13 mars 2014, les modifications suivantes sont apportées :</p>\n            <ol class=\"sub-provisions\">\n                <li class=\"sub-provision\" data-marker=\"a)\">\n                    <span class=\"sub-provision-text\">le mot \" Institut \" est remplacé par le mot\" centre \";</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"b)\">\n                    <span class=\"sub-provision-text\">le 3° est remplacé par ce qui suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">l'entreprise est une moyenne entreprise ou une petite entreprise;</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n            <p class=\"intro-text\">A l'article 19/1, alinéa 2, du même décret, inséré par le décret du 13 mars 2014, les 1° et 2° sont remplacés par ce qui suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">80 pour une petite entreprise;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">70 pour une moyenne entreprise.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
