  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1<span class=\"footnote footnote-reference\" data-footnote-id=\"1\">.</span></h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 1er, 2°, de l'arrêté royal du 25 octobre 1971 étendant le champ d'application de la loi du 10 avril 1971 sur les accidents du travail, modifié par l'arrêté royal du 12 août 1985, est remplacé par le texte suivant :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">\"l'article 17, § 1er, </span>\n                    <ol>\n                        <li class=\"sub-provision\" data-marker=\"2°\"><span class=\"provision-text\">2°,</span></li>\n                        <li class=\"sub-provision\" data-marker=\"3°\"><span class=\"provision-text\">3°,</span></li>\n                        <li class=\"sub-provision\" data-marker=\"4°\"><span class=\"provision-text\">4°,</span></li>\n                        <li class=\"sub-provision\" data-marker=\"5°\"><span class=\"provision-text\">5° et</span></li>\n                        <li class=\"sub-provision\" data-marker=\"6°\"><span class=\"provision-text\">6°, de l'arrêté royal précité ;\"</span></li>\n                    </ol>\n                </li>\n            </ol>\n            <p class=\"closing-text\">.</p>\n        </div>\n    </div>\n</article>",
