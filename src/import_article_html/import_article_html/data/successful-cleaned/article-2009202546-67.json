  "transformedHtml": "<article class=\"legal-article\" id=\"art-67\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 67</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 46, premier alinéa de la même loi, modifiée par la loi du 7 novembre 1988, les mots &quot; articles 6, § 1, </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\"> et </span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">, et § 2 &quot;</span></li>\n      </ol>\n      <p class=\"intro-text\"> sont remplacés par les mots &quot; article 6, § 1, </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\"> et </span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">, § 2 et § 3 &quot;.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
