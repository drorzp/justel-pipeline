  "transformedHtml": "<article class=\"legal-article\" id=\"art-42\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 42</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le montant annuel de l'allocation spéciale est diminué de la partie des ressources qui excède les montants visés à l'article 14, alinéa 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">,</span></li>\n            </ol>\n            <p class=\"intro-text\">ou à l'article 20, alinéa 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">, suivant le cas.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
