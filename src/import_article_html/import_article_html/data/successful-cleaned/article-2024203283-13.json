  "transformedHtml": "<article class=\"legal-article\" id=\"art-13\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 13</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le présent arrêté produit ses effets au 1er juillet 2021, à l'exception de l'article 4,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">qui produit ses effets au 1er janvier 2007, des articles 5, 8, 11 et 12 qui produisent leurs effets au 1er janvier 2015, de l'article 6,</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">qui produit ses effets au 1er janvier 2019,</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">et de l'article 4,</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">qui entre en vigueur au 1er février 2025.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
