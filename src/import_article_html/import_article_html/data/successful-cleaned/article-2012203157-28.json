  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 28</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les articles suivants du décret relatif à l'organisation des élections locales et provinciales ne s'appliquent pas à des élections où il est fait usage d'un système de vote numérique :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2017-06-30/30\" data-law-type=\"DCFL\" data-article-number=\"85\">l'article 42, alinéas deux, trois, quatre, cinq et six ;</span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">l'article 43;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2017-06-30/30\" data-law-type=\"DCFL\" data-article-number=\"85\">l'article 44, § 1, alinéa trois,\n              <ol class=\"numbered-sub-provisions\">\n                <li class=\"sub-provision\" data-marker=\"1°\">\n                  <span class=\"sub-provision-text\">et</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"3°\">\n                  <span class=\"sub-provision-text\">;</span>\n                </li>\n              </ol>\n            </span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">les articles 45, 46 et 47;</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">les articles 121 et 122;</span>\n    