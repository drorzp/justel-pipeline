  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 24</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 206/3, § 1er, quatrième tiret, du même Code, inséré par la loi du 21 janvier 2021, les mots &quot;l'article 198, § 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">, </span></li>\n        <li class=\"provision\" data-number=\"9° bis\"><span class=\"provision-text\"> et </span></li>\n        <li class=\"provision\" data-number=\"12°\"><span class=\"provision-text\">, </span></li>\n      </ol>\n      <p class=\"intro-text\">&quot; sont remplacés par les mots &quot;l'article 198, § 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">, </span></li>\n        <li class=\"provision\" data-number=\"9° bis\"><span class=\"provision-text\">, </span></li>\n        <li class=\"provision\" data-number=\"12°\"><span class=\"provision-text\"> et </span></li>\n        <li class=\"provision\" data-number=\"17°\"><span class=\"provision-text\">, </span></li>\n      </ol>\n      <p class=\"intro-text\">&quot;.</p>\n    </div>\n  </div>\n</article>",
