  "transformedHtml": "<article class=\"legal-article\" id=\"art-18/1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 18/1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2010-02-04/26\" data-law-type=\"L\" data-article-number=\"14\">\n        <p class=\"intro-text\">La présente sous-section s'applique :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">à la Sûreté de l'Etat pour l'exercice, <span class=\"footnote footnote-reference\" data-footnote-id=\"5\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"27\">sur ou à partir du territoire du Royaume</span>, des missions visées aux <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-01-29/09\" data-law-type=\"L\" data-article-number=\"5\">articles 7, 1° et 3° /1 <span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"3\">...</span> ;</span>, sans préjudice de l'article 18/9, § 1er, 1°;</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">au <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"3\">Service Général du Renseignement et de la Sécurité</span> <span class=\"footnote footnote-reference\" data-footnote-id=\"5\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"27\">, sans préjudice de l'article 18/9, § 1er, 2°,</span> pour l'exercice <span class=\"footnote footnote-reference\" data-footnote-id=\"5\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"27\">...</span> des missions visées aux <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-01-29/09\" data-law-type=\"L\" data-article-number=\"5\">articles 11, § 1er, 1° à 3° et 5°, et § 2</span>, <span class=\"footnote footnote-reference\" data-footnote-id=\"5\" data-dossier-number=\"2017-03-30/11\" data-law-type=\"L\" data-article-number=\"27\">à l'exception de l'interception de communications émises ou reçues à l'étranger et de l'intrusion dans un système informatique situé à l'étranger et de la prise d'images fixes ou animées effectuée à l'étranger, visées aux articles 44 à 44/5.</span></span>\n          </li>\n        </ol>\n      </span>\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"6\" data-dossier-number=\"2022-07-14/13\" data-law-type=\"L\" data-article-number=\"19\">\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">sans préjudice des 1° et 2°, aux services de renseignement et de sécurité, dans le cadre de l'article 18, paragraphe 2.</span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
