  "transformedHtml": "<article class=\"legal-article\" id=\"art-19\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 19</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Sauf dispositions contraires, sont seuls admissibles pour le calcul de l'ancienneté pécuniaire dans une fonction dirigeante les services effectifs prestés qui comportent des prestations complètes.</p>\n      <p class=\"intro-text\">Pour l'application de cet article, il est fait référence aux dispositions de l'article 11,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\"></span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
