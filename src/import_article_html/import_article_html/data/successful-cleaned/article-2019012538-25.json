  "transformedHtml": "<article class=\"legal-article\" id=\"art-25\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 25</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le présent arrêté à l'exception des articles 14, 17,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et 23, entre en vigueur le premier jour du mois qui suit l'expiration d'un délai de dix jours prenant cours le jour après la publication du présent arrêté au Moniteur belge.</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">Les articles 14, 17,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et 23 produisent leurs effets à partir du 1er avril 2019.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
