  "transformedHtml": "<article class=\"legal-article\" id=\"art-X-5-10\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article X.5-10</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le formulaire d'évaluation de santé prévu aux articles I.4-46 à I.4-52, constitue la justification pour la suspension de l'exécution du contrat de travail ou la dispense de travail visées aux articles 42, § 1er, alinéa 1er,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">et 43, § 1er, alinéa 2,</span>\n                </li>\n            </ol>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">de la loi sur le travail du 16 mars 1971.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
