  "transformedHtml": "<article class=\"legal-article\" id=\"art-52\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 52</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le présent arrêté entre en vigueur le 1er novembre 2012, à l'exception des articles 4, 18, 27,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">et 28, qui entrent en vigueur le 1er janvier 2013.</span></li>\n      </ol>\n      <p class=\"intro-text\">Les articles 9 et 31 produisent leurs effets le 1er décembre 2011. Les articles 40,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et 45 produisent leurs effets le 1er janvier 2010.</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">produit ses effets le 1er juillet 2012.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
