  "transformedHtml": "<article class=\"legal-article\" id=\"art-79\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 79</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 52 du même décret,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au paragraphe 2,</span>\n          <ul class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">alinéa 1er,</span>\n              <ul class=\"sub-provisions\">\n                <li class=\"sub-provision\" data-marker=\"*\">\n                  <span class=\"sub-provision-text\">les mots \" , le cas échéant, \" sont insérés entre le mot \" titulaire \" et les mots \" de l'emploi \" ;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"*\">\n                  <span class=\"sub-provision-text\">les mots \" le cas échéant auprès de son pouvoir organisateur d'origine \" sont supprimés ;</span>\n                </li>\n              </ul>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">alinéa 3, les points 3° et 4° deviennent les points 2° et 3° ;</span>\n            </li>\n          </ul>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au paragraphe 3, alinéa 2, du même décret,</span>\n          <ul class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">les mots \" déterminées aux articles 98 et 98/1 \" sont insérés entre les mots \" vacances annuelles \" et \" , les congés \" ;</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">les mots \" d'accueil \" sont insérés entre le mot \" congés \" et les mots \" en vue de \" ;</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">la virgule entre mot \" officieuse \" et les mots \" du placement \" est remplacée par le mot \" et \"précédé d'un espace.</span>\n            </li>\n          </ul>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
