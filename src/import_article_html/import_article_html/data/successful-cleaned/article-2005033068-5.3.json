  "transformedHtml": "<article class=\"legal-article\" id=\"art-5-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5.3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2019-05-06/10\" data-law-type=\"DCG\" data-article-number=\"178\">\n                <p class=\"intro-text\">En ce qui concerne les fonctions au sein de la haute école, il s'agit des fonctions énumérées aux articles suivants de l'arrêté royal du 2 octobre 1968 déterminant et classant les fonctions des membres du personnel directeur et enseignant, du personnel auxiliaire d'éducation, du personnel paramédical et sociopsychologique des établissements d'enseignement gardien, primaire, spécialisé, moyen, technique, artistique et normal de l'Etat et les fonctions des membres du personnel du service d'inspection chargé de la surveillance de ces établissements :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">l'article 6, D et E;</span></li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">l'article 7, </span>\n                        <ol class=\"sub-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"a)\">3bis et 4bis;</li>\n                        </ol>\n                    </li>\n                    <li class=\"provision\" data-number=\"3°\">\n                        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2021-06-28/11\" data-law-type=\"DCG\" data-article-number=\"275\">\n                            <span class=\"provision-text\">l'article 10.1, </span>\n                            <ol class=\"sub-provisions\">\n                                <li class=\"sub-provision\" data-marker=\"a)\">4° et 5°, ainsi que</li>\n                                <li class=\"sub-provision\" data-marker=\"b)\">2°.</li>\n                            </ol>\n                        </span>\n                    </li>\n                </ol>\n            </span>\n        </div>\n    </div>\n</article>",
