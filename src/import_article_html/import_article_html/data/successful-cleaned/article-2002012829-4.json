  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 104, alinéa 4, du Code judiciaire, remplacé par la loi du 7 mai 1999, est remplacé par l'alinéa suivant :</p>\n      <p class=\"intro-text\">\" Les Chambres qui connaissent de l'appel d'un jugement rendu dans un litige portant sur les matières prévues aux articles 578,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">4°</span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5°</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n        <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">10°</span></li>\n        <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">11°</span></li>\n      </ol>\n      <p class=\"intro-text\">579, 580, 582,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">3°</span></li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">4° ou concernant l'application aux employeurs de sanctions administratives prévues à l'article 583, sont composées, outre les présidents, de deux conseillers sociaux nommés respectivement au titre d'employeur et au titre de travailleur.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
