  "transformedHtml": "<article class=\"legal-article\" id=\"art-15-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 15.5</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2023-09-07/09\" data-law-type=\"ACG\" data-article-number=\"41\">\n        <p class=\"intro-text\">L'article 117, alinéas 2 et 3, de l'arrêté du 27 décembre 1996 susvisé sont rédigés comme suit:</p>\n        <p class=\"intro-text\">\"Le fonctionnaire doit introduire une demande écrite auprès du directeur délégué, au moins un mois à l'avance pour le:</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">2°</span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">3°. La décision est prise par le directeur délégué en concertation avec le supérieur hiérarchique immédiat de l'agent concerné.</span>\n          </li>\n        </ol>\n        <p class=\"closing-text\">\"</p>\n      </span>\n    </div>\n  </div>\n</article>",
