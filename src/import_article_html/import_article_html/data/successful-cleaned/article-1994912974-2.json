  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 89 du même arrêté ministériel est remplacé par la disposition suivante:</p>\n            <blockquote class=\"quoted-article\">\n                <p class=\"quoted-article-title\">Article 89.</p>\n                <p class=\"quoted-article-text\">Pour les travailleurs visés à l'article 28, § 3,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"3°\">\n                        <span class=\"provision-text\">de l'arrêté royal et pour les autres travailleurs des ports, la demande d'allocations est introduite au moyen de la souche du carnet de salaire ou du document qui en tient lieu.</span>\n                    </li>\n                </ol>\n            </blockquote>\n        </div>\n    </div>\n</article>",
