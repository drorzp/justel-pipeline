  "transformedHtml": "<article class=\"legal-article\" id=\"art-58\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 58</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-07-31/04\" data-law-type=\"L\" data-article-number=\"74\">\n                        Sauf si les condamnations suivantes sont prononcées avec sursis et pour autant que ce sursis ne soit pas révoqué, le militaire est retiré définitivement de son emploi sans l'intervention d'un conseil d'enquête s'il est condamné, conformément à l'article 19 du Code pénal ou à l'article 5 du Code pénal militaire ou à l'interdiction, même temporaire, d'un des droits visés à l'article 31, 1° et 6°, du Code pénal.\n                    </span>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 2.</h3>\n                <div class=\"paragraph-content\">\n                    La mesure est prononcée par \n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2014-04-10/06\" data-law-type=\"AR\" data-article-number=\"28\">\n                        l'autorité désignée par le Roi\n                    </span>. Toutefois, pour les officiers \n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-07-31/04\" data-law-type=\"L\" data-article-number=\"74\">\n                        ...\n                    </span>, la mesure est prononcée par le Roi.\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
