  "transformedHtml": "<article class=\"legal-article\" id=\"art-55\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 55</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p>L'article 38, § 1er, 2° et 3°, du même décret est remplacé par ce qui suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">au passage limité ou au non-passage à l'enseignement secondaire;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">à la non-délivrance d'un certificat d'études par</span>\n                    <ol class=\"sub-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"a)\">le conseil de classe;</li>\n                        <li class=\"sub-provision\" data-marker=\"b)\">le jury chargé de délivrer le titre de capacité;</li>\n                        <li class=\"sub-provision\" data-marker=\"c)\">le jury d'examens pour l'enseignement secondaire;</li>\n                        <li class=\"sub-provision\" data-marker=\"d)\">le jury d'examens pour la délivrance extrascolaire du certificat d'études de base.</li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
