  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 2 de l'arrêté royal du 11 janvier 1940 relatif à l'exécution du Code des droits d'enregistrement, d'hypothèque et de greffe, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"a)\">\n                    <span class=\"provision-text\">dans le paragraphe 1er, remplacé par l'arrêté royal du 18 juillet 2019 et modifié par l'arrêté royal du 23 novembre 2021, le:</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"4°\">\n                            <span class=\"provision-text\">est remplacé par ce qui suit :</span>\n                            <ol class=\"numbered-provisions\">\n                                <li class=\"provision\" data-number=\"4°\">\n                                    <span class=\"provision-text\">avec une carte de débit au terminal de paiement du bureau chargé de la perception et du recouvrement ;</span>\n                                </li>\n                            </ol>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"b)\">\n                    <span class=\"provision-text\">dans le paragraphe 1er/1, inséré par l'article 8 f) et modifié par l'article 8, g) et h), de l'arrêté royal du 23 novembre 2021, le:</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"4°\">\n                            <span class=\"provision-text\">et 5 sont abrogés.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
