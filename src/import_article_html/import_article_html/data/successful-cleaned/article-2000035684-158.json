  "transformedHtml": "<article class=\"legal-article\" id=\"art-158\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 158</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Dans l'article XIV 12 du même statut, modifie par les arrêtés du Gouvernement flamand des 28 avril 1998, 19 décembre 1998 et 28 janvier 2000, les mots \" l'article XIV 5, § 2,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">jusqu'à</span></li>\n        <li class=\"provision\" data-number=\"14°\"><span class=\"provision-text\">inclus,</span></li>\n        <li class=\"provision\" data-number=\"21°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">&quot;</span></li>\n      </ol>\n      <p>sont remplacés par les mots \" l'article XIV 5, § 2,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"14°\"><span class=\"provision-text\">inclus,</span></li>\n        <li class=\"provision\" data-number=\"17°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"19°\"><span class=\"provision-text\">jusqu'à</span></li>\n        <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">inclus et</span></li>\n        <li class=\"provision\" data-number=\"24°\"><span class=\"provision-text\">&quot;</span></li>\n      </ol>\n      <p>.</p>\n    </div>\n  </div>\n</article>",
