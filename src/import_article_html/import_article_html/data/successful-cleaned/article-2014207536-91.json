  "transformedHtml": "<article class=\"legal-article\" id=\"art-91\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 91</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 1424 du même Code, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à l'alinéa 1er, les mots &quot; doivent répondre &quot; sont remplacés par le mot &quot; répondent &quot;;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 3° et 4°, le mot &quot; sera &quot; est à chaque fois remplacé par le mot &quot; est &quot;;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 5°, le mot &quot; préservera &quot; est remplacé par le mot &quot; préserve &quot;.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
