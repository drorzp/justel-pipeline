  "transformedHtml": "<article class=\"legal-article\" id=\"art-10\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 10</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 15 du même arrêté sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">Au point 1° sont ajoutés les mots suivants :<br>\"ou si le directeur accorde une dérogation pour des raisons pédagogiques\";</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">Les points 2° et 3° sont remplacés par ce qui suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">en deuxième année d'études :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"a)\">\n                  <span class=\"provision-text\">s'il a réussi l'épreuve du cours de formation musicale générale;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"b)\">\n                  <span class=\"provision-text\">s'il a suivi le cours d'instrument ou de chant;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"c)\">\n                  <span class=\"provision-text\">s'il a participé aux épreuves de la première année d'études;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"3°\">\n              <span class=\"provision-text\">en troisième année d'études :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"a)\">\n                  <span class=\"provision-text\">s'il a réussi l'épreuve du cours de formation musicale générale;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"b)\">\n                  <span class=\"provision-text\">s'il a suivi le cours d'instrument ou de chant;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"c)\">\n                  <span class=\"provision-text\">s'il a participé aux épreuves de la deuxième année d'études.\".</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
