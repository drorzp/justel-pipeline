  "transformedHtml": "<article class=\"legal-article\" id=\"art-48\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 48</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 45 du même arrêté, modifié par l'arrêté du Gouvernement flamand du 26 avril 2019, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à l'alinéa premier, 2°, est ajouté le membre de phrase \" , </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"a)\">\n                            <span class=\"provision-text\">\" ;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à l'alinéa premier, 3°, le membre de phrase \" l'article 33, § 1er, alinéa 1er, 3° \" est remplacé par le membre de phrase \" l'article 33, § 1er, alinéa 1er, 2°, </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"b)\">\n                            <span class=\"provision-text\">et </span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"c)\">\n                            <span class=\"provision-text\">, </span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"3°\">\n                            <span class=\"provision-text\">, </span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"4°\">\n                            <span class=\"provision-text\">et </span>\n                        </li>\n                 