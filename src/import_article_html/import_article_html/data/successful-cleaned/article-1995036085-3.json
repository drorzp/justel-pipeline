  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Un article 14bis est inséré dans le même arrêté :</p>\n            <p class=\"intro-text\">\"Pour les centres participant au projet de politique locale en faveur des immigrés l'objet des missions est prévu à l'article 9,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">ou 10,</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">1°, d et</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">et l'objet d'autres missions convenues dans ce cadre est précisé dans la convention telle que visée à l'article 13bis, in fine.</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">En vue du maintien de leur agrément cette convention remplace les missions telles qu'elles sont précisées à l'article 9,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">ou 10,</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">1°, d et 2°.\"</p>\n        </div>\n    </div>\n</article>",
