  "transformedHtml": "<article class=\"legal-article\" id=\"art-R118\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article R118</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Loi du 9 août 1963, article 62, remplacé par la loi du 29 décembre 1990, article 44; la référence &quot;l'article 21,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <p class=\"intro-text\">12°&quot; est remplacée par la référence &quot;l'article 32, alinéa 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <p class=\"intro-text\">15°&quot;, &quot;l'article 21,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n      </ol>\n      <p class=\"intro-text\">9°&quot; par &quot;l'article 32, alinéa 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n      </ol>\n      <p class=\"closing-text\">12°&quot; et &quot;l'article 21, 12°&quot; par &quot;l'article 32, alinéa 1er, 15°&quot;.</p>\n    </div>\n  </div>\n</article>",
