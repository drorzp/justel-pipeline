  "transformedHtml": "<article class=\"legal-article\" id=\"art-11-7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 11.7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>\n                        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2017-01-27/13\" data-law-type=\"AGF\" data-article-number=\"49\">\n                            Le fonctionnaire qui a atteint l'âge de \n                            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2019-04-26/35\" data-law-type=\"AGF\" data-article-number=\"28\">63</span> \n                            ans est mis à la retraite le premier jour du mois qui suit celui au cours duquel, sans avoir été déclaré définitivement inapte, il totalise, depuis son \n                            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2019-04-26/35\" data-law-type=\"AGF\" data-article-number=\"28\">soixante-troisième</span> \n                            anniversaire, 365 jours calendaires d'absence pour maladie. \n                            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2019-04-26/35\" data-law-type=\"AGF\" data-article-number=\"28\">...</span>\n                        </span>\n                    </p>\n                    <p>\n                        Les absences en application de l'article X 22, § 1er, et de l'article X 23, § 1er, alinéa 1er, \n                        <ol class=\"numbered-provisions\">\n                            <li class=\"provision\" data-number=\"1°\">\n                                <span class=\"provision-text\"></span>\n                            </li>\n                            <li class=\"provision\" data-number=\"2°\">\n                                <span class=\"provision-text\"></span>\n                            </li>\n                            <li class=\"provision\" data-number=\"4°\">\n                                <span class=\"provision-text\">ne sont pas imputables sur le quota de 365 jours calendaires tel que visé à l'alinéa 1er.</span>\n                            </li>\n                        </ol>\n                        <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2023-09-08/23\" data-law-type=\"AGF\" data-article-number=\"17\">...</span>.\n                    </p>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
