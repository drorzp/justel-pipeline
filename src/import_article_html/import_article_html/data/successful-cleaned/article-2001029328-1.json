  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 1</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">Dans l'article 1er, § 2, 1°, du décret du 4 janvier 1999 relatif aux fonctions de promotion et de sélection, les mots \"personnel médical,\" sont insérés entre les mots \"personnel social,\" et \"personnel psychologique\".</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 3.</h3>\n      <div class=\"paragraph-content\">\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">Dans l'article 1er, § 3, 2° et 3°, du même décret, les mots \"alinéa 2\" sont remplacés par les mots \"alinéa 3\".</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
