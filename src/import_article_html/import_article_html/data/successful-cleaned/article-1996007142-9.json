  "transformedHtml": "<article class=\"legal-article\" id=\"art-9\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 9</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le présent arrêté produit ses effets le 16 août 1995, à l'exception de l'article 5,:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">qui entre en vigueur le 1er juillet 1996, et de l'article 8 qui produit ses effets le 1er mars 1996.</span>\n        </li>\n      </ol>\n      <p class=\"closing-text\">Le règlement annexé au présent arrêté est d'application à partir de l'année académique 1995-1996.</p>\n    </div>\n  </div>\n</article>",
