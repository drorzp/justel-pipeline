  "transformedHtml": "<article class=\"legal-article\" id=\"art-37\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 37</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'arrêté royal du 11 janvier 2006 mettant en application le titre IV (Réforme de la Régie des Postes) de la loi du 21 mars 1991 portant réforme de certaines entreprises publiques économiques, tel que modifié par l'arrêté royal du 19 avril 2014, sont abrogés :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">les articles 29 à 32;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">dans l'article 35, le 1° et le 5°.</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">les articles de 38 à 45.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
