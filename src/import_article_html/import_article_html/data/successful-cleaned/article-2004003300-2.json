  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 132, alinéa 1er, du Code des impôts sur les revenus 1992, modifié par les lois des 6 juillet 1994 et 24 décembre 1999, par les arrêtés royaux des 20 juillet 2000 et 13 juillet 2001 et par la loi du 10 août 2001, dont le</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">devient le</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">8°, il est inséré un</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">rédigé comme suit :</span>\n                </li>\n            </ol>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">\" pour chaque personne à charge visée à l'article 136,</span>\n                </li>\n            </ol>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">3°, et qui a atteint l'âge de 65 ans : 1.740 EUR; \".</p>\n        </div>\n    </div>\n</article>",
