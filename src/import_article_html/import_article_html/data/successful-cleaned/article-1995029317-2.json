  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Lorsque dans le courant d'une année déterminée le membre du personnel visé à l'article 1er, § 1er, ou son conjoint perçoit des allocations familiales ou des allocations qui en tiennent lieu pour au moins un enfant :</p>\n      <ul class=\"hyphenated-items\">\n        <li class=\"hyphenated-item\">\n          <span class=\"item-text\">le montant de <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-12-22/09\" data-law-type=\"ACF\" data-article-number=\"2\">7.421,57 EUROS</span> prévu à l'article 1er, § 1er, 1° et 4°, est pour cette année augmenté de <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-12-22/09\" data-law-type=\"ACF\" data-article-number=\"2\">3.710,8 EUROS</span>;</span>\n        </li>\n        <li class=\"hyphenated-item\">\n          <span class=\"item-text\">le montant de <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-12-22/09\" data-law-type=\"ACF\" data-article-number=\"2\">5.937,26 EUROS</span> prévu à l'article 1er, § 1er, 2°, est pour cette année augmenté de <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-12-22/09\" data-law-type=\"ACF\" data-article-number=\"2\">2.968,63 EUROS</span>.</span>\n        </li>\n      </ul>\n    </div>\n  </div>\n</article>",
