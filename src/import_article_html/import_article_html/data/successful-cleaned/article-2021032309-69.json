  "transformedHtml": "<article class=\"legal-article\" id=\"art-69\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 69</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 77decies, § 1er, du même décret, inséré par le décret du 6 juillet 2018 et modifié par le décret du 18 décembre 2020, le membre de phrase &quot;l'article 28, § 1er, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">et</span></li><li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">, l'article 100 terdecies ou l'article 100septiesdecies </span></li></ol>&quot; est remplacé par le membre de phrase &quot;l'article 28, § 1er, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">,</span></li><li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">et</span></li><li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">, l'article 100terdecies ou l'article 100sexies, § 1er, </span></li></ol><ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"4\"><span class=\"provision-text\">,</span></li><li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">et</span></li><li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\"></span></li></ol>&quot;.</p>\n        </div>\n    </div>\n</article>",
