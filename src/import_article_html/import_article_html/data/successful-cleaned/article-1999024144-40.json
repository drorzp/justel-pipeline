  "transformedHtml": "<article class=\"legal-article\" id=\"art-40\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 40</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 127, § 1er, b), de la même loi, modifié par la loi du 22 février 1998, est remplacé par la disposition suivante:</p>\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"b)\">\n              <span class=\"provision-text\">à tout dispensateur de soins habilité à fournir les prestations visées à l'article 34, alinéa 1er,</span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                  <span class=\"provision-text\">6), inscrit sur la liste établie par le service des soins de santé de l'institut, ou à l'article 34, alinéa 1er,</span>\n                  <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                      <span class=\"provision-text\">c),</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"4°\">\n                      <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"7° bis\">\n                      <span class=\"provision-text\">inscrit sur la liste visée à l'article 215, § 2;\".</span>\n                    </li>\n                  </ol>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
