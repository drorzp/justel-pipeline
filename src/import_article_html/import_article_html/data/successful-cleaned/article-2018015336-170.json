  "transformedHtml": "<article class=\"legal-article\" id=\"art-170\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 170</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 11, alinéa premier, du même arrêté sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les points 1° et 2° sont remplacés par ce qui suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">cinq ans après le paiement final pour des machines et installations, logiciels et programmes d'opération</span>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">dix ans après le paiement final pour des bâtiments et leur aménagement.</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">le point 3° est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
