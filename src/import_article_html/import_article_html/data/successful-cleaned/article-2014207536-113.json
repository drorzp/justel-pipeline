  "transformedHtml": "<article class=\"legal-article\" id=\"art-113\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 113</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 1473 du même Code, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 1°, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"provision-text\">les mots \" ont été \" sont remplacés par \" sont \"</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 2°, les mots \" ont été \" sont remplacés par les mots \" sont \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 4°, le mot \" pourra \" est remplacé par le mot \" peut \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">à l'alinéa 2, 6° et 7°, le mot \" seront \" est à chaque fois remplacé par le mot \" sont \"</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">à l'alinéa 3, les mots \" doit être \" sont remplacés par le mot \" est \"</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
