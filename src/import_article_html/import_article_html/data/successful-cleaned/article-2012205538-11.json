  "transformedHtml": "<article class=\"legal-article\" id=\"art-11\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 11</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p>Si un certain transfert relève du champ d'application de différentes licences générales, les licences générales, \n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"14\" data-law-type=\"article\" data-article-number=\"14\">visées à l'article 14, § 2, 3° et 4° du Décret sur le commerce des armes</span> sont utilisées par priorité pour les cas, \n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"14\" data-law-type=\"article\" data-article-number=\"14\">visés à l'article 14, § 2, 3° et 4°</span>, et, en ordre subsidiaire, la licence générale est utilisée pour le cas, \n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"14\" data-law-type=\"article\" data-article-number=\"14\">visé à l'article 14, § 2, 5°, du décret précité</span>.\n        </p>\n      </div>\n    </section>\n  </div>\n</article>",
