  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 28</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 39 de la même loi, les 8° et 9° sont remplacés par ce qui suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"8°\">\n                    <span class=\"provision-text\">dans le paragraphe 1er, alinéa unique, le</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"15°\">\n                            <span class=\"provision-text\">est rétabli dans la rédaction suivante :</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"15°\">\n                    <span class=\"provision-text\">l'indemnité visée à l'article 198/1, § 4, alinéa</span>\n                </li>\n                <li class=\"provision\" data-number=\"9°\">\n                    <span class=\"provision-text\">le paragraphe 1er, alinéa unique, est complété par un</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"16°\">\n                            <span class=\"provision-text\">, rédigé comme suit :</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"16°\">\n                    <span class=\"provision-text\">l'indemnité visée à l'article 205/5, § 3, alinéa 4, ou à l'article 205/5, § 4, alinéa 5.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
