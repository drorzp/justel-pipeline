  "transformedHtml": "<article class=\"legal-article\" id=\"art-1er\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1er</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p>Par dérogation à l'article 11, § 4,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">de l'arrêté du Gouvernement wallon du 12 décembre 2013 relatif aux organismes à finalité sociale, le montant de la subvention accordée aux agences immobilières sociales pour l'année 2021 est égal au montant de la subvention relative à l'année 2020, si le résultat de l'application du dispositif précité lui est inférieur.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n    </div>\n</article>",
