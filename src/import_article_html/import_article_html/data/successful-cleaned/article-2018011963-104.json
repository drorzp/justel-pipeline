  "transformedHtml": "<article class=\"legal-article\" id=\"art-104\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 104</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Une académie qui ne remplit pas les conditions énoncées à l'article 100, ou dans le cas d'agrément provisoire, à l'article 100,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">1°</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">2°</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">3°</span>\n                </li>\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">7°</span>\n                </li>\n                <li class=\"provision\" data-number=\"10°\">\n                    <span class=\"provision-text\">10°</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">ne peut pas porter la dénomination \" académie d'enseignement artistique à temps partiel \".</p>\n        </div>\n    </div>\n</article>",
