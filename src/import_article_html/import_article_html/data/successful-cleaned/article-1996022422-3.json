  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-1\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p><span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2015-11-30/09\" data-law-type=\"AR\" data-article-number=\"43\">Les viandes de volaille destinées à être soumises à un processus de refroidissement par immersion répondent aux exigences qui sont reprises à l'annexe II, chapitre II, 6° et 7°.</span></p>\n            </div>\n        </section>\n        <section class=\"paragraph\" id=\"para-2\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p><span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2015-11-30/09\" data-law-type=\"AR\" data-article-number=\"43\">Lors de l'utilisation du procédé de refroidissement par immersion pour les carcasses de volailles après abattage, les conditions reprises à l'annexe III, chapitre IV doivent être respectées.</span></p>\n            </div>\n        </section>\n    </div>\n</article>",
