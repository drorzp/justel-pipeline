  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 7</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Toute proposition de qualification d'enseignement des niveaux 1er à 4 inclus est présentée pour avis au VLOR. Le VLOR émet des avis sur les éléments, visés à l'article 5, 1°,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">inclus.</span></li>\n      </ol>\n      <p class=\"closing-text\">Cet avis est émis auprès de l'agence dans les trente jours calendaires.</p>\n    </div>\n  </div>\n</article>",
