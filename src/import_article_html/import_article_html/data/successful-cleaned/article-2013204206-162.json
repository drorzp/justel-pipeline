  "transformedHtml": "<article class=\"legal-article\" id=\"art-162\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 162</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 23, § 2, alinéa 1er, du même décret, les 4° et 5° sont remplacés par ce qui suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">29 jours à partir de 53 ans;</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">30 jours à partir de 55 ans;</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">Le même alinéa est complété par un 6°, rédigé comme suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"6°\">\n                    <span class=\"provision-text\">31 jours à partir de 58 ans.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
