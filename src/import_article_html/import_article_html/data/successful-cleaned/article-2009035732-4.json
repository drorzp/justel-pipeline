  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans le même arrêté est inséré un article 16/1, libellé comme suit :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">Art. 16/1.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">L'obligation de réaliser une étude de mobilité, telle que visée aux articles :</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"7°\">\n                            <span class=\"provision-text\">7°</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"10°\">\n                            <span class=\"provision-text\">et 16, 10°,</span>\n                        </li>\n                    </ol>\n                    <p class=\"intro-text\">ne s'applique pas dans les cas suivants :</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">lorsque le projet est soumis à un rapport d'incidence sur l'environnement qui analyse et évalue les effets attendus ou potentiels de ce projet sur la mobilité;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">lorsque le projet fait partie d'un projet de lotissement pour lequel une autorisation de lotissement a été délivrée, une étude de mobilité ayant été jointe à la demande de lotissement.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
