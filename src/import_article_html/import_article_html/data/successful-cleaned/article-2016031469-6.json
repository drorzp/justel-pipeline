  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 14 de la même ordonnance, modifié par les ordonnances des 18 avril 2002 et 17 février 2005, les modifications suivantes sont apportées:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">dans l'alinéa 1er, les mots \" article 13, 1° à 6° et 8° à 12° \" sont remplacés par les mots \" article 13, 1°\";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">dans l'alinéa 2, les mots \" article 13, 7° \" sont remplacés par les mots \" article 13, 2°\";</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">l'alinéa 3 est abrogé.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
