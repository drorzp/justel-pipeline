  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 7</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 10, du même arrêté, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"a)\">\n          <span class=\"provision-text\">dans l'alinéa 1er, les mots \" un visa d'engagement \" sont remplacés par les mots \" le visa d'engagement visé à l'article 9, § 1er,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">et</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"b)\">\n          <span class=\"provision-text\">dans l'alinéa 2, les mots \" leur nature le justifie \" sont insérés entre le mot \" lorsque \" et le mot \" ,soit \" ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"c)\">\n          <span class=\"provision-text\">dans l'alinéa 2, le 1° est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
