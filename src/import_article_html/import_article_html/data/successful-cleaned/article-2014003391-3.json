  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 6311, § 3, du même arrêté, inséré par l'arrêté royal du 10 septembre 2010, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">dans l'alinéa 2, le 3° est abrogé;</span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">dans l'alinéa 3, le 3° est abrogé;</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">dans l'alinéa 4, 1° et 2°, les mots \"et 3° \" sont abrogés.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
