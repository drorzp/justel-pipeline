  "transformedHtml": "<article class=\"legal-article\" id=\"art-31\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 31</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le présent arrêté produit ses effets le 1er juillet 1995, à l'exception:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">des articles 9, 11, 18, 23 à 25, 27 et 28, qui produisent leurs effets le 1er janvier 1994;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">des articles 12, 19 à 22 et 26, qui produisent leurs effets le 1er juin 1997;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">des articles 2, 3 ,1°, 4, 6, 2°, 7 à 8 et 29, qui produisent leurs effets:</span>\n                    <ul class=\"sub-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"-\">\n                            <span class=\"sub-provision-text\">le 15 septembre 1997 pour les agents des niveaux 1 et 2+;</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"-\">\n                            <span class=\"sub-provision-text\">le 15 septembre 1998 pour les agents des niveaux 2, 3 et 4;</span>\n                        </li>\n                    </ul>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">des articles 1, 2° et 30, qui entrent en vigueur le jour de leur publication au Moniteur belge;.</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">de l'article 3, 2°, qui entre en vigueur à une date fixée par Nous.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
