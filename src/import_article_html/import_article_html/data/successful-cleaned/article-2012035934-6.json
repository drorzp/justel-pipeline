  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le Gouvernement flamand ne peut agréer les soins psychiatriques en milieu familial d'un service hospitalier psychiatrique, tels que visés à l'article 2, 13°, que sur la base d'un contrat de coopération entre l'hôpital concerné et un service autorisé de placement familial. Ce contrat concerne au moins les éléments tels que visés à l'article 7, § 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">2°</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">3°</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">7°</span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">9°</span></li>\n                <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">10°</span></li>\n                <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">11°</span></li>\n                <li class=\"provision\" data-number=\"12°\"><span class=\"provision-text\">12°</span></li>\n                <li class=\"provision\" data-number=\"15°\"><span class=\"provision-text\">et 15°.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
