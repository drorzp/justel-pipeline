  "transformedHtml": "<article class=\"legal-article\" id=\"art-XV-126/2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article XV.126/2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2020-09-29/05\" data-law-type=\"L\" data-article-number=\"54\">\n                        Sans préjudice des articles XV.126 et XV.126/1, est puni d'une sanction de niveau 4:\n                        <ol class=\"numbered-provisions\">\n                            <li class=\"provision\" data-number=\"1°\">\n                                <span class=\"provision-text\">quiconque ne donne pas suite aux demandes ou mesures imposées visées aux articles XV.3, 5° /1, 5° /2, 8° et 9°, et XV.5/1;</span>\n                            </li>\n                            <li class=\"provision\" data-number=\"2°\">\n                                <span class=\"provision-text\">\n                                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-05-03/21\" data-law-type=\"L\" data-article-number=\"41\">\n                                        l'entreprise visée à l'article XV.31/2 ou à l'article XV.60/9/1 qui ne respecte pas les engagements pris ou les engagements supplémentaires qui ont été acceptés par les agents compétents.\n                                    </span>\n                                </span>\n                            </li>\n                        </ol>\n                    </span>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
