  "transformedHtml": "<article class=\"legal-article\" id=\"art-61\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 61</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'annexe au compte d'exécution du budget comprend pour les dépenses d'engagement :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">l'encours des engagements au 1er janvier</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">les crédits mentionnés au titre de l'article 5, alinéa 2, 2°, a)</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">les engagements imputés</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">la différence entre les engagements imputés mentionnés au point 3° et les crédits mentionnés au point 2°</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">les engagements annulés</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">les crédits annulés à la fin de l'année budgétaire</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">l'encours des engagements au 31 décembre.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
