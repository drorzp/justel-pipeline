  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 138, § 1er, alinéa premier, du même décret, modifié en dernier lieu par le décret du 15 mars 2019, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au point 8°, le membre de phrase \" , l'aide à la décision politique et la professionnalisation \" est abrogé ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">il est ajouté un point 9° et un point 10°, rédigés comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"9°\">\n                            <span class=\"provision-text\">des périodes de cours pour le soutien de la tâche principale du personnel enseignant ;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"10°\">\n                            <span class=\"provision-text\">des périodes de cours pour faire l'école ensemble.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
