  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article R.93ter du même Code, inséré par l'arrêté du Gouvernement wallon du 5 février 2015, est complété par un alinéa rédigé comme suit:</p>\n            <p class=\"intro-text\">\" Les agents visés à l'alinéa 1er sont chargés de rechercher et de constater les infractions aux dispositions prévues aux articles D.396,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">D.397 et D.398 du Code wallon de l'Agriculture.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
