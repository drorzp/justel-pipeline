  "transformedHtml": "<article class=\"legal-article\" id=\"art-21\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 21</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p>Un 5°, rédigé comme suit, est inséré dans l'article 19, § 2, du même décret :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">du Ministre ayant l'Audiovisuel dans ses attributions, ou de ses délégués dûment mandatés, uniquement dans les cas visés aux 5°, 10° et 11° du § 1er.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p>Un 6°, rédigé comme suit, est inséré dans l'article 19, § 2, du même décret :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"6°\">\n            <span class=\"provision-text\">Les délégations syndicale et patronale peuvent chacune se faire accompagner d'un expert.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
