  "transformedHtml": "<article class=\"legal-article\" id=\"art-33\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 33</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 4 du même arrêté sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">Au point 1° est ajouté un deuxième tiret, rédigé comme suit :</span>\n          <ul class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">animation</span>\n            </li>\n          </ul>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">Au point 2°, le troisième tiret est remplacé par ce qui suit :</span>\n          <ul class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">formation textile</span>\n            </li>\n          </ul>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">Au point 2° sont ajoutés un quatrième et un cinquième tiret, rédigés comme suit :</span>\n          <ul class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">formation plastique digitale</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"-\">\n              <span class=\"sub-provision-text\">orientation arts plastiques</span>\n            </li>\n          </ul>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">Aux points 3° et 4°, le dernier tiret est chaque fois abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
