  "transformedHtml": "<article class=\"legal-article\" id=\"art-139/1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 139/1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-07-31/04\" data-law-type=\"L\" data-article-number=\"202\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2017-11-19/01\" data-law-type=\"L\" data-article-number=\"2\"></span>\n        <p class=\"intro-text\">Aucun officier ne peut être nommé au grade de major s'il n'a pas :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">suivi avec succès les cours de perfectionnement visés à l'article 111, alinéa 1er, 1° et 2° ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">réussi un test relatif à la connaissance d'une langue que le Roi fixe, autre que le néerlandais ou le français;</span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2022-06-02/06\" data-law-type=\"L\" data-article-number=\"9\"></span>\n            </span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
