  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 6</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 3, § 1er, de l'arrêté ministériel du 2 décembre 1991 relatif à la délégation de certains pouvoirs du ministre de la Défense nationale à des autorités de l'état-major général en matière de procédure de projet de textes légaux et réglementaires, du contentieux et du statut pécuniaire, de la comptabilité de l'Etat, des créances, de la livraison de données matriculaires et de la signature d'actes administratifs, les</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1°</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">4°</span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5°</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">9°</span></li>\n        <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">10°</span></li>\n        <li class=\"provision\" data-number=\"12°\"><span class=\"provision-text\">12°</span></li>\n        <li class=\"provision\" data-number=\"13°\"><span class=\"provision-text\">13°</span></li>\n        <li class=\"provision\" data-number=\"15°\"><span class=\"provision-text\">15°</span></li>\n        <li class=\"provision\" data-number=\"16°\"><span class=\"provision-text\">16°</span></li>\n        <li class=\"provision\" data-number=\"18°\"><span class=\"provision-text\">18°</span></li>\n      </ol>\n      <p class=\"closing-text\">sont abrogés.</p>\n    </div>\n  </div>\n</article>",
