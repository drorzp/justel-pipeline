  "transformedHtml": "<article class=\"legal-article\" id=\"art-8\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 8</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p>Les employeurs visés à l'article 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">peuvent engager des ACS aux fins exclusives :</span>\n                </li>\n            </ol>\n            <ol>\n                <li class=\"sub-provision\" data-marker=\"a)\">\n                    de répondre à des besoins exceptionnels et temporaires en personnel : il s'agit soit de la mise en oeuvre d'actions limitées dans le temps, soit d'un surcroît extraordinaire de travail;\n                </li>\n                <li class=\"sub-provision\" data-marker=\"b)\">\n                    de remplacement d'agents qui n'assument pas leur fonction ou ne l'assument qu'à temps partiel, sans préjudice de la possibilité de remplacer un agent statutaire par un autre agent statutaire;\n                </li>\n                <li class=\"sub-provision\" data-marker=\"c)\">\n                    d'accomplissement de tâches auxiliaires ou spécifiques;\n                </li>\n                <li class=\"sub-provision\" data-marker=\"d)\">\n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-05-02/05\" data-law-type=\"ARR\" data-article-number=\"13\">...</span>\n                </li>\n            </ol>\n        </div>\n        <footer class=\"article-footer\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-06-02/01\" data-law-type=\"ARR\" data-article-number=\"3\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2016060201\">ARR [2016-06-02/01], art. 3, 003; En vigueur : 10-06-2016</a>\n            </span>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-05-02/05\" data-law-type=\"ARR\" data-article-number=\"13\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2024050205\">ARR [2024-05-02/05], art. 13, 006; En vigueur : 01-07-2024</a>\n            </span>\n        </footer>\n    </div>\n</article>",
