  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Pour l'application du présent arrêté, il faut entendre par :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">la loi : la loi du 10 avril 1971 sur les accidents du travail,</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">(l'entreprise d'assurances : l'entreprise d'assurances visée à l'article 49 de la loi ainsi que <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2017-11-23/22\" data-law-type=\"AR\" data-article-number=\"161\">Fedris</span> lorsqu'il intervient dans le cadre de l'article 58, § 1er, </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"1°\"><span class=\"provision-text\">1°,</span></li>\n                        <li class=\"sub-provision\" data-marker=\"2°\"><span class=\"provision-text\">2°,</span></li>\n                        <li class=\"sub-provision\" data-marker=\"3°\"><span class=\"provision-text\">3°, et</span></li>\n                        <li class=\"sub-provision\" data-marker=\"4°\"><span class=\"provision-text\">4°,</span></li>\n                    </ol>\n                    <span class=\"provision-text\"> de la loi;)</span>\n                    <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2001-11-10/40\" data-law-type=\"AR\" data-article-number=\"30\">&lt;AR 2001-11-10/40, art. 30, 008;<strong>En vigueur :</strong>11-12-2001&gt;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2017-11-23/22\" data-law-type=\"AR\" data-article-number=\"160\">\n                        <span class=\"provision-text\">Fedris : l'Agence fédérale des risques professionnels lorsqu'elle agit dans le cadre des articles 27ter, 58, § 1er, </span>\n                        <ol class=\"numbered-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"20°\"><span class=\"provision-text\">20° et 58bis, § 1er, </span></li>\n                            <li class=\"sub-provision\" data-marker=\"2°\"><span class=\"provision-text\">2°</span></li>\n                        </ol>\n                        <span class=\"provision-text\"> de la loi.</span>\n                    </span>\n                </li>\n            </ol>\n        </div>\n    </div>\n    <footer class=\"article-footer\">\n        <ol class=\"footnotes\">\n            <li class=\"footnote\" data-footnote-id=\"1\" data-dossier-number=\"2012-09-21/03\" data-law-type=\"AR\" data-article-number=\"1\">\n                <span class=\"footnote-text\">AR <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2012092103\">2012-09-21/03</a>, art. 1, 014; En vigueur : 07-10-2012</span>\n            </li>\n            <li class=\"footnote\" data-footnote-id=\"2\" data-dossier-number=\"2017-11-23/22\" data-law-type=\"AR\" data-article-number=\"160\">\n                <span class=\"footnote-text\">AR <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2017112322\">2017-11-23/22</a>, art. 160, 019; En vigueur : 01-01-2017</span>\n            </li>\n            <li class=\"footnote\" data-footnote-id=\"3\" data-dossier-number=\"2017-11-23/22\" data-law-type=\"AR\" data-article-number=\"161\">\n                <span class=\"footnote-text\">AR <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2017112322\">2017-11-23/22</a>, art. 161, 019; En vigueur : 01-01-2017</span>\n            </li>\n        </ol>\n    </footer>\n</article>",
