  "transformedHtml": "<article class=\"legal-article\" id=\"art-176-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 176.3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2003-05-15/82\" data-law-type=\"DRW\" data-article-number=\"109\">\n          &lt;DRW 2003-05-15/82, art. 109, 010 ;<strong>En vigueur :</strong>01-07-2003&gt;\n        </span>\n        Les moyens financiers des Guichets du Crédit social sont les suivants :\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les ressources liées à leurs activités;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">les indemnités visées à l'article 175.2, § 3,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"8°\">\n              <span class=\"provision-text\">et</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"9°\">\n              <span class=\"provision-text\">;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">les crédits octroyés par la Société visés à l'article 175.2, § 3, 2°.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
