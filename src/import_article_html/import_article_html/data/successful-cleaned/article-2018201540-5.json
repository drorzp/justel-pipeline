  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'annexe du même arrêté, remplacée par l'arrêté ministériel du 2 février 2017, dans la catégorie B &quot; légumineuses &quot;, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au 5°, le mot &quot; alexandrinum &quot; est remplacé par le mot &quot; sp. &quot;;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">les 6°, 7°, 8° et 9° sont abrogés.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
