  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 12</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 2ter, l'alinéa 1er du Code des taxes assimilées aux impôts sur les revenus, inséré par le décret du 10 décembre 2009, est complété par les 3°, 4° et 5° rédigés comme suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">la taxe de circulation sur les véhicules automobiles;</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">la taxe de mise en circulation;</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">l'eurovignette.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
