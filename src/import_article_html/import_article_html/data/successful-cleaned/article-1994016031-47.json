  "transformedHtml": "<article class=\"legal-article\" id=\"art-47\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 47</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Si, en raison de leur ampleur, les mentions visées aux numéros:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"9°\">\n                    <span class=\"provision-text\">9°</span>\n                </li>\n                <li class=\"provision\" data-number=\"10°\">\n                    <span class=\"provision-text\">10°</span>\n                </li>\n                <li class=\"provision\" data-number=\"18°\">\n                    <span class=\"provision-text\">de l'article 44 ne peuvent toutes être reproduites sur l'étiquette ou l'emballage, elles peuvent figurer sur une notice séparée qui est fixée sur chacun des emballages. Cette notice est consideree comme faisant partie de l'étiquette.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
