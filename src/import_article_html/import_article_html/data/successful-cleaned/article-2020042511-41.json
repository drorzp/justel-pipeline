  "transformedHtml": "<article class=\"legal-article\" id=\"art-41\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 41</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2023-03-23/09\" data-law-type=\"ARW\" data-article-number=\"20\">\n                Lorsque le demandeur regroupe des membres de plusieurs régions en Belgique, les coûts admis visés à l'article 37 sont réduits :\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">pour les initiatives, visées à l'article 16, </span>\n                        <ol class=\"nested-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"1°, a)\">1°, a),</li>\n                            <li class=\"sub-provision\" data-marker=\"2°, a)\">2°, a)</li>\n                            <ol class=\"nested-provisions\">\n                                <li class=\"sub-provision\" data-marker=\"b)\">et b),</li>\n                            </ol>\n                            <li class=\"sub-provision\" data-marker=\"3°\">3°,</li>\n                            <li class=\"sub-provision\" data-marker=\"4°\">4°</li>\n                            <li class=\"sub-provision\" data-marker=\"5°\">et 5°,</li>\n                        </ol>\n                        <span class=\"provision-text\"> au prorata du nombre d'entreprises membres du demandeur qui sont éligibles aux aides à l'internationalisation de l'Agence;</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">pour les initiatives, visées à l'article 16, </span>\n                        <ol class=\"nested-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"1°, b)\">1°, b),</li>\n                            <li class=\"sub-provision\" data-marker=\"2°, c)\">et 2°, c),</li>\n                        </ol>\n                        <span class=\"provision-text\"> au prorata du nombre d'entreprises membres du demandeur éligibles aux aides à l'internationalisation de l'Agence ayant participé à l'action</span>\n                    </li>\n                </ol>\n            </span>\n        </div>\n    </div>\n</article>",
