  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 118 de la loi-programme (I) du 27 décembre 2006, modifié par la loi du 5 mai 2019, les modifications suivantes sont apportées:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">l'alinéa 1er est complété par un 6° rédigé comme suit:\n                        <br>\"6° de cancer de l'ovaire provoqué par l'amiante.\";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à l'alinéa 2, les mots \"4° et 5° \" sont remplacés par les mots \"4° à 6° \".</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
