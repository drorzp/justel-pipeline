  "transformedHtml": "<article class=\"legal-article\" id=\"art-14\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 14</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans le cadre de l'accomplissement de ses missions légales et d'intérêt général, la Fédération Royale du Notariat belge bénéficie d'un droit en lecture aux données non publiques visées à l'article 3, § 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à 3°,</span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">et à l'article 6, § 1er,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à 6°</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <p class=\"closing-text\">8°. A cette fin, la Fédération Royale du Notariat belge dispose d'un accès sur base numéro d'identification interne.</p>\n    </div>\n  </div>\n</article>",
