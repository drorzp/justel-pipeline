  "transformedHtml": "<article class=\"legal-article\" id=\"art-13\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 13</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Un article 15bis rédigé comme suit est inséré dans le même arrêté :</p>\n      <blockquote class=\"quoted-article\">\n        <p class=\"quoted-text\">\" Art. 15bis. Pour ce qui concerne la prescription de médicaments aux animaux non producteurs de denrées alimentaires, les obligations visées à l'article 15, prévues par les points:</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">3°</span>\n          </li>\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">5° de l'article 15 sont facultatives. \"</span>\n          </li>\n        </ol>\n      </blockquote>\n    </div>\n  </div>\n</article>",
