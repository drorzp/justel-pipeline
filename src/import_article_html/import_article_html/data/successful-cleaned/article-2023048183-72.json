  "transformedHtml": "<article class=\"legal-article\" id=\"art-72\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 72</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 324 du même code, modifié en dernier lieu par le décret du 22 décembre 2017, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">le paragraphe 1er est abrogé</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans le paragraphe 2, les points 1° et 2° sont abrogés</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">dans le paragraphe 3, l'alinéa 1er est abrogé</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">dans le paragraphe 3, alinéa 3, les points 3° à 7° sont abrogés</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">le paragraphe 4 est abrogé</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
