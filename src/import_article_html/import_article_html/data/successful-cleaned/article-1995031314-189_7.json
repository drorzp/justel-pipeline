  "transformedHtml": "<article class=\"legal-article\" id=\"art-189/7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 189/7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">\n                <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2012-03-01/26\" data-law-type=\"ARR\" data-article-number=\"6\">\n                    Le congé en remplacement du congé de maternité accordé au père de l'enfant ou à la personne avec laquelle la mère vit en couple au moment de la naissance de l'enfant est rémunéré et assimilé à une période d'activité de service.\n                </span>\n                <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2022-05-17/01\" data-law-type=\"ARR\" data-article-number=\"10\">\n                    Il est non cumulable avec le congé de circonstance visé à l'article 179, alinéa 1er,\n                </span>\n            </p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">\n                        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2022-05-17/01\" data-law-type=\"ARR\" data-article-number=\"10\">\n                            et avec le congé de naissance visé à l'article 181/1.\n                        </span>\n                    </span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
