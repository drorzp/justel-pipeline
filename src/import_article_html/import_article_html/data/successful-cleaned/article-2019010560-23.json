  "transformedHtml": "<article class=\"legal-article\" id=\"art-23\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 23</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 62, § 5, alinéa 1er, du même code, modifié en dernier lieu par la loi du 23 novembre 2017, est complété par les 7°, 8° et 9° rédigés comme suit:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">la gestion du trafic;</span>\n                </li>\n                <li class=\"provision\" data-number=\"8°\">\n                    <span class=\"provision-text\">la planification du renouvellement et l'entretien programmé ou non programmé;</span>\n                </li>\n                <li class=\"provision\" data-number=\"9°\">\n                    <span class=\"provision-text\">le respect des exigences énoncées aux articles 4/2/1, 26/1 et 26/2.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
