  "transformedHtml": "<article class=\"legal-article\" id=\"art-69\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 69</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1989-12-22/31\" data-law-type=\"L\" data-article-number=\"118\">\n          &lt;L 1989-12-22/31, art. 118, 017;<strong>En vigueur :</strong>09-01-1990&gt;\n        </span>\n        Le Roi peut prévoir des dérogations aux dispositions du présent chapitre :\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\n            pour les titulaires visés à l'article 21, alinéa 1er, 7° à 9° qui ne sont pas astreints au paiement des cotisations prévues à l'article suivant (ainsi que pour leur conjoint);\n          </span>\n          <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1993-02-15/33\" data-law-type=\"L\" data-article-number=\"61\">\n            &lt;L 1993-02-15/33, art. 61, 028;<strong>En vigueur :</strong>01-01-1993&gt;\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">\n            pour certaines categories d'enfants, personnes à charge d'un titulaire visé à l'article 21, alinéa 1er, 1° à 9° et 13°.\n          </span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
