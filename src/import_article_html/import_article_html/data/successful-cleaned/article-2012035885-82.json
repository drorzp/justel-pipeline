  "transformedHtml": "<article class=\"legal-article\" id=\"art-82\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 82</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 253 du même décret, modifié par le décret du 23 janvier 2009, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">le membre de phrase \" la fixation et les modifications du cadre organique \" est abrogé;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, les points </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"4°\">\n              <span class=\"provision-text\"></span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"6°\">\n              <span class=\"provision-text\"></span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"8°\">\n              <span class=\"provision-text\"></span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"10°\">\n              <span class=\"provision-text\">et </span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"12°\">\n              <span class=\"provision-text\">sont abrogés;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">le paragraphe 2 est complété par un point </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"4°\">\n              <span class=\"provision-text\">rédigé comme suit : \" 4° les plans pluriannuels et budgets de la régie communale autonome.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
