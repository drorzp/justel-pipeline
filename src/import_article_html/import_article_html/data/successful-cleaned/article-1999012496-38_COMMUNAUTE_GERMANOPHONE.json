  "transformedHtml": "<article class=\"legal-article\" id=\"art-38_COMMUNAUTE_GERMANOPHONE\">\n    <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n            <p>Lorsque <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2018-06-07/15\" data-law-type=\"ACG\" data-article-number=\"15\">le ministre communautaire</span> édicte des règles générales en exécution du présent arrêté, il consulte, sauf le cas de grande urgence, le Conseil Consultatif pour l'occupation des travailleurs étrangers.</p>\n        </div>\n    </section>\n    <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 2.</h3>\n        <div class=\"paragraph-content\">\n            <p>L'autorité compétente peut déroger par décision motivée aux articles 8, 10, 12, 14, 21,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et 22,</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">pour des cas individuels dignes d'intérêt pour des raisons économiques ou sociales.</span></li>\n            </ol>\n        </div>\n    </section>\n</article>",
