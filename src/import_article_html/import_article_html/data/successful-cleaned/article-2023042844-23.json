  "transformedHtml": "<article class=\"legal-article\" id=\"art-23\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 23</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 90 de la même loi, les mots &quot;visées à l'article 32,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">2°, de la loi du 20 septembre 1948 portant organisation de l'économie ainsi qu'à l'article 82,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">2°, de la loi du 4 août 1996 relative au bien-être des travailleurs lors de l'exécution de leur travail&quot; sont remplacés par les mots &quot;visées à l'article 190, alinéa 1er,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">2°, et l'article 191, § 1, 1°, a), et § 2, 1°, du Code Pénal Social&quot;.</p>\n        </div>\n    </div>\n</article>",
