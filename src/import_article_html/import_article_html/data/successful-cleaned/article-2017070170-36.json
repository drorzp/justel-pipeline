  "transformedHtml": "<article class=\"legal-article\" id=\"art-36\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 36</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le présent arrêté ministériel produit ses effets le 1er juillet 2017.</p>\n            <p class=\"intro-text\">Par dérogation à l'alinéa 1er :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">les articles 16 et 22 produisent leurs effets au 1er mars 2017</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">les articles 25 à 33 produisent leurs effets au 1er mai 2017</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">les articles 2, 4 à 9 produisent leurs effets au 1er juin 2017</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">l'article 14, en ce qui concerne l'article 21, § 1er, 3° et 4°, produit ses effets au 1er septembre 2017</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
