  "transformedHtml": "<article class=\"legal-article\" id=\"art-60\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 60</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 199, § 2, du même décret, modifié par le décret du 26 avril 2000, un alinéa cinq est ajouté, libellé comme suit :</p>\n            <blockquote class=\"quoted-text\">\n                <p class=\"quoted-paragraph\">\" Les dispositions relatives aux obligations d'information, telles que fixées à l'article 137, § 1er, premier alinéa,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">1°</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"3°\">\n                        <span class=\"provision-text\">3°</span>\n                    </li>\n                </ol>\n                <p class=\"quoted-paragraph\">et § 1er, alinéas trois et quatre, sont toutefois immédiatement d'application, après l'entrée en vigueur de la présente disposition. \"</p>\n            </blockquote>\n        </div>\n    </div>\n</article>",
