  "transformedHtml": "<article class=\"legal-article\" id=\"art-16\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 16</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 113decies du même décret, inséré par le décret du 16 mars 2018 et remplacé par le décret du 21 décembre 2018, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au paragraphe 3, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">le membre de phrase \" n-2/n-1 \" est remplacé par le membre de phrase \" n-1/n \" ;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au paragraphe 4, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">le membre de phrase \" l'article 41, § 4, </span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">2° et </span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"2° bis\">\n                  <span class=\"provision-text\">2° bis \" est remplacé par le membre de phrase \" l'article 41, § 4, </span>\n                  <ol class=\"numbered-provisions\">\n                    <li class=\"sub-provision\" data-marker=\"1°\">\n                      <span class=\"provision-text\">1° à </span>\n                    </li>\n                    <li class=\"sub-provision\" data-marker=\"2° quater\">\n                      <span class=\"provision-text\">2° quater\".</span>\n            