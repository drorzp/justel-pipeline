  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">En application de l'article 4, § 2, 4°, du décret, tout organisme agréé doit prouver qu'il répond à la demande d'un public comptant au minimum douze participants, hormis pour les actions prévues à l'article 4, § 1er,:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <p class=\"closing-text\">8°, du décret.</p>\n    </div>\n  </div>\n</article>",
