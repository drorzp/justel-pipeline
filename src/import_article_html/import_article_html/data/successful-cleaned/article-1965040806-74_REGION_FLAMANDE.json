  "transformedHtml": "<article class=\"legal-article\" id=\"art-74_REGION_FLAMANDE\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 74_REGION_FLAMANDE</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">(Alinéa 1er abrogé) <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1990-03-28/34\" data-law-type=\"DCFL\" data-article-number=\"22\">&lt;DCFL 1990-03-28/34, art. 22, 9°, 003; En vigueur : 01-05-1990&gt;</span></p>\n            <p class=\"intro-text\">Le juge de la jeunesse fait au moins deux fois l'an visite à tout mineur qu'il a placé en vertu d'une des mesures prévues à l'article 37, 3° et 4°. [...]. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1990-03-28/34\" data-law-type=\"DCFL\" data-article-number=\"22\">&lt;DCFL 1990-03-28/34, art. 22, 9°, 003; En vigueur : 01-05-1990&gt;</span></p>\n            <p class=\"closing-text\">(Alinéa 3 abrogé) <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1990-03-28/34\" data-law-type=\"DCFL\" data-article-number=\"22\">&lt;DCFL 1990-03-28/34, art. 22, 9°, 003; En vigueur : 01-05-1990&gt;</span></p>\n        </div>\n    </div>\n</article>",
