  "transformedHtml": "<article class=\"legal-article\" id=\"art-569_REGION_WALLONNE\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 569_REGION_WALLONNE</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le tribunal de première instance connaît:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"17\" data-dossier-number=\"2013-07-30/23\" data-law-type=\"L\" data-article-number=\"127\">...</span>;</span>\n        </li>\n        <li class=\"provision\" data-number=\"1°/1\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"17\" data-dossier-number=\"2013-07-30/23\" data-law-type=\"L\" data-article-number=\"127\">...</span>;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"17\" data-dossier-number=\"2013-07-30/23\" data-law-type=\"L\" data-article-number=\"127\">...</span>;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"12\" data-dossier-number=\"2012-12-10/14\" data-law-type=\"L\" data-article-number=\"44\">des demandes en déclaration d'indignité successorale visées à l'article <span class=\"footnote footnote-reference\" data-footnote-id=\"24\" data-dossier-number=\"2022-01-19/18\" data-law-type=\"L\" data-article-number=\"19\">4.6</span>, § 1er, 2°, du Code civil;</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"17\" data-dossier-number=\"2013-07-30/23\" data-law-type=\"L\" data-article-number=\"127\">...</span>;</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">des contestations élevées sur l'exécution des jugements et arrêts;</span>\n        </li>\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">des demandes introduites en vertu soit du décret du 26 juillet-3 août 1791 relatif à la réquisition et à l'action de la force publique contre les attroupements, soit du décret du 10 vendémiaire, an IV, sur la police intérieure des communes;</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">[...] <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2007-05-10/33\" data-law-type=\"L\" data-article-number=\"12\">L [2007-05-10/33](https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2007051033), art. 12, 1°, 147;**En vigueur :**01-11-2007</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"8°\">\n          <span class=\"provision-text\">[...] <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2007-05-10/33\" data-law-type=\"L\" data-article-number=\"12\">L [2007-05-10/33](https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2007051033), art. 12, 1°, 147;**En vigueur :**01-11-2007</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"9°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"23\" data-dossier-number=\"2018-04-15/14\" data-law-type=\"L\" data-article-number=\"9\">...</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"10°\">\n          <span class=\"provision-text\">des demandes relatives aux expropriations pour cause d'utilité publique <span class=\"footnote footnote-reference\" data-footnote-id=\"21\" data-dossier-numbe