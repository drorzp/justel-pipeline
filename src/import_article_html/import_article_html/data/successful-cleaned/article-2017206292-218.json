  "transformedHtml": "<article class=\"legal-article\" id=\"art-218\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 218</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les mots \"du Fonds\" sont remplacés par les mots \"de Fedris\" dans les dispositions suivantes du même arrêté :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">l'article 7</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">l'article 8, § 1er, 1° et 3° et § 2, alinéa 2</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">l'article 11, § 1er, 1° et § 2, 2°</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">l'article 21, alinéa 2</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">l'article 22</span>\n        </li>\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">l'article 23, alinéa 1er</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">l'article 24, § 1er, alinéa 1er, 3°, remplacé par l'arrêté royal du 29 juin 2014</span>\n        </li>\n        <li class=\"provision\" data-number=\"8°\">\n          <span class=\"provision-text\">l'article 24, § 1er, alinéa 2</span>\n        </li>\n        <li class=\"provision\" data-number=\"9°\">\n          <span class=\"provision-text\">l'article 24, § 3, modifié par l'arrêté royal du 29 juin 2014</span>\n        </li>\n        <li class=\"provision\" data-number=\"10°\">\n          <span class=\"provision-text\">l'article 26.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
