  "transformedHtml": "<article class=\"legal-article\" id=\"art-45\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 45</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 111, § 1er, du même arrêté, l'alinéa 2 est remplacé par ce qui suit :</p>\n            <blockquote class=\"quote-text\">\n                <p>\" Néanmoins, l'article 63, §§ 1er, 2,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"6°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"7°\">\n                        <span class=\"provision-text\">3 et 4, ainsi que les articles 64 et 65 sont toujours applicables à la procédure négociée sans publicité, sauf en cas de marché dont la dépense à approuver ne dépasse pas le montant visé à l'article 110, § 1er, 4°.</span>\n                    </li>\n                </ol>\n            </blockquote>\n        </div>\n    </div>\n</article>",
