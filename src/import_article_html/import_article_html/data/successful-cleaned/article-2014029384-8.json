  "transformedHtml": "<article class=\"legal-article\" id=\"art-8\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 8</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Le Gouvernement peut octroyer quatre types de soutien aux activités et au fonctionnement :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">La bourse;</span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">Le soutien ponctuel;</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">La convention;</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">Le contrat-programme.</span></li>\n      </ol>\n      <p>\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-12-18/21\" data-law-type=\"DCFR\" data-article-number=\"51\">Le montant des types d'aides visés à l'alinéa 1er 3° et 4° est réduit de 1 % <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2015-12-10/18\" data-law-type=\"DCFR\" data-article-number=\"29\"><span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2016-12-14/17\" data-law-type=\"DCFR\" data-article-number=\"17\">pour les années civiles 2015 à 2017</span></span>.</span>\n      </p>\n    </div>\n  </div>\n</article>",
