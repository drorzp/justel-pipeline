  "transformedHtml": "<article class=\"legal-article\" id=\"art-720\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 720</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Un dossier est constitué pour toute cause inscrite au rôle général.<span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2024-03-28/60\" data-law-type=\"L\" data-article-number=\"27\">Le dossier mentionne de manière visible la date de la mise au rôle et le numéro d'ordre de la cause.</span></p>\n      <p>(NOTE : remplacé par <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2006-07-10/39\" data-law-type=\"L\" data-article-number=\"15\">L 2006-07-10/39, art. 15 et 27, 2°, 078;</span><b>En vigueur :</b>01-01-2017 (voir <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2014-12-19/24\" data-law-type=\"L\" data-article-number=\"20\">L 2014-12-19/24, art. 20</span>), abrogés eux-mêmes par l'art. 176, 9° et 10° de <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2016-12-25/14\" data-law-type=\"L\">L 2016-12-25/14</span>;<b>En vigueur :</b>31-12-2016)</p>\n    </div>\n  </div>\n</article>",
