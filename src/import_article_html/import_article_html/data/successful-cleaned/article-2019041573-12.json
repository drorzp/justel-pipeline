  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 12</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 24 du même arrêté les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans l'alinéa 1er, </span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"b°\">\n                  le mot \" effectifs \" est remplacé par les mots \" ayant voix délibérative \" et le membre de phrase \" moyens visés à l'article 17, points \n                  <ol>\n                    <li class=\"sub-provision\" data-marker=\"1°\">\n                      et \n                    </li>\n                    <li class=\"sub-provision\" data-marker=\"2°\">\n                      \" est remplacé par les mots \" moyens globaux du Fonds spécial de recherche \"\n                    </li>\n                  </ol>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans l'alinéa 2, le membre de phrase \" au commissaire du Gouvernement, \" est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
