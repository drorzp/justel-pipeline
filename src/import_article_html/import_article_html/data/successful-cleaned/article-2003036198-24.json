  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 24</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 38 du même arrêté est remplacé par ce qui suit :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>\"Art. 38. L'échiquier ne peut être utilisé que dans les eaux visées à l'article 36,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">L'utilisation de l'échiquier est limitée à la pêche à l'anguille.</span>\n                        </li>\n                    </ol>\n                    <p>L'échiquier doit toujours être installé et manipulé dans un espace libre sans aucune forme de protection.\"</p>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
