  "transformedHtml": "<article class=\"legal-article\" id=\"art-95\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 95</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 375 du même Code, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">et 3°, </span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">une virgule est ajoutée entre les mots \" euros \" et \" le gestionnaire \";</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans le paragraphe 4, le \" § 1er \" est remplacé par les mots \" paragraphe 1er \".</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
