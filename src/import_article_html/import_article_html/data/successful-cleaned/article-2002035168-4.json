  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 19quater du même arrêté est remplacé par la disposition suivante :</p>\n      <blockquote class=\"article-quote\">\n        <p class=\"quoted-text\">\" Art. 19quater. En ce qui concerne les recrutements dans le cadre de l'article 6bis du présent arrêté, seuls :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1er\">\n            <span class=\"provision-text\">l'article 1er,</span>\n            <ol class=\"nested-provisions\">\n              <li class=\"sub-provision\" data-marker=\"15°\">15°</li>\n              <li class=\"sub-provision\" data-marker=\"16°\">16°</li>\n            </ol>\n          </li>\n          <li class=\"provision\" data-number=\"29°\">\n            <span class=\"provision-text\">29°</span>\n          </li>\n          <li class=\"provision\" data-number=\"30°\">\n            <span class=\"provision-text\">30°</span>\n          </li>\n        </ol>\n        <p class=\"quoted-text\">l'article 2, § 1er, 12°, l'article 6bis, l'article 10, §§ 4, 5 et 6, deuxième alinéa, l'article 19, l'article 19bis, et l'article 19ter du présent arrêté sont d'application.</p>\n      </blockquote>\n    </div>\n  </div>\n</article>",
