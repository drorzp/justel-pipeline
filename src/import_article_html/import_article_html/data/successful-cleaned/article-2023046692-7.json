  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Un plafond annuel de subvention de 75.000 euros est fixé pour les bénéficiaires visés à l'article 43/2, § 1er,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">à</span></li>\n            </ol>\n            <p class=\"closing-text\">7° et 9° à 11°, du décret. Un plafond annuel de subvention de 25.000 euros est fixé pour les bénéficiaires visés à l'article 43/2, § 1er, 8°, du décret.</p>\n        </div>\n    </div>\n</article>",
