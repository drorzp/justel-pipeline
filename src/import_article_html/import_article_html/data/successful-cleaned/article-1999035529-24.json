  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 24</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 39, premier alinéa, du même décret, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">les mots \" aux articles 35, 3°; 36, § 1er, 3° et § 2, 3°; 37, 3° et 38, 3° \" sont remplacés par les mots \" à l'article 35 \";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">il y a lieu d'ajouter après les mots \" en tant que membre de l'Inspection \" les mots \" ou du D.V.O.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
