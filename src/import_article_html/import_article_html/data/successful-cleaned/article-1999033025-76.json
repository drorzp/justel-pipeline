  "transformedHtml": "<article class=\"legal-article\" id=\"art-76\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 76</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Un membre du personnel engagé à titre définitif peut être mis en disponibilité</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">par défaut d'emploi;</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">pour mission;</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">pour maladie ou infirmité;</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">pour convenance personnelle;</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">pour convenance personnelle précédant la mise à la retraite;</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">par retrait d'emploi dans l'intérêt du service.</span></li>\n            </ol>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2008-04-21/31\" data-law-type=\"DCG\" data-article-number=\"77\">Le premier alinéa, à l'exception des points 1°, 3° et 5°, s'applique aux membres du personnel temporaires engagés pour une durée indéterminée <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2021-06-28/11\" data-law-type=\"DCG\" data-article-number=\"204\">conformément à l'article 36bis</span> ou nommée à titre définitif.</span>\n        </div>\n    </div>\n</article>",
