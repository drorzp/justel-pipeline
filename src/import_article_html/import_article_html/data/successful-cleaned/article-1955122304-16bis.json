  "transformedHtml": "<article class=\"legal-article\" id=\"art-16bis\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 16bis</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"13-07-1976\" data-law-type=\"L\" data-article-number=\"61\">Inséré par L 13-07-1976, art 61</span> Peut, à sa demande, être admis <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-07-31/04\" data-law-type=\"L\" data-article-number=\"297\">comme officier de carrière du niveau B dans la filière de métiers à laquelle il appartient</span>, l'officier auxiliaire qui remplit les conditions suivantes :\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">Etre agréé par <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2018-04-30/07\" data-law-type=\"L\" data-article-number=\"2\">l'autorité désignée par le Roi</span>, après avoir été proposé favorablement par ses chefs hiérarchiques; <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2005-07-16/31\" data-law-type=\"L\" data-article-number=\"14\">L 2005-07-16/31, art. 14, 006;**En vigueur :**10-08-2005</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">Avoir satisfait aux épreuves visées à l'article 16, 2° et 3°;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">Avoir été classé en ordre utile, en fonction du nombre de places fixé conformément à l'article 17, selon les règles déterminées par le Roi.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
