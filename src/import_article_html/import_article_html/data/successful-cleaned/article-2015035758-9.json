  "transformedHtml": "<article class=\"legal-article\" id=\"art-9\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 9</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le Gouvernement flamand fixe, pour chacune des dispositions du présent décret, la date d'entrée en vigueur. \n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2015-09-11/17\" data-law-type=\"AGF\" data-article-number=\"3\">\n          (NOTE: entrée en vigueur de l'art. 3 fixée au 07-09-2015, à l'exception de la disposition ayant trait à la délivrance de preuves du niveau linguistique du néerlandais par AGF\n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2015091117\">2015-09-11/17</a>, art. 3)\n        </span>\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-01-29/17\" data-law-type=\"AGF\" data-article-number=\"82\">\n          (NOTE: entrée en vigueur fixée au 29-02-2016 par AGF \n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2016012917\">2016-01-29/17</a>, art. 82 pour les dispositions suivantes :\n        </span>\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">les articles 1er et 2</span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">les articles 4 à 6 inclus</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">l'article 7, à l'exception des dispositions relatives à la délivrance de preuves du niveau linguistique du néerlandais</span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">l'article 8.</span></li>\n      </ol>\n      <p class=\"closing-text\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2018-04-20/18\" data-law-type=\"AGF\" data-article-number=\"9\">\n          (NOTE : Entrée en vigueur des articles 3,2° et 7 fixée au 26-05-2018 par AGF\n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2018042018\">2018-04-20/18</a>, art. 9)\n        </span>\n      </p>\n    </div>\n  </div>\n</article>",
