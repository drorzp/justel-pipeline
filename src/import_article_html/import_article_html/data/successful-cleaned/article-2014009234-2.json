  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-02-05/11\" data-law-type=\"L\" data-article-number=\"48\">\n                <p class=\"intro-text\">Dans l'article 7 du Code pénal, modifié en dernier lieu par la loi du 26 avril 2007, les mots &quot;En matière correctionnelle et de police:</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">l'emprisonnement</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">la peine de travail.</span></li>\n                </ol>\n                <p class=\"intro-text\">Les peines prévues aux:</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">ne peuvent s'appliquer cumulativement.&quot; sont remplacés par les mots &quot;En matière correctionnelle et de police:</span></li>\n                </ol>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">l'emprisonnement</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">la peine de surveillance électronique</span></li>\n                    <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">la peine de travail</span></li>\n                    <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">la peine de probation autonome.</span></li>\n                </ol>\n                <p class=\"intro-text\">Les peines prévues aux:</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n                    <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">ne peuvent s'appliquer cumulativement.</span></li>\n                </ol>\n            </span>\n        </div>\n    </div>\n</article>",
