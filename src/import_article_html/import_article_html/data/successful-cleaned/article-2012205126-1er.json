  "transformedHtml": "<article class=\"legal-article\" id=\"art-1er\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 1er</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 1er de l'arrêté royal du 10 décembre 1987 relatif aux allocations accordées dans le cadre de la loi du 10 avril 1971 sur les accidents du travail, modifié par l'arrêté royal du 10 novembre 2011, le 3° est remplacé par ce qui suit :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">le Fonds : le Fonds des accidents du travail lorsqu'il agit dans le cadre des articles 27ter, 58, § 1er, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"20°\">\n              <span class=\"provision-text\">et 58bis, § 1er, </span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">, de la loi.</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
