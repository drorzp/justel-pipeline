  "transformedHtml": "<article class=\"legal-article\" id=\"art-11-2-1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 11.2.1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Les délits visés à l'article 11.2.2, <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-07-15/27\" data-law-type=\"DCFL\" data-article-number=\"43\">alinéa premier</span></p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">inclus, et à l'article 11.2.2, alinéa premier, sont punis par le juge pénal. Les infractions visées à l'article 11.2.4 sont punies d'une amende administrative exclusive. Les délits visés à l'article 11.2.2, alinéa premier,</span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">sont punis par le juge pénal ou par une amende administrative alternative.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
