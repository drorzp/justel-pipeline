  "transformedHtml": "<article class=\"legal-article\" id=\"art-38\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 38</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Sauf dans les cas prévus (à l'article 35, 4° et 6°, et sans préjudice de l'article 37bis) la résiliation du <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-06-20/05\" data-law-type=\"DCG\" data-article-number=\"44\">contrat d'apprentissage industriel</span> sans motif grave donne lieu au paiement d'une indemnité égale au montant de l'indemnité due à l'<span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-06-20/05\" data-law-type=\"DCG\" data-article-number=\"44\">apprenti industriel</span> pour une période de trois mois ou d'un mois et demi, selon que la résiliation émane du patron ou de l'<span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-06-20/05\" data-law-type=\"DCG\" data-article-number=\"44\">apprenti industriel</span>. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1998-05-06/35\" data-law-type=\"L\" data-article-number=\"15\">&lt;L 1998-05-06/35, art. 15, 005;**En vigueur :**01-01-1998&gt;</span></p>\n    </div>\n  </div>\n</article>",
