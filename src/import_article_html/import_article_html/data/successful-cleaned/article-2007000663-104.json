  "transformedHtml": "<article class=\"legal-article\" id=\"art-104\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 104</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>La zone <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"92\">peut proposer</span> à l'employeur privé ou public d'un membre volontaire de son personnel opérationnel la conclusion d'une convention précisant les modalités de la disponibilité opérationnelle et de la disponibilité pour la formation du membre volontaire.</p>\n                    <p><span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"92\">Le Roi peut fixer les modalités de conclusion et le contenu d'une telle convention.</span></p>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
