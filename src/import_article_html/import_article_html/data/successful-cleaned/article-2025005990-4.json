  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 1er/2, § 1er, alinéa 2, de la même loi, inséré par la loi du 18 décembre 2016 et modifié en dernier lieu par la loi du 10 mars 2024, les modifications suivantes sont apportées:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"a)\">\n          <span class=\"provision-text\">le 1° est remplacé par ce qui suit:</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">l'article 10, § 1er, alinéa 1er,</span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"4°\">\n                  <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                  <span class=\"provision-text\">;</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"b)\">\n          <span class=\"provision-text\">le 2° est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
