  "transformedHtml": "<article class=\"legal-article\" id=\"art-57\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 57</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <section class=\"paragraph\">\n        <div class=\"paragraph-content\">\n          L'(entreprise d'assurances) est tenu de communiquer <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2017-11-23/22\" data-law-type=\"AR\" data-article-number=\"119\">à Fedris</span> le nom, l'adresse et le numéro de police des employeurs: <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2001-11-10/40\" data-law-type=\"AR\" data-article-number=\"41\">&lt;AR 2001-11-10/40, art. 41, 033;**En vigueur :**11-12-2001&gt;</span>\n        </div>\n      </section>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">dont le contrat d'assurance est en cours lors de l'entrée en vigueur de la loi;</span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">qui ont conclu un contrat après la mise en vigueur de la loi;</span></li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">dont le contrat <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2022-11-13/07\" data-law-type=\"AR\" data-article-number=\"34\">est suspendu ou</span> se termine après la mise en vigueur de la loi. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1987-12-10/39\" data-law-type=\"AR\" data-article-number=\"34\">&lt;AR 1987-12-10/39, art. 34, 011;**En vigueur :**01-01-1988&gt;</span></span>\n        </li>\n      </ol>\n      <section class=\"paragraph\">\n        <div class=\"paragraph-content\">\n          Les renseignements visés à l'alinéa 1er, 1°, sont fournis au plus tard le 31 mars 1972.\n        </div>\n      </section>\n      <section class=\"paragraph\">\n        <div class=\"paragraph-content\">\n          Les renseignements visés à l'alinéa 1er, 2° et 3°, sont fournis au moment ou le contrat <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2022-11-13/07\" data-law-type=\"AR\" data-article-number=\"35\">est conclu, suspendu ou se termine</span>). <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1987-12-10/39\" data-law-type=\"AR\" data-article-number=\"35\">&lt;AR 1987-12-10/39, art. 35, 011;**En vigueur :**01-01-1988&gt;</span>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
