  "transformedHtml": "<article class=\"legal-article\" id=\"art-22\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 22</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-1er\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p>Les employeurs visés à l'article 13, § 1er,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">, de l'arrêté du 18 février 1997 précité remboursent mensuellement l'administration d'origine selon les modalités prévues par une convention à conclure individuellement entre elle et ces employeurs.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\" id=\"para-2\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p>Les employeurs visés à l'article 13, § 2, de l'arrêté du 18 février 1997 précité remboursent trimestriellement à l'administration d'origine les montants payés en vertu de l'article 21.</p>\n            </div>\n        </section>\n    </div>\n</article>",
