  "transformedHtml": "<article class=\"legal-article\" id=\"art-27\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 27</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 16 du même arrêté, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à l'alinéa premier, 6°, sont ajoutés les mots \" et le calcul relatif à l'économie de l'entreprise \" ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à l'alinéa premier, les points 9° et 10° sont remplacés par ce qui suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"9°\">\n                            <span class=\"provision-text\">les débouchés et le marketing ;</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"10°\">\n                            <span class=\"provision-text\">la gestion du sol ;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">à l'alinéa premier, il est ajouté un point 11°, rédigé comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"11°\">\n                            <span class=\"provision-text\">la gestion de l'entreprise.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
