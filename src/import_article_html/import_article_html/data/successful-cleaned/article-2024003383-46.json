  "transformedHtml": "<article class=\"legal-article\" id=\"art-46\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 46</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 41 du même décret, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1)\">\n                    <span class=\"provision-text\">au § 1er, 6°, le mot &quot;administratives&quot; est remplacé par les mots &quot;de soutien administratif&quot;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2)\">\n                    <span class=\"provision-text\">au § 1er, un 7° et 8° sont insérés et rédigés comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"7°\">de prévention et d'animation en matière d'éducation à la vie relationnelle, affective et sexuelle, notamment en milieu scolaire</li>\n                        <li class=\"sub-provision\" data-marker=\"8°\">de coordination.</li>\n                    </ol>\n                    <span class=\"provision-text\">;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3)\">\n                    <span class=\"provision-text\">au § 2, le mot &quot;administrative&quot; est remplacé par les mots &quot;de soutien administratif&quot;.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
