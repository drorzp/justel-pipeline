  "transformedHtml": "<article class=\"legal-article\" id=\"art-17\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 17</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-1er\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Doivent faire l'objet d'une communication préalable écrite au fonctionnaire désigné par l'administrateur :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">toute modification aux activités exercées dans l'établissement d'accise;</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">toute modification à l'établissement d'accise;</span></li>\n                    <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">toute modification aux installations.</span></li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\" id=\"para-2\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Dans les cas visés au paragraphe 1er, 2° et 3°, le titulaire de l'autorisation \" établissement d'accise \" est tenu d'introduire un nouveau plan.</p>\n            </div>\n        </section>\n    </div>\n</article>",
