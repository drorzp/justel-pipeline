  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 1er/1/1 du même arrêté, modifié en dernier lieu par l'arrêté royal du 9 février 2022, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au § 1er, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">, </span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"sub-provision\" data-marker=\"f)\">\n                  <span class=\"provision-text\">les mots \" 13° et 14° \" sont remplacés par les mots \" 13°, 14°, 15°, 16°, 17° et 18° \" ;</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au § 2, </span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">les mots \" 8° et 9° \" sont remplacés par les mots \" 8°, 9° et 15° \".</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
