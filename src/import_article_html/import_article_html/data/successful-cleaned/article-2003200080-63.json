  "transformedHtml": "<article class=\"legal-article\" id=\"art-63\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 63</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 51, § 2, du même décret, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1.\">\n          <span class=\"provision-text\">A la première phrase, les mots \" vingt-quatre \" sont remplacés par les mots \" vingt-neuf \".</span>\n        </li>\n        <li class=\"provision\" data-number=\"2.\">\n          <span class=\"provision-text\">Il est ajouté les points 12°, 13° et 14° rédigés comme suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"12°\">\n              <span class=\"provision-text\">un représentant des producteurs de <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2008-07-17/52\" data-law-type=\"DRW\" data-article-number=\"1\">gaz issu de SER</span>;</span>\n            </li>\n            <li class=\"provision\" data-number=\"13°\">\n              <span class=\"provision-text\">trois représentants des gestionnaires des réseaux gaziers;</span>\n            </li>\n            <li class=\"provision\" data-number=\"14°\">\n              <span class=\"provision-text\">un représentant des fournisseurs de gaz.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
