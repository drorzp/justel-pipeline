  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 35, alinéa 1er du même arrêté, les mots \"à l'article 34, alinéa 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">\" sont remplacés par les mots \", selon le cas, à l'article 34, § 1er, alinéa 1er,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">, ou à l'article 34, § 2, alinéa 1er,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">\".</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
