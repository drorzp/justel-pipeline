  "transformedHtml": "<article class=\"legal-article\" id=\"art-9\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 9</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'art. 30, § 2, est remplacé par ce qui suit : \" Par travaux de restauration spécialisés, il faut entendre :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">orgues, carillons, horloges de tour et cloches;</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">instruments historiques;</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">sculptures (en bois et en pierre), pierres tombales;</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">panneaux, peintures, peintures murales;</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">revêtements des murs, textile;</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">arbres, jardins historiques;</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">meubles, lambris, meubles de jardin et de rue;</span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">armes héraldiques et symboles;</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">vitraux;</span></li>\n                <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">ferronnerie;</span></li>\n                <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">prospection archéologique;</span></li>\n                <li class=\"provision\" data-number=\"12°\"><span class=\"provision-text\">instruments, machines et objets industriels archéologiques;</span></li>\n                <li class=\"provision\" data-number=\"13°\"><span class=\"provision-text\">et autres biens culturels qui font partie intégrante d'un monument, notamment l'équipement accessoire et les éléments décoratifs.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
