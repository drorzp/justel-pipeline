  "transformedHtml": "<article class=\"legal-article\" id=\"art-35\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 35</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 57 de la même loi, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans l'alinéa 2, les mots &quot; et les sanctions visées à l'article 4, 3° et 4°, à l'issue d'une période de trois ans &quot; sont supprimés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans l'alinéa 4, le mot &quot; définitivement &quot; est inséré après le mot &quot; prononcée &quot;.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
