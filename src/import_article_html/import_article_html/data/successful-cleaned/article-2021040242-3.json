  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 6, paragraphe 2, alinéa 1ier du même arrêté, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">Les 4° et 5° sont remplacés par ce qui suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"4°\">\n                            <span class=\"provision-text\">la valorisation des sous-produits de bois pour produire de l'énergie renouvelable</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"5°\">\n                            <span class=\"provision-text\">la protection de l'environnement : utilisation d'huile biodégradable, diminution de la pression au sol et autres</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">Le 6° est abrogé.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
