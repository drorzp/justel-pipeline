  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-1er\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Pour pouvoir faire partie du conseil d'administration, il faut :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">jouir de ses droit civils et politiques;</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">être de conduite irréprochable.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\" id=\"para-2\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Le conseil d'administration adopte un règlement organique. Il règle :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">le fonctionnement du conseil d'administration et les règles applicables aux administrateurs, à savoir, notamment :</span>\n                        <ol class=\"sub-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"a)\">\n                                les modalités de désignation du président du conseil d'administration\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"b)\">\n                                les modalités de désignation des administrateurs visés à l'article 3, 5°, 6° et 7°\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"c)\">\n                                les jetons de présence et le remboursement des débours par analogie aux règles en vigueur pour les conseillers de l'action sociale de Gembloux\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"d)\">\n                                les incompatibilités et les conflits d'intérêts\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"e)\">\n                                la cessation de fonction des administrateurs\n                            </li>\n                        </ol>\n                    </li>\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">les règles financières et comptables;</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"3°\">\n                        <span class=\"provision-text\">la gestion journalière de la Fondation;</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"4°\">\n                        <span class=\"provision-text\">le statut du personnel de la Fondation, par analogie à celui applicable au personnel du centre public d'action sociale de Gembloux;</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"5°\">\n                        <span class=\"provision-text\">la représentation de la Fondation dans les actes judiciaires et extrajudiciaires.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n    </div>\n</article>",
