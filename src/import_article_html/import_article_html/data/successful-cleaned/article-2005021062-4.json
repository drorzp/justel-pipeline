  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 4 du même arrêté est remplacé par la disposition suivante :</p>\n            <p class=\"intro-text\">\" Art. 4. Le comité de direction est composé des titulaires des fonctions énumérées à l'article 3, § 1er,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">1°</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">2°</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">3°</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">4°</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">et § 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">1°</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">et est présidé par le président du Service public fédéral de programmation Politique scientifique. \"</p>\n        </div>\n    </div>\n</article>",
