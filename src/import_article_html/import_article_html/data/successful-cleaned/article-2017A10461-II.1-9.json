  "transformedHtml": "<article class=\"legal-article\" id=\"art-II-1-9\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article II.1-9</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p>Chez les employeurs du groupe C, le service interne est toujours chargé des missions visées à l'article II.1-4, alinéa 2, </p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"13°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"16°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">\n                        <ol class=\"numbered-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"a)\"><span class=\"provision-text\"></span></li>\n                            <li class=\"sub-provision\" data-marker=\"c)\"><span class=\"provision-text\"></span></li>\n                            <li class=\"sub-provision\" data-marker=\"h)\"><span class=\"provision-text\"></span></li>\n                            <li class=\"sub-provision\" data-marker=\"i)\"><span class=\"provision-text\"></span></li>\n                        </ol>\n                    </span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">ainsi que des missions et des tâches visées à l'article II.1-11, s'il est fait appel à un service externe.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
