  "transformedHtml": "<article class=\"legal-article\" id=\"art-79\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 79</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 246 du même décret, modifié par le décret du 30 avril 2009, sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au paragraphe 1er, 1°, le membre de phrase \" , les fixations et modifications du cadre du personnel \" sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">au paragraphe 1er, les points 5°, 7°, 9 ° et 10° sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">le paragraphe 2 est complété par les points 3° et 4°, rédigés comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"3°\">\n                            <span class=\"provision-text\">les comptes des agences autonomisées externes;</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"4°\">\n                            <span class=\"provision-text\">les plans pluriannuels et les budgets de la régie provinciale autonome.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
