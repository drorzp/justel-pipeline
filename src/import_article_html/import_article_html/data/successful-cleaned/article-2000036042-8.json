  "transformedHtml": "<article class=\"legal-article\" id=\"art-8\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 8</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article XIV 12 du même statut, modifié par les arrêtés du Gouvernement flamand des 28 avril 1998, 19 décembre 1998, 28 janvier 2000, 14 avril 2000 et 8 juin 2000, les mots \":</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"19°\"><span class=\"provision-text\">aux</span></li>\n                <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"24°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"27°\"><span class=\"provision-text\">inclus\"</span></li>\n            </ol>\n            <p class=\"intro-text\">sont remplacés par les mots \":</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"19°\"><span class=\"provision-text\">aux</span></li>\n                <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"24°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"27°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"28°\"><span class=\"provision-text\">inclus\".</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
