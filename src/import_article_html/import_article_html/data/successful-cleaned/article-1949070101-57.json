  "transformedHtml": "<article class=\"legal-article\" id=\"art-57\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 57</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-01-20/14\" data-law-type=\"AR\" data-article-number=\"73\">\n        <p class=\"intro-text\">\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-09-26/05\" data-law-type=\"AR\" data-article-number=\"6\">\n            Il ne peut être mis fin unilatéralement au contrat de travail de l'employé admis à titre définitif que :\n          </span>\n        </p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">pour un motif grave, tel que prévu à l'article 35 de la loi du 3 juillet 1978 relative aux contrats de travail;</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-09-26/05\" data-law-type=\"AR\" data-article-number=\"6\">\n                en exécution de l'article 34 de l'arrêté royal du 24 septembre 2013 relatif à l'évaluation dans le secteur public;\n              </span>\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-09-26/05\" data-law-type=\"AR\" data-article-number=\"6\">\n                si l'employé ne remplit plus les conditions mentionnées à l'article 16, § 1er, 2°, 3° et 5°, de l'arrêté royal du 2 octobre 1937 portant le statut des agents de l'Etat;\n              </span>\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"4°\">\n            <span class=\"provision-text\">suite à une violation de l'article 84;</span>\n          </li>\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">pour une faute grave ou un manquement de l'employé qui empêche toute collaboration professionnelle.</span>\n          </li>\n        </ol>\n        <p>\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-09-26/05\" data-law-type=\"AR\" data-article-number=\"6\">...</span>\n        </p>\n      </span>\n    </div>\n  </div>\n</article>",
