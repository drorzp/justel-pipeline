  "transformedHtml": "<article class=\"legal-article\" id=\"art-34\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 34</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        Dans l'article 247, 2°, du même Code, modifié en dernier lieu par la loi du 25 décembre 2016, les mots \"les montants visés à l'article 234, alinéa 1er, 6° et 7° \" sont remplacés par les mots \"les montants visés à l'article 234, alinéa 1er, 6°, 6° bis, 7° et 7° bis\".\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">\" sont remplacés par les mots \"les montants visés à l'article 234, alinéa 1er,</span>\n        </li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">bis,</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">bis\".</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
