  "transformedHtml": "<article class=\"legal-article\" id=\"art-37\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 37</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les forfaits de fonctionnement et d'activités visés aux articles 30,:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <p class=\"intro-text\">4°, 31,:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et à l'article 32,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">sont indexés annuellement, dans la limite des crédits budgétaires disponibles, suivant l'indexation du budget général des dépenses primaires de la Communauté française (indice santé) et ce, pour la première fois à partir du 1er janvier 2010.</span></li>\n      </ol>\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-12-18/21\" data-law-type=\"DCFR\" data-article-number=\"46\">\n        <p class=\"intro-text\">Par dérogation à l'alinéa 1er, les montants des subsides visés aux articles 30,:</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n        </ol>\n        <p class=\"closing-text\">4°, 31, 1°, et 32, 1°, ne sont pas indexés durant les années civiles 2015 et 2016.</p>\n      </span>\n    </div>\n  </div>\n</article>",
