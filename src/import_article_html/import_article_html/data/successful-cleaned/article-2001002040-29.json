  "transformedHtml": "<article class=\"legal-article\" id=\"art-29\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 29</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A la même annexe, secteur XVII, Communauté française, sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">la rubrique B. est supprimée;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à la rubrique C., </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"5°\">le 5°, </li>\n                        <li class=\"sub-provision\" data-marker=\"6°\">le 6°, </li>\n                        <li class=\"sub-provision\" data-marker=\"7°\">le 7°, </li>\n                        <li class=\"sub-provision\" data-marker=\"8°\">le 8°, </li>\n                        <li class=\"sub-provision\" data-marker=\"9°\">le 9° et </li>\n                        <li class=\"sub-provision\" data-marker=\"10°\">le 10°</li>\n                    </ol>\n                    <span class=\"provision-text\"> sont supprimés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">la rubrique C. est complétée comme suit : </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"13°\">13° Le Commissariat général aux relations internationales.</li>\n                        <li class=\"sub-provision\" data-marker=\"14°\">14° Le Service de perception de la redevance radio et télévision de la Communauté française.</li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
