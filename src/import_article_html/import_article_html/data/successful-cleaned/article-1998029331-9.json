  "transformedHtml": "<article class=\"legal-article\" id=\"art-9\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 9</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>\n        Nul élève ne peut être admis à fréquenter, en qualité d'élève régulier, une année d'études d'un cours artistique complémentaire s'il ne remplit les conditions visées à l\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-09-21/11\" data-law-type=\"DCFR\" data-article-number=\"6\">article 8, § 1er, 1°, 2° et 3°</span>.\n        Les conditions visées à l\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-11-20/08\" data-law-type=\"DCFR\" data-article-number=\"6\">article 8, § 1er, \n          <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-09-21/11\" data-law-type=\"DCFR\" data-article-number=\"6\">1° et 2°</span>\n        </span>\n        sont définies par le Gouvernement pour chacun des cours complémentaires concernés.\n      </p>\n    </div>\n  </div>\n</article>",
