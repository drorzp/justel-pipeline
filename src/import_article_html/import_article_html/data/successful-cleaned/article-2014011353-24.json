  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 24</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">La demande de renonciation à la concession est adressée au délégué du ministre.</p>\n                    <p class=\"intro-text\">L'acceptation d'une renonciation est subordonnée, le cas échéant, à l'exécution des mesures requises en vertu de l'article 15,:</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"6°\">\n                            <span class=\"provision-text\">et de l'[article 25</span>\n                        </li>\n                    </ol>\n                    <p class=\"closing-text\">]. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2014-08-07\" data-law-type=\"M.B.\">&lt;Erratum, M.B. 07-08-2014,p. 57538&gt;</span></p>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 2.</h3>\n                <div class=\"paragraph-content\">\n                    <p>L'acceptation d'une renonciation est prononcée par le ministre, sur proposition de son délégué.</p>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 3.</h3>\n                <div class=\"paragraph-content\">\n                    <p>La décision du ministre portant l'acceptation de la renonciation de la concession domaniale est adressée au concessionnaire, à la commission, au gestionnaire du réseau de transport et aux administrations concernées par pli recommandé.</p>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
