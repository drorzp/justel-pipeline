  "transformedHtml": "<article class=\"legal-article\" id=\"art-45\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 45</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 32 de la même loi, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 1er, le 4° est abrogé;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 1er, le 7° est abrogé;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 2, 2° les mots \"4° à 6°\" sont remplacés par les mots \"5° et 6°\";</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 2, le 3° est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
