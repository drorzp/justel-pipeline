  "transformedHtml": "<article class=\"legal-article\" id=\"art-31\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 31</h2>\n    </header>\n    <div class=\"article-content\">\n        <p>L'article 53 du même arrêté, remplacé par l'arrêté royal du 7 octobre 2021, est complété par le paragraphe 3 rédigé comme suit :</p>\n        <section class=\"paragraph\" id=\"para-3\">\n            <h3 class=\"paragraph-marker\">§ 3.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Par dérogation aux articles 35,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et 37,</span>\n                    </li>\n                </ol>\n                <p class=\"closing-text\">1°, une organisation subventionnée peut produire une pièce justificative qui n'est pas numérisée, sur base motivée, avec l'accord de l'administration.</p>\n            </div>\n        </section>\n    </div>\n</article>",
