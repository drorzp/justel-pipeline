  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 27 du même arrêté, modifié par l'arrêté du Gouvernement flamand du 19 mars 1986, il est ajouté un 5° et 6°, rédigés comme suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">médiateur interculturel, visé à l'article 25, § 2, 1° :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">être au moins porteur du diplôme d'enseignement secondaire supérieur et justifier d'une expérience d'au moins deux ans en médiation interculturelle;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"6°\">\n                    <span class=\"provision-text\">membre du personnel, visé à l'article 25, § 2, 2° :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">être porteur d'un diplôme, visé au 3° jusqu'au 4° inclus.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
