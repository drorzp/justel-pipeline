  "transformedHtml": "<article class=\"legal-article\" id=\"art-4-8-21\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4.8.21</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-04-04/89\" data-law-type=\"DCFL\" data-article-number=\"82\">\n          Chacune des personnes, visées à l'article 4.8.11, § 1er, alinéa premier, peut intervenir dans \n          <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-07-14/19\" data-law-type=\"DCFL\" data-article-number=\"10\">\n            le recours concernant la décision d'enregistrement\n          </span>.\n        </span>\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-07-14/19\" data-law-type=\"DCFL\" data-article-number=\"10\">\n          Chaque partie, visée à l'article 4.8.11, § 3, peut intervenir dans les recours visés à l'article 4.8.2, \n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">1°</span>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">2°</span>\n            </li>\n          </ol>\n        </span>\n      </p>\n    </div>\n  </div>\n</article>",
