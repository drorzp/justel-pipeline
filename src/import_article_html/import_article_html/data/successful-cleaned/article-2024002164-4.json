  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>L'article 14, alinéa 1er, du même arrêté est complété par un 4° et un 5°, rédigés comme suit :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">les surfaces d'eau stagnante d'une superficie supérieure à trente ares ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">les surfaces boisées répondant aux caractéristiques cumulatives suivantes :</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"sub-provision-text\">une superficie supérieure à trente ares ;</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"sub-provision-text\">une largeur de plus de dix mètres ;</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"c)\">\n              <span class=\"sub-provision-text\">la distance maximale entre les couronnes des arbres ou des arbustes est de cinq mètres.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
