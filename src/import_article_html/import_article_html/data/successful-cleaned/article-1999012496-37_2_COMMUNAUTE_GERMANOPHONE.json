  "transformedHtml": "<article class=\"legal-article\" id=\"art-37/2_COMMUNAUTE_GERMANOPHONE\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 37/2_COMMUNAUTE_GERMANOPHONE</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-11-06/01\" data-law-type=\"ARW\" data-article-number=\"7\">\n            Les montants de rémunération visés à l'article 2, alinéa 1er, 33°, à l'article 9, alinéa 1er, 6°, 7° et 15°, et \n            <span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2019-05-23/27\" data-law-type=\"ACG\" data-article-number=\"39\">\n              à l'article 30.4, 4°, à l'article 30.6, 3°, et à l'article 30.9, 2°,\n            </span> \n            du présent arrêté doivent constituer la contrepartie des prestations de travail effectuées et être connus, avec certitude, avant le début de l'occupation des travailleurs en Belgique.\n          </span>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
