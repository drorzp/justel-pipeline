  "transformedHtml": "<article class=\"legal-article\" id=\"art-18\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 18</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">La note financière des comptes annuels comprend tous les éléments suivants :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">le compte des objectifs</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">l'état de l'équilibre financier</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">la réalisation des crédits</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">le bilan</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">l'état des produits et charges.</span></li>\n            </ol>\n            <p class=\"intro-text\">L'alinéa 1er, 4° et 5°, ne s'applique pas aux districts.</p>\n        </div>\n    </div>\n</article>",
