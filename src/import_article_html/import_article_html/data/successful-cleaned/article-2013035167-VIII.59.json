  "transformedHtml": "<article class=\"legal-article\" id=\"art-VIII-59\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article VIII.59</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p>Le présent chapitre entre en vigueur le 1er janvier 2013.</p>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p>L'article VIII.55, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">produit ses effets le 1er septembre 2002.</span></li></ol></p>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 3.</h3>\n      <div class=\"paragraph-content\">\n        <p>L'article VIII.54, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li><li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">produit ses effets le 1er août 2012.</span></li></ol></p>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 4.</h3>\n      <div class=\"paragraph-content\">\n        <p>Les articles VIII.1, VIII.2, VIII.4, VIII.6 à VIII.11 inclus, VIII.12, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li><li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">VIII.13 à VIII.17 inclus, VIII.19, VIII.21 à VIII.43 inclus, VIII.46 à VIII.53 inclus, VIII.55,</span></li><li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">VIII.56, VIII.57 et VIII.58, produisent leurs effets le 1er septembre 2012.</span></li></ol></p>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 5.</h3>\n      <div class=\"paragraph-content\">\n        <p>L'article VIII.12, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">entre en vigueur le 1er février 2013.</span></li></ol></p>\n      </div>\n    </section>\n    <section class=\"paragraph\">\n      <h3 class=\"paragraph-marker\">§ 6.</h3>\n      <div class=\"paragraph-content\">\n        <p>L'article VIII.54, <ol class=\"numbered-provisions\"><li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">entre en vigueur le 1er septembre 2013.</span></li></ol></p>\n      </div>\n    </section>\n  </div>\n</article>",
