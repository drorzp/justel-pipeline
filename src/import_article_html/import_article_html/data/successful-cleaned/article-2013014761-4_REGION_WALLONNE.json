  "transformedHtml": "<article class=\"legal-article\" id=\"art-4_REGION_WALLONNE\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4_REGION_WALLONNE</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">\n                Les entreprises qui sont établies en Belgique ne peuvent effectuer les transports de voyageurs visés à \n                <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-01-10/16\" data-law-type=\"DRW\" data-article-number=\"14\">\n                    l'article 2, 1°, 2°, 4° et 5°\n                </span>, que si elles disposent de la licence communautaire visée à l'article 4 du Règlement (CE) n° 1073/2009.\n            </p>\n        </div>\n    </div>\n    <footer class=\"article-footer\">\n        <ul class=\"footnotes\">\n            <li class=\"footnote\" data-footnote-id=\"1\" data-dossier-number=\"2023-03-10/03\" data-law-type=\"DCFL\" data-article-number=\"11\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2023031003\">\n                    DCFL [2023-03-10/03], art. 11, 005; En vigueur : 03-04-2023\n                </a>\n            </li>\n            <li class=\"footnote\" data-footnote-id=\"2\" data-dossier-number=\"2024-01-10/16\" data-law-type=\"DRW\" data-article-number=\"14\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2024011016\">\n                    DRW [2024-01-10/16], art. 14, 009; En vigueur : 06-04-2024\n                </a>\n            </li>\n        </ul>\n    </footer>\n</article>",
