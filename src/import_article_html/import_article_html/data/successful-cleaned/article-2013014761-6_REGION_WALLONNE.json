  "transformedHtml": "<article class=\"legal-article\" id=\"art-6_REGION_WALLONNE\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 6_REGION_WALLONNE</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Les transports de voyageurs visés à l'<span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-01-10/16\" data-law-type=\"DRW\" data-article-number=\"16\">article 2, 1°, 2° et 3°,</span> ne peuvent être effectués sur le territoire national que si les documents de contrôle et d'autorisation déterminés par le Roi se trouvent à bord des véhicules utilisés à cet effet.</p>\n    </div>\n  </div>\n  <footer class=\"article-footer\">\n    <ul class=\"footnotes\">\n      <li class=\"footnote\" data-footnote-id=\"1\" data-dossier-number=\"2023-03-10/03\" data-law-type=\"DCFL\" data-article-number=\"13\">\n        <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2023031003\">DCFL [2023-03-10/03], art. 13, 005; En vigueur : 03-04-2023</a>\n      </li>\n      <li class=\"footnote\" data-footnote-id=\"2\" data-dossier-number=\"2024-01-10/16\" data-law-type=\"DRW\" data-article-number=\"16\">\n        <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2024011016\">DRW [2024-01-10/16], art. 16, 009; En vigueur : 06-04-2024</a>\n      </li>\n    </ul>\n  </footer>\n</article>",
