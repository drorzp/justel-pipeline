  "transformedHtml": "<article class=\"legal-article\" id=\"art-32\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 32</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2010-08-18/02\" data-law-type=\"AR\" data-article-number=\"4\">\n                <p class=\"intro-text\">Les postulants qui sollicitent certains postes vacants présentent en outre une ou plusieurs des épreuves suivantes, relatives aux activités spécifiques aux fonctions ou aux formations spécifiques auxquelles ces postes correspondent :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">des épreuves psychotechniques relatives à des aptitudes particulières</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">des épreuves psychotechniques relatives aux aptitudes techniques</span></li>\n                    <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">des examens médicaux relatifs à l'aptitude médicale</span></li>\n                    <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">des épreuves <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2013-11-07/51\" data-law-type=\"AR\" data-article-number=\"31\">d'aptitude</span> physique mesurant le potentiel physique</span></li>\n                    <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">des épreuves de <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2013-11-07/51\" data-law-type=\"AR\" data-article-number=\"31\">connaissances scolaires et/ou académiques</span></span></li>\n                    <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">une épreuve de connaissance professionnelle en anglais</span></li>\n                    <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">des épreuves scientifiques</span></li>\n                    <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">des épreuves de connaissance musicale et professionnelle de postulant musicien</span></li>\n                    <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2022-12-26/31\" data-law-type=\"AR\" data-article-number=\"4\">des épreuves cognitives</span></span></li>\n                </ol>\n            </span>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2019-07-03/09\" data-law-type=\"AR\" data-article-number=\"4\">\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">des épreuves pratiques</span></li>\n                </ol>\n            </span>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2022-12-26/31\" data-law-type=\"AR\" data-article-number=\"4\">\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">des épreuves cognitives et psychomotrices</span></li>\n                </ol>\n                <p>Les épreuves visées à l'alinéa 1er, 9° et 11°, ne peuvent être présentées qu'au maximum trois fois.</p>\n            </span>\n        </div>\n    </div>\n</article>",
