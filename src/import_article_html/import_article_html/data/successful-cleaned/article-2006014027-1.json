  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Pour l'application du présent arrêté, on entend par :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-03-07/12\" data-law-type=\"AR\" data-article-number=\"2\">\" sûreté du transport ferroviaire \" : la combinaison des mesures ainsi que des moyens humains et matériels visant à protéger le transport ferroviaire contre tout acte de terrorisme ou d'extrémisme, tels que définis aux points 2° et 3° du présent article ;</span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-03-07/12\" data-law-type=\"AR\" data-article-number=\"2\">\" terrorisme \" : le terrorisme tel que défini à l'article 8, 1°,\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"b)\">de la loi organique du 30 novembre 1998 des services de renseignement et de sécurité;</li>\n              </ol>\n            </span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-03-07/12\" data-law-type=\"AR\" data-article-number=\"2\">\" extrémisme \" : l'extrémisme tel que défini à l'article 8, 1°,\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"c)\">de la loi organique du 30 novembre 1998 des services de renseignement et de sécurité;</li>\n              </ol>\n            </span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-03-07/12\" data-law-type=\"AR\" data-article-number=\"2\">\" entreprise ferroviaire \" : une entreprise ferroviaire telle que définie à l'article 3, 27°, du Code ferroviaire, détentrice d\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2021-03-02/03\" data-law-type=\"AR\" data-article-number=\"2\">un certificat de sécurité unique</span> valable en Belgique.\n            </span>\n          </span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
