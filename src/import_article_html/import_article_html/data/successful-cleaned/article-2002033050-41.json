  "transformedHtml": "<article class=\"legal-article\" id=\"art-41\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 41</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p>Par dérogation à l'article 16, le subside représente 80 % du montant total des dépenses subsidiables pour les projets d'infrastructure mentionnés à l'article 2, alinéa 1,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">1° à 5°</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"7°\">\n                        <span class=\"provision-text\">7° à 9°</span>\n                    </li>\n                </ol>\n                <p>envisagés par les services et établissements pour personnes handicapées.</p>\n            </div>\n        </section>\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p>Le subside représente 60 % du montant total des dépenses subsidiables pour le projet d'infrastructure mentionné à l'article 2, alinéa 1er,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"6°\">\n                        <span class=\"provision-text\">6°</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n    </div>\n</article>",
