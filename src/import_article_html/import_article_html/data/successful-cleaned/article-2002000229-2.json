  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article VII.III.3 PJPol, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les dispositions de l'alinéa 1er, 6°, 7° et 10° sont supprimées;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans l'alinéa 1er, les \" 8°, 9°, 11° et 12° \" sont remplacés par \" 6°, 7°, 8° et 9° \";</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">dans l'alinéa 2, les mots \" 2° à 10° y compris \" sont remplacés par les mots \" 2° à 7° y compris \".</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
