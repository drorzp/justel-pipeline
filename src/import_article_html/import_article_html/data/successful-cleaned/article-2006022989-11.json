  "transformedHtml": "<article class=\"legal-article\" id=\"art-11\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 11</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-1er\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p>Aucun recours administratif n'est possible contre les décisions visées à l'article 7, § 1er,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">.</span></li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\" id=\"para-2\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p>En cas de différend judiciaire à propos des décisions visées à l'article 7, et en attendant la décision du tribunal, l'INAMI verse le montant des interventions sur la base des calculs du Service.</p>\n            </div>\n        </section>\n    </div>\n</article>",
