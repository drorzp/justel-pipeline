  "transformedHtml": "<article class=\"legal-article\" id=\"art-157\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 157</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 362-3 du Code civil, inséré par la loi du 24 avril 2003, les modifications suivantes sont apportées :</p>\n      <ol class=\"sub-provisions-list\">\n        <li class=\"sub-provision\" data-marker=\"a)\">\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">est remplacé par ce qui suit :</span>\n            </li>\n          </ol>\n          <p class=\"quote\">\"2° a reçu de l'autorité centrale fédérale le jugement visé à l'article 1231-37 du Code judiciaire;\";</p>\n        </li>\n        <li class=\"sub-provision\" data-marker=\"b)\">\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"3°\">\n              <span class=\"provision-text\">les mots \"les rapports prévus aux 1° et 2° \" sont remplacés par les mots \"le rapport visé au 1° et le jugement visé au 2° \";</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"sub-provision\" data-marker=\"c)\">\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"4°\">\n              <span class=\"provision-text\">les mots \"prévu au 2° \" sont remplacés par les mots \"visé à l'article 1231-38 du Code judiciaire.\".</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
