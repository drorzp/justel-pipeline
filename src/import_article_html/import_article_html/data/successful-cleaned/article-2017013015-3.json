  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 378, § 1er, alinéa 1er, du même Code, remplacé par la loi du 29 avril 2001 et modifié par les lois du 13 février 2003 et 30 juillet 2013, les mots &quot;les actes prévus à l'article 410, § 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à 6°, 8°, </span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">et </span></li>\n        <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">à </span></li>\n        <li class=\"provision\" data-number=\"14°\"><span class=\"provision-text\">&quot; sont remplacés par les mots &quot;les actes prévus à l'article 410, § 1er,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à </span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">et </span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">à </span></li>\n        <li class=\"provision\" data-number=\"14°\"><span class=\"provision-text\">&quot;.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
