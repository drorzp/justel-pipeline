  "transformedHtml": "<article class=\"legal-article\" id=\"art-16\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 16</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 46, § 1er, alinéa 1er, du même arrêté, modifié par l'arrêté royal du 25 mars 1999, les mots \" 43,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">, 44,</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">et 45,</span>\n        </li>\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\"</span>\n        </li>\n      </ol>\n      <p class=\"intro-text\">sont remplacés par les mots \" 43, § 1er et § 2, alinéa 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à 4 et</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">, 44, alinéa 1er,</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">, 45, alinéa 1er,</span>\n        </li>\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\"</span>\n        </li>\n      </ol>\n      <p class=\"intro-text\">.</p>\n    </div>\n  </div>\n</article>",
