  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\" id=\"para-3\">\n            <h3 class=\"paragraph-marker\">§ 3.</h3>\n            <div class=\"paragraph-content\">\n                <p class=\"intro-text\">Préalablement au calcul du nombre de points, le nombre d'élèves qui satisfait uniquement aux indicateurs d'égalité des chances visés à l'article VI.2, § 1er,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">ou</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"1° et 5°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                </ol>\n                <p class=\"closing-text\">du décret, est multiplié par un coefficient 0,4417.</p>\n            </div>\n        </section>\n    </div>\n</article>",
