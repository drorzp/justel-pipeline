  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 7</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\" id=\"para-1er\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p>Les membres du Bureau fédéral d'orientation visés <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-07-01/01\" data-law-type=\"AR\" data-article-number=\"6\"><span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2014-03-23/07\" data-law-type=\"AR\" data-article-number=\"6\">à l'article 6, § 3, 3°, 4°, 5° et 6°,</span> du Code pénal social</span>, reçoivent une allocation annuelle de 7.100 EUR. Cette allocation annuelle est rattachée à l'indice-pivot 138,01.</p>\n      </div>\n    </section>\n    <section class=\"paragraph\" id=\"para-2\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p>Les membres du Bureau fédéral d'orientation visés à <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2011-07-01/01\" data-law-type=\"AR\" data-article-number=\"6\"><span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2014-03-23/07\" data-law-type=\"AR\" data-article-number=\"6\">à l'article 6, § 3, 7°,</span> du même Code</span>, reçoivent une allocation annuelle de 2.200 EUR. Cette allocation annuelle est rattachée à l'indice-pivot 138,01.</p>\n      </div>\n    </section>\n  </div>\n</article>",
