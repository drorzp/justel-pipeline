  "transformedHtml": "<article class=\"legal-article\" id=\"art-4-1-27\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4.1.27</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Sans préjudice de l'article 98 de la loi, le ministre fixe :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">le contenu détaillé et les règles d'organisation des épreuves de sélection;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">les éléments qui font l'objet de l'enquête visée à <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2019-01-11/07\" data-law-type=\"AR\" data-article-number=\"6\">l'article 12, alinéa 2, b), de la loi du 26 avril 2002</span>;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">les seuils minimums <span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2021-07-11/07\" data-law-type=\"AR\" data-article-number=\"16\">...</span> pour les épreuves de sélection visées à l'article <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2019-01-11/07\" data-law-type=\"AR\" data-article-number=\"3\">IV.I.15,</span> 1°, 2° et 3°;</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">les épreuves de sélection ou, le cas échéant, une partie d'entre elles, constituant le concours;</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2021-07-11/07\" data-law-type=\"AR\" data-article-number=\"16\">...</span></span>\n                </li>\n                <li class=\"provision\" data-number=\"6°\">\n                    <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2009-06-07/13\" data-law-type=\"AR\" data-article-number=\"11\">la composition et la méthode de travail de la commission de délibération visée à l'article IV.I.17</span></span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
