  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Les statuts ou le règlement de gestion d'un OPCA peuvent prévoir la création de catégories de parts, telles que visées à l'article 184 § 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">de la loi. Les catégories de parts ainsi créées sont désignées ci-dessous par le vocable \"classes de parts\".</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
