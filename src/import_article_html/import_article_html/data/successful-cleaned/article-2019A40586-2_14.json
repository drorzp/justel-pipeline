  "transformedHtml": "<article class=\"legal-article\" id=\"art-2:14\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2:14</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Sont publiés pour les sociétés:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les extraits, déclarations et documents visés à l'article 2:8, § 1er, 2°, 5°, 6°, 7°, 8° et 10°</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"provision-text\">et § 3;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">la mention de l'objet des documents visés à l'article 2:8, § 1er, 4° et 10°</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"provision-text\">;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">l'objet des documents modificatifs de l'acte constitutif qui ne doivent pas être publiés par extrait;</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">l'objet des documents dont le dépôt seul est prescrit par le présent code;</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">les actes ou extraits modifiant les dispositions dont le présent code prescrit la publication.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
