  "transformedHtml": "<article class=\"legal-article\" id=\"art-37\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 37</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 1er et 37 entrent en vigueur le jour de la publication de la présente loi au Moniteur belge.</p>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 2.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 2 à 6, 7,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">10, 1°, 11, 12, 14, 1°, 17, 1°, 18, 19, 24, 26 et 28,</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">entrent en vigueur le jour des élections pour les parlements de communauté et de région en 2014.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 3.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 7,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">8, 9, 10,</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">à 4°, 13, 14,</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">15, 16, 20, 21, 28,</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"4°\">\n                            <span class=\"provision-text\">à 6°, 29 à 31 et 34 à 36 entrent en vigueur le 1er janvier 2015.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 4.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">L'article 23,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">entre en vigueur le premier jour du mois dans lequel l'indice pivot 122,01 produira ses effets sur le calcul de la dotation visée aux articles 15 et suivants de la présente loi.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 5.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 23,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">32 et 33 entrent en vigueur le 1er janvier 2014.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 6.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 22 et 27 entrent en vigueur le 1er janvier 2016.</p>\n                </div>\n            </section>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 7.</h3>\n                <div class=\"paragraph-content\">\n                    <p class=\"intro-text\">Les articles 17,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">et 25 entrent en vigueur le jour des premières élections fédérales qui suivent les élections visées à l'alinéa 2.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
