  "transformedHtml": "<article class=\"legal-article\" id=\"art-149\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 149</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article L4142-39 du même Code, inséré par le décret du 1er juin 2006, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">l'alinéa 3 est abrogé;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">dans l'alinéa 4 ancien, devenant l'alinéa 3, un 2° /1 rédigé comme suit est inséré entre le 2° et le 3° :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"2° /1\">\n                            <span class=\"provision-text\">la mention du nombre des bulletins non valables, en distinguant clairement, parmi ceux-ci, le nombre de bulletins nuls et le nombre de bulletins blancs;</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
