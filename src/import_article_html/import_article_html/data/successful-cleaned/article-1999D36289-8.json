  "transformedHtml": "<article class=\"legal-article\" id=\"art-8\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 8</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les espaces non-résidentiels qui à l'origine étaient destinés à être vendus, doivent être vendus publiquement, sauf dans les cas mentionnés à l'(article 34, § 3,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">du code flamand du Logement.</span>\n        </li>\n      </ol>\n      <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2004-01-09/38\" data-law-type=\"AGF\" data-article-number=\"24\">&lt;AGF 2004-01-09/38, art. 24, 002; En vigueur : 09-02-2004&gt;</span>\n    </div>\n  </div>\n</article>",
