  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 4 du même arrêté, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 1er,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"provision-text\">les</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"4°\">\n                  <span class=\"provision-text\">sont abrogés;</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">dans le paragraphe 1er, alinéa 2, la première ligne est remplacée par ce qui suit : \"Les membres visés à l'alinéa 1er,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">et</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">sont désignés jusqu'à la dissolution du SIST.\";</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">les paragraphes 3 à 5 sont abrogés.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
