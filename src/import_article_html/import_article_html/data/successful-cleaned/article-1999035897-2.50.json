  "transformedHtml": "<article class=\"legal-article\" id=\"art-2-50\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2.50</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">L'article 2.49 produit ses effets le 1er avril 1991.</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">L'article 2.46 produit ses effets le 1er janvier 1994.</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">Les articles 2.25 et 2.29 produisent leurs effets le 1er octobre 1994.</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">Les articles 2.4,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">2.28, 2.34, 2.38 et 2.45 produisent leurs effets le 1er septembre 1995.</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">Les articles (2.1,) 2.11, 2.17, 2.18,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">à 4° inclus,</span>\n            </li>\n          </ol>\n          <span class=\"provision-text\">2.19,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">à 3°,</span>\n            </li>\n          </ol>\n          <span class=\"provision-text\">(2.20) et 2.37 produisent leurs effets le 1er janvier 1996. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2001-04-20/43\" data-law-type=\"DCFL\" data-article-number=\"34\">DCFL 2001-04-20/43, art. 34, 003;**En vigueur :**01-01-1996</span></span>\n        </li>\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">Les articles 2.18,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"5°\">\n              <span class=\"provision-text\">et 2.19,</span>\n            </li>\n          </ol>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"4°\">\n              <span class=\"provision-text\">produisent leurs effets le 1er septembre 1996.</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">Les articles 2.30 et 2.32 produisent leurs effets le 1er janvier 1997.</span>\n        </li>\n        <li class=\"provision\" data-number=\"8°\">\n          <span class=\"provision-text\">Les articles 2.24 et 2.31 produisent leurs effets le 1er janvier 1998.</span>\n        </li>\n        <li class=\"provision\" data-number=\"9°\">\n          <span class=\"provision-text\">L'article 2.41 produit ses effets le 1er juillet 1998.</span>\n        </li>\n        <li class=\"provision\" data-number=\"10°\">\n          <span class=\"provision-text\">Les articles [...] 2.3, 2.4,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">2.5, 2.6, 2.7, 2.10, 2.14, 2.16, [...] 2.36, 2.43 et 2.44 produisent leurs effets le 1er septembre 1998. <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"2001-04-20/43\" data-law-type=\"DCFL\" data-article-number=\"34\">DCFL 2001-04-20/43, art. 34, 003;**En vigueur :**01-01-1996</span></span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"11°\">\n          <span class=\"provision-text\">L'article 2.48 produit ses effets le 1er octobre 1998.</span>\n        </li>\n        <li class=\"provision\" data-number=\"12°\">\n          <span class=\"provision-text\">Les articles 2.22, 2.33, 2.33, 2.35, 2.39 et 2.40 produisent leurs effets le 1er janvier 1999.</span>\n        </li>\n        <li class=\"provision\" data-number=\"13°\">\n          <span class=\"provision-text\">Les articles 2.2, 2.8, 2.9, 2.12, 2.13, 2.21, 2.23, 2.42 et 2.47 entrent en vigueur le 1er septembre 1999.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
