  "transformedHtml": "<article class=\"legal-article\" id=\"art-38\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 38</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\" id=\"para-1er\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p>Lorsque le Ministre édicte des règles générales en exécution du présent arrêté, il consulte, sauf le cas de grande urgence, le Conseil Consultatif pour l'occupation des travailleurs étrangers.</p>\n      </div>\n    </section>\n    <section class=\"paragraph\" id=\"para-2\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p>L'autorité compétente peut déroger par décision motivée aux articles 8, 10, 12, 14, 21,</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">et 22,</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">pour des cas individuels dignes d'intérêt pour des raisons économiques ou sociales.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
