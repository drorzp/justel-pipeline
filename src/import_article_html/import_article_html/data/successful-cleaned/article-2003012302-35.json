  "transformedHtml": "<article class=\"legal-article\" id=\"art-35\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 35</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans le même arrêté, est inséré l'article 2bis, rédigés comme suit :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">Art. 2bis.</h3>\n                <div class=\"paragraph-content\">\n                    <p>La durée de la période visée à l'article 27, alinéa 1er,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">de la loi, est au moins égale à la durée de la période qui commence au début de l'exécution de la convention de premier emploi et qui se termine au 30 juin de l'année scolaire en cours, sans toutefois pouvoir être inférieure à six mois.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
