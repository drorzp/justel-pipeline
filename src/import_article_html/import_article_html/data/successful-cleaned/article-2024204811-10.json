  "transformedHtml": "<article class=\"legal-article\" id=\"art-10\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 10</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 12 du même arrêté, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">l'alinéa 1er est complété par les mots \", mais est considéré comme dirigeant de service \"</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à l'alinéa 6, les mots \" contrat d'administration \" sont remplacés par les mots \" plan stratégique \"</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">à l'alinéa 7, dans le</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"1°\">\n                            <span class=\"provision-text\">les mots \" plan de management \" sont remplacés par les mots \" plan stratégique \"</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"3°\">\n                            <span class=\"provision-text\">et</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"5°\">\n                            <span class=\"provision-text\">le mot \" interne \" est abrogé</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
