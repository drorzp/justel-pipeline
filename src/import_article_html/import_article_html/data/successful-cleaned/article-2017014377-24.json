  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 24</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 34 de la même loi, abrogé par la loi du 25 juillet 2008, est rétabli dans la rédaction suivante:</p>\n            <p class=\"intro-text\">\"Art. 34. Après avis du Conseil consultatif des armes, le Roi peut étendre l'application des dispositions des articles 5 à 7 et 19,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">en tout ou en partie aux armes autres que les armes à feu.</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">\".</p>\n        </div>\n    </div>\n</article>",
