  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 12</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Un réseau intersectoriel d'aide perd son label de qualité et les subventions qui s'y rapportent :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">s'il ne remplit pas les obligations imposées par la présente section ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">s'il ne remplit pas les obligations visées à l'article 17, 4°, 6° et 7° ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">s'il n'a plus d'offre relative aux éléments visés à l'article 17, 3° ;</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
