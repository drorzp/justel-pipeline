  "transformedHtml": "<article class=\"legal-article\" id=\"art-96\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 96</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 304 du même arrêté sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à l'alinéa 1, la numérotation suivante \"3° et 4°\" devient respectivement la numérotation \"4° et 5°\".</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à l'alinéa 1, un nouveau 3° est inséré comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"3°\">\n                            <span class=\"provision-text\">dix-huit mois pour le déplacement disciplinaire;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">l'alinéa 2 est remplacé par la disposition suivante :</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">\"Le délai prend cours à partir de la notification de la sanction.</p>\n        </div>\n    </div>\n</article>",
