  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 12</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2016-05-20/17\" data-law-type=\"DCFL\" data-article-number=\"6\">\n            Sur la base de paramètres objectifs, l'importance du contingent auquel les organisations ont droit dans le cadre de leur plan directeur est à chaque fois déterminée au début d'une nouvelle période du plan directeur.\n          </span>\n        </div>\n      </section>\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 2.</h3>\n        <div class=\"paragraph-content\">\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-03-22/07\" data-law-type=\"DCFL\" data-article-number=\"3\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2017-12-22/48\" data-law-type=\"DCFL\" data-article-number=\"11\">\n              Pour les secteurs visés à l'article 9, 1°, 3°,\n            </span>\n            4° et 5°, le Gouvernement flamand arrête les paramètres objectifs et les modalités relatives à la répartition des ressources au sein de chaque secteur, après avis préalable des conseils consultatifs concernés et après consultation des partenaires sociaux.\n          </span>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
