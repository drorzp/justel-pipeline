  "transformedHtml": "<article class=\"legal-article\" id=\"art-577\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 577</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">\n                Le tribunal de première instance connaît de l'appel des jugements rendus en premier ressort par le juge de paix (et, dans les cas prévus à l'article 601bis, par le tribunal de police).\n                <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"1994-07-11/33\" data-law-type=\"L\" data-article-number=\"35\">L 1994-07-11/33, art. 35, 048; En vigueur : 1995-01-01</span>\n                <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2014-03-26/33\" data-law-type=\"L\" data-article-number=\"5\">...</span>.\n            </p>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2014-05-08/02\" data-law-type=\"L\" data-article-number=\"28\">\n                <p class=\"intro-text\">\n                    Par dérogation à l'alinéa 1er, les appels des décisions rendues en premier ressort par le juge de paix dans les cas prévus aux articles 594, 2°, 3°, 6°, 8°, 9°,:\n                </p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"15°\">\n                        <span class=\"provision-text\">à</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"16°\">\n                        <span class=\"provision-text\">\n                            /2 \n                            <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2019-03-10/03\" data-law-type=\"L\" data-article-number=\"4\">, 19° et 23°</span>\n                        </span>\n                    </li>\n                </ol>\n                <p class=\"closing-text\">, et 596 à 597, seront traités, au sein du tribunal de première instance, par le tribunal de la famille.</p>\n            </span>\n        </div>\n    </div>\n</article>",
