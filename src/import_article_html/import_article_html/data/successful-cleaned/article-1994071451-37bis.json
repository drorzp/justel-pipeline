li class=\"sub-provision\" data-marker=\"21)\">\n                    <span class=\"provision-text\">\n                      66,7 p.c. des honoraires pour la prestation 106750\n                    </span>\n                  </li>\n                </ol>\n              </li>\n              <li class=\"sub-provision\" data-marker=\"b)\">\n                <span class=\"provision-text\">\n                  visites du médecin spécialiste en pédiatre :\n                  35 p.c. des honoraires pour les prestations 103751, 103773, 103795, 103810, 103832, 103854, 103876, 103891, 104812, 104834, 104856 et 104871\n                </span>\n              </li>\n            </ol>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
