  "transformedHtml": "<article class=\"legal-article\" id=\"art-33\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 33</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Dans l'article 36/14, § 1er, de la même loi, modifié par la loi du 27 novembre 2012, le</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"17°\">\n          <span class=\"provision-text\">est remplacé par ce qui suit :</span>\n        </li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"17°\">\n          <span class=\"provision-text\">aux agents commissionnés par le ministre qui dans le cadre de leur mission viséé à l'article XV. 2 du Code de droit économique sont compétents pour rechercher et constater les infractions aux dispositions de l'article XV. 89,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">à 18°,</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"20°\">\n              <span class=\"provision-text\">et</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"21°\">\n              <span class=\"provision-text\">du Code de droit économique.\".</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
