  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Les fonctionnaires dirigeants sont compétents, conjointement, pour :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">exécuter le budget de l'Organisme, conformément aux dispositions légales et réglementaires en vigueur;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">prendre les mesures utiles au bon fonctionnement de l'Organisme;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">l'exécution des décisions prises par le Ministre-Président notamment dans le cadre des attributions visées à l'article 4, § 2quater,\n                        <ol class=\"numbered-provisions\">\n                            <li class=\"sub-provision\" data-marker=\"1°\">\n                                <span class=\"provision-text\">1°,</span>\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"2°\">\n                                <span class=\"provision-text\">2° et</span>\n                            </li>\n                            <li class=\"sub-provision\" data-marker=\"7°\">\n                                <span class=\"provision-text\">7°, de la loi du 26 juillet 1971 organisant les agglomérations et les fédérations de communes;</span>\n                            </li>\n                        </ol>\n                    </span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">assurer la représentation du Ministre-Président dans le cadre des missions confiées à l'Organisme;</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                    <span class=\"provision-text\">conclure des accords de partenariats avec d'autres organismes compétents en matière de prévention et de sécurité.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
