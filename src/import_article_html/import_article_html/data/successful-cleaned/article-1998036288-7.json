  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article XI 89 du même arrêté est remplacé par la disposition suivante :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>\"Art. XI 89. Le congé contingenté visé à l'article XI 87,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">1° et 3°, et à l'article XI 88 est sollicité et accordé selon la procédure prévue à l'article XI 36, §§ 1er, 2 et 3.</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">Le congé contingenté visé à l'article XI 87, 2°, est un droit et est sollicité et accordé selon la procédure prévue à l'article XI 36, § 2.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
