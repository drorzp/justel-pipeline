  "transformedHtml": "<article class=\"legal-article\" id=\"art-5/1-4-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5/1.4.4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2019-02-01/11\" data-law-type=\"AGF\" data-article-number=\"21\">\n        <p class=\"intro-text\">L'alimentation en énergie thermique du client domestique d'énergie thermique ne peut pas être débranchée pendant la période du 1er décembre au 1er mars dans les cas visés à l'article 6.2.2, § 1er, 5°,</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"6°\">\n            <span class=\"provision-text\">et</span>\n          </li>\n        </ol>\n        <p class=\"closing-text\">7°, du décret sur l'Energie du 8 mai 2009. Le ministre peut prolonger cette période en fonction des conditions atmosphériques.</p>\n      </span>\n    </div>\n  </div>\n</article>",
