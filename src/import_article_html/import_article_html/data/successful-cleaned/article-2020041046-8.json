  "transformedHtml": "<article class=\"legal-article\" id=\"art-8\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 8</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 5, du même arrêté, l'alinéa 2, est remplacé par ce qui suit :</p>\n            <blockquote class=\"quote-text\">\n                <p>La demande d'indemnité compensatoire doit être introduite avant le 13 mai 2020, à l'exception de l'article 4, alinéa 1er, :</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"4°\">\n                        <span class=\"provision-text\">/1 à</span>\n                    </li>\n                </ol>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"4°\">\n                        <span class=\"provision-text\">/3, pour lesquels la demande d'indemnité compensatoire doit être introduite avant le 1er juin 2020.</span>\n                    </li>\n                </ol>\n            </blockquote>\n        </div>\n    </div>\n</article>",
