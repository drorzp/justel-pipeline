  "transformedHtml": "<article class=\"legal-article\" id=\"art-13/1\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 13/1</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2024-11-11/08\" data-law-type=\"AR\" data-article-number=\"6\">\n                <p class=\"intro-text\">L'Agence peut accorder une dérogation à la condition de diplôme visée à l'article 13, 5°, dans le respect des modalités prévues à l'article 16, § 2,:</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"1° bis\">\n                        <span class=\"provision-text\">de l'arrêté royal du 2 octobre 1937 relatif au statut du personnel de l'Etat.</span>\n                    </li>\n                </ol>\n                <p class=\"closing-text\">L'appel aux candidats fait mention de chaque dérogation.</p>\n            </span>\n        </div>\n    </div>\n</article>",
