  "transformedHtml": "<article class=\"legal-article\" id=\"art-14\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 14</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 70, § 2, du même arrêté est complété par un alinéa rédigé comme suit :</p>\n      <p class=\"intro-text\">\" L'administrateur général et les directeurs généraux peuvent déléguer à des agents de niveau 1 les compétences visées au § 1er,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">, à des agents titulaires d'un grade de rang 12 au moins, les compétences visées au § 1er,</span></li>\n        <li class=\"provision\" data-number=\"20°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"21°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"23°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"24°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"25°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"26°\"><span class=\"provision-text\">et à un fonctionnaire général de rang 15, les compétences visées au § 1er,</span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"27°\"><span class=\"provision-text\">.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
