  "transformedHtml": "<article class=\"legal-article\" id=\"art-218\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 218</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 4.</h3>\n                <div class=\"paragraph-content\">\n                    <p>Dans l'article D.174, § 4, alinéa 2, du même Livre du Code de l'Environnement, remplacé par le décret du 6 mai 2019, les modifications suivantes sont apportées :</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">les infractions au décret du 9 mars 2023 relatif aux déchets, à la circularité des matières et à la propreté publique;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">et le</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"9°\">\n                            <span class=\"provision-text\">sont abrogés.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
