  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\" id=\"para-1er\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">L'Autorité ne porte pas à la connaissance de l'Institut :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">l'information en provenance de la Commission européenne et des autorités nationales de concurrence échangée dans le cadre du Réseau européen de la concurrence, et</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">l'information obtenue dans le cadre d'une procédure de clémence au sens de l'article IV. 46 du Livre IV du Code de droit économique.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n    <section class=\"paragraph\" id=\"para-2\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">L'Institut ne porte pas à la connaissance de l'Autorité l'information obtenue dans le cadre de l'article 14, § 1er,:</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"4°\">\n            <span class=\"provision-text\">et</span>\n          </li>\n          <li class=\"provision\" data-number=\"4° /1\">\n            <span class=\"provision-text\">de la loi relative au statut de l'Institut.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
