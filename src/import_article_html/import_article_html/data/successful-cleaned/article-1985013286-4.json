  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 4</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Les denrées visées à l'article 1er, 1° et 2° peuvent exclusivement être présentées sous une des formes suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">ronde avec baisures</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">ronde, ovale ou rectangulaire sans baisures</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">allongée mesurant au moins 11 centimètres par 100 grammes et entaillée sur la surface supérieure.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
