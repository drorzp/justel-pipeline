  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 7</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le présent arrêté produit ses effets le 2 janvier 1995, à l'exception de l'article 1-:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">qui produit ses effets le 4 janvier 1993, de l'article 1-</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">qui produit ses effets le 3 janvier 1994 et de l'article 3 qui produit ses effets le 1 janvier 1996.</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">Bruxelles, le 2 mai 1996. K. PINXTEN</p>\n        </div>\n    </div>\n</article>",
