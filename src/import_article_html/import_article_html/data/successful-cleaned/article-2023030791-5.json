  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 5</h2>\n  </header>\n  <div class=\"article-content\">\n    <section class=\"paragraph\" id=\"para-1er\">\n      <h3 class=\"paragraph-marker\">§ 1er.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">Le Ministre est l'ordonnateur primaire pour les services mentionnés à l'article 2, alinéa 1er,</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\"></span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\"></span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"a)\">de la Loi, qui relèvent de son autorité hiérarchique.</li>\n              </ol>\n            </span>\n          </li>\n        </ol>\n      </div>\n    </section>\n    <section class=\"paragraph\" id=\"para-2\">\n      <h3 class=\"paragraph-marker\">§ 2.</h3>\n      <div class=\"paragraph-content\">\n        <p class=\"intro-text\">En ce qui concerne les organismes visés à l'article 2, alinéa 1er,</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"b)\">et</li>\n              </ol>\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"4°\">\n            <span class=\"provision-text\">, l'ordonnateur primaire est l'organe exerçant une compétence équivalente à celle du Ministre visé au § 1er ou le Ministre lui-même.</span>\n          </li>\n        </ol>\n      </div>\n    </section>\n  </div>\n</article>",
