  "transformedHtml": "<article class=\"legal-article\" id=\"art-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">La demande de reconnaissance est adressée au Ministre de la Justice.</p>\n      <p class=\"intro-text\">La demande est accompagnée des pièces établissant que les conditions de l'article 1er, § 1,:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">et § 2,</span>\n        </li>\n      </ol>\n      <p class=\"intro-text\">1°, et:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">sont remplies.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
