  "transformedHtml": "<article class=\"legal-article\" id=\"art-42\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 42</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 22, § 1er, alinéa 2, du même Code, modifié en dernier lieu par la loi du 27 décembre 2012, les mots &quot;conformément à l'article 171,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">f,</span></li>\n        <li class=\"provision\" data-number=\"2° bis\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"3° quater\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3° quinquies\"><span class=\"provision-text\">,&quot; sont remplacés par les mots &quot;conformément à l'article 171,</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2° bis\"><span class=\"provision-text\">,</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3° quater\"><span class=\"provision-text\">à</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"3° septies\"><span class=\"provision-text\">,&quot;.</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
