  "transformedHtml": "<article class=\"legal-article\" id=\"art-31\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 31</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 66 de la loi-programme du 2 janvier 2001, modifié en dernier lieu par la loi du 10 août 2015, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">dans le paragraphe 1er, les alinéas 6, 7, 10 et 12 sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">dans le paragraphe 2, les 2°, 7°, 8°, 11° et 13° sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">le paragraphe 3quinquies est abrogé.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
