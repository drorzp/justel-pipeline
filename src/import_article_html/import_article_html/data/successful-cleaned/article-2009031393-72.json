  "transformedHtml": "<article class=\"legal-article\" id=\"art-72\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 72</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 267 du même arrêté, modifié par l'arrêté du 25 avril 2002 (6ième modification), sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">la numérotation \" 3°, 4°, 5° et 6° \" devient respectivement la numérotation suivante \" 4°, 5°, 6° et 8° \";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">sont insérées les peines disciplinaires suivantes :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"3°\">le déplacement disciplinaire;</li>\n                        <li class=\"sub-provision\" data-marker=\"7°\">la démission d'office;</li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
