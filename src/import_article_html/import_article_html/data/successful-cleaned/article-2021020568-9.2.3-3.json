  "transformedHtml": "<article class=\"legal-article\" id=\"art-9-2-3-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 9.2.3-3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>Lorsqu'il constate une violation de l'article \n                        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"6.1.1-1\" data-law-type=\"L\" data-article-number=\"6.1.1-1\">6.1.1-1</span> \n                        par un éditeur de services télévisuels extérieur, le Collège d'autorisation et de contrôle peut, dans le respect de la procédure visée à l'article \n                        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"9.2.2-3\" data-law-type=\"L\" data-article-number=\"9.2.2-3\">9.2.2-3</span>, \n                        prononcer une des sanctions visées à l'article \n                        <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"9.2.2-1\" data-law-type=\"L\" data-article-number=\"9.2.2-1\">9.2.2-1</span>, \n                        § 1er, \n                        <ol class=\"numbered-provisions\">\n                            <li class=\"provision\" data-number=\"1°\">\n                                <span class=\"provision-text\">1°</span>\n                            </li>\n                            <li class=\"provision\" data-number=\"6°\">\n                                <span class=\"provision-text\">6°</span>\n                            </li>\n                            <li class=\"provision\" data-number=\"7°\">\n                                <span class=\"provision-text\">7°</span>\n                            </li>\n                        </ol>.\n                    </p>\n                </div>\n  