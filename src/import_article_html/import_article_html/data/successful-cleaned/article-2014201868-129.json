  "transformedHtml": "<article class=\"legal-article\" id=\"art-129\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 129</h2>\n    </header>\n    <div class=\"article-content\">\n        <p class=\"intro-text\">Dans l'article 469, § 1er, du même Code, les modifications suivantes sont apportées :</p>\n        <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n                <span class=\"provision-text\">dans les 1° et 3°,</span>\n                <ol class=\"sub-provisions\">\n                    <li class=\"sub-provision\" data-marker=\"a)\">\n                        <span class=\"sub-provision-text\">les \" 30 % \" et \" 70 % \" sont remplacés par les mots \" trente pour cent \" et \" septante pour cent \";</span>\n                    </li>\n                </ol>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n                <span class=\"provision-text\">dans le 2°, les mots \" 60 ans \" sont remplacés par les mots \" soixante ans \";</span>\n            </li>\n            <li class=\"provision\" data-number=\"3°\">\n                <span class=\"provision-text\">dans le 2°, les mots \" 100 habitants \" sont remplacés par les mots \" cent habitants \";</span>\n            </li>\n            <li class=\"provision\" data-number=\"4°\">\n                <span class=\"provision-text\">dans le 3°,</span>\n                <ol class=\"sub-provisions\">\n                    <li class=\"sub-provision\" data-marker=\"d)\">\n                        <span class=\"sub-provision-text\">les mots \" 100 habitants \" sont remplacés par les mots \" cent habitants \".</span>\n                    </li>\n                </ol>\n            </li>\n        </ol>\n    </div>\n</article>",
