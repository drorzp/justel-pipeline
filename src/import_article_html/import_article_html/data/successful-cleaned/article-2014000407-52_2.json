  "transformedHtml": "<article class=\"legal-article\" id=\"art-52/2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 52/2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2019-04-13/13\" data-law-type=\"AR\" data-article-number=\"10\">\n        <p class=\"intro-text\">La première promotion barémique qui suit l'entrée en vigueur du présent arrêté royal, a un effet rétroactif à partir de la date à laquelle le membre du personnel satisfaisait aux conditions prévues aux:</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">1°</span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">des articles 12 à 19, lorsqu'il obtient au moins la mention `satisfaisant' lors de la première évaluation.</span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
