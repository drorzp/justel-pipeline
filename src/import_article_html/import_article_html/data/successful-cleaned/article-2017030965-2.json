  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 3, § 1er, du même arrêté, modifié par les arrêtés du Gouvernement flamand des 6 février 2009, 30 septembre 2011, 4 octobre 2013 et 23 décembre 2016, les modifications suivantes sont apportées:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">dans l'alinéa 1er, les points 4° et 5° sont abrogés</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">dans l'alinéa 2, le membre de phrase \", 4°, 5°\" est abrogé</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
