  "transformedHtml": "<article class=\"legal-article\" id=\"art-124\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 124</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">\n        La présente section entre en vigueur à une date à déterminer par le Roi, par arrêté royal délibéré en Conseil des ministres.\n      </p>\n      <p class=\"intro-text\">\n        (NOTE : Entrée en vigueur des articles 104, \n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">et 108,</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <p class=\"intro-text\">\n        6°, fixée au 26-05-2014 par \n        <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2014042538\">AR[2014-04-25/38]</a>, art. 3)\n      </p>\n      <p class=\"intro-text\">\n        (NOTE : Entrée en vigueur des articles 104 à 123, à l'exception des articles 104, \n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <p class=\"intro-text\">\n        4°, 105, 2°, 106,\n      </p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">et 108,</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">et</span>\n        </li>\n      </ol>\n      <p class=\"closing-text\">\n        6°, 113, 1°, 117, 1°, fixée au 01-11-2018 par \n        <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2018010914\">AR[2018-01-09/14]</a>, art. 15)\n      </p>\n    </div>\n  </div>\