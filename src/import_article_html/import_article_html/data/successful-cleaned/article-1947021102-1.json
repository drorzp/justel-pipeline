  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Article <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-06-28/04\" data-law-type=\"L\" data-article-number=\"3\">unique</span>.</p>\n      <p class=\"intro-text\">Les renseignements qui, en vertu des:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">1°</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">2°</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">3°</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">de l'article 3 du Règlement général pour la protection du travail, doivent être fournis à l'appui des demandes en autorisation d'établissements classés comme dangereux, insalubres ou incommodes sont complétés et coordonnés conformément aux indications du formulaire annexé au présent arrêté.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
