  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article XIV 12 du même statut, modifié par les arrêtés du Gouvernement flamand des 28 avril 1998 et 19 décembre 1998, les mots l'article XIV 5, § 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n                <li class=\"provision\" data-number=\"14°\"><span class=\"provision-text\">compris,</span></li>\n                <li class=\"provision\" data-number=\"21°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">&quot;</span></li>\n            </ol>\n            <p> sont remplacés par les mots &quot; l'article XIV 5, § 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à 14 compris,</span></li>\n                <li class=\"provision\" data-number=\"21°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"22°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"24°\"><span class=\"provision-text\">&quot;.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
