  "transformedHtml": "<article class=\"legal-article\" id=\"art-16\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 16</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <div class=\"paragraph-content\">\n                    <p>Pour les projets d'infrastructure visés à l'article 2, alinéa 1er, 1° à 5° et <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2022-11-21/08\" data-law-type=\"DCG\" data-article-number=\"234\">7° à 11°</span>, le subside représente 60 % du montant total des dépenses pouvant être pris en considération pour une subsidiation.</p>\n                    <p>Pour le projet d'infrastructure visé à l'article 2, alinéa 1er, 6°, le subside représente 50 % du montant total des dépenses pouvant être pris en considération pour une subsidiation.</p>\n                    <p>Le cas échéant, le subside est limité aux plafonds en vigueur.</p>\n                </div>\n            </section>\n        </div>\n    </div>\n    <footer class=\"article-footer\">\n        <ul class=\"footnotes\">\n            <li class=\"footnote\" data-footnote-id=\"1\" data-dossier-number=\"2014-02-24/14\" data-law-type=\"DCG\" data-article-number=\"32\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2014022414\">DCG 2014-02-24/14, art. 32, 016; En vigueur : 01-01-2020</a>\n            </li>\n            <li class=\"footnote\" data-footnote-id=\"2\" data-dossier-number=\"2022-11-21/08\" data-law-type=\"DCG\" data-article-number=\"234\">\n                <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2022112108\">DCG 2022-11-21/08, art. 234, 024; En vigueur : 01-02-2023</a>\n            </li>\n        </ul>\n    </footer>\n</article>",
