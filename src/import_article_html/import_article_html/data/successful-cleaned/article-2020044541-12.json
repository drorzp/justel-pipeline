  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 12</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les articles 8,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1°</span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">3°</span></li>\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5°</span></li>\n        <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n      </ol>\n      <p class=\"intro-text\">et 9 entrent en vigueur le jour de la publication de la présente loi au Moniteur belge et sont applicables à partir de l'exercice d'imposition 2021.</p>\n      <p class=\"intro-text\">Les articles 8,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">4°</span></li>\n        <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">9°</span></li>\n      </ol>\n      <p class=\"closing-text\">et 10 entrent en vigueur le jour de la publication de la présente loi au Moniteur belge et sont applicables aux dépenses pour garde d'enfant faites à partir du 1er janvier 2021.</p>\n      <p class=\"intro-text\">Les articles 7, 8,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">2°</span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">7°</span></li>\n        <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">10°</span></li>\n      </ol>\n      <p class=\"closing-text\">et 11 sont applicables à partir de l'exercice d'imposition 2022.</p>\n    </div>\n  </div>\n</article>",
