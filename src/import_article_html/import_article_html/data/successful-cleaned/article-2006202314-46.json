  "transformedHtml": "<article class=\"legal-article\" id=\"art-46\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 46</h2>\n    </header>\n    <div class=\"article-content\">\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 1er.</h3>\n            <div class=\"paragraph-content\">\n                <p>L'article 42 est applicable aux commissions, courtages, ristournes commerciales ou autres, vacations ou honoraires occasionnels ou non, gratifications, rétributions ou avantages de toute nature, payés ou attribués à partir du 1er janvier 2006.</p>\n            </div>\n        </section>\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 2.</h3>\n            <div class=\"paragraph-content\">\n                <p>L'article 43,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"3°\">\n                        <span class=\"provision-text\">est applicable à partir de l'exercice d'imposition 2006.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 3.</h3>\n            <div class=\"paragraph-content\">\n                <p>Les articles 43,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"2°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"44\">\n                        <span class=\"provision-text\">sont applicables aux indemnités payées ou attribuées à partir de 1er janvier 2006.</span>\n                    </li>\n                </ol>\n            </div>\n        </section>\n        <section class=\"paragraph\">\n            <h3 class=\"paragraph-marker\">§ 4.</h3>\n            <div class=\"paragraph-content\">\n                <p>L'article 45 est applicable aux capitaux liquidés à partir du 1er janvier 2006.</p>\n            </div>\n        </section>\n    </div>\n</article>",
