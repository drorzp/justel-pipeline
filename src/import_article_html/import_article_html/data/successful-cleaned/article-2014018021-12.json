  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 12</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Il ne peut être procédé par le producteur à l'approvisionnement direct <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2023-12-25/25\" data-law-type=\"AR\" data-article-number=\"8\">en produits</span> issus de sa propre production que:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au consommateur final sur le site de production ou au commerce de détail local, en ce qui concerne <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2023-12-25/25\" data-law-type=\"AR\" data-article-number=\"8\">les produits, visés à l'article 11, 1°</span>;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2024-04-14/04\" data-law-type=\"AR\" data-article-number=\"2\">du navire après l'accostage ou du quai vers le consommateur final ou le commerce de détail local, en ce qui concerne les produits, visés à l'article 11, 2° et 3°.</span></span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
