  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 12</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">\n                <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2018-05-08/22\" data-law-type=\"AR\" data-article-number=\"13\">L'autorité responsable de la délivrance des licences</span>\n                procède tous les cinq ans au réexamen de la licence.\n            </p>\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2015-09-11/05\" data-law-type=\"AR\" data-article-number=\"9\">\n                <p class=\"intro-text\">\n                    A cette fin, nonante jours avant l'échéance des cinq années mentionnées à l'alinéa 1er, le titulaire de la licence soumet \n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2018-05-08/22\" data-law-type=\"AR\" data-article-number=\"13\">à l'autorité responsable de la délivrance des licences</span>\n                    les documents visés à l'article 4, § 2, 1°, en vue d'un réexamen complet et, s'ils ont subi des modifications, les documents visés à l'article 4, § 2, 2° et 3°.\n                </p>\n                <p class=\"closing-text\">\n                    <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2018-05-08/22\" data-law-type=\"AR\" data-article-number=\"13\">L'autorité responsable de la délivrance des licences</span>\n                    peut demander toute information complémentaire qu'il juge utile.\n                </p>\n            </span>\n        </div>\n    </div>\n</article>",
