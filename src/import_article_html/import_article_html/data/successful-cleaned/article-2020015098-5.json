  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le congé de protection parentale corona peut être exercé à partir du 1er juillet 2020 jusqu'au 30 septembre 2020 inclus, comme suit :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">soit durant une période ininterrompue ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">soit durant une ou plusieurs périodes d'un mois, consécutives ou non ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">soit durant une ou plusieurs périodes d'une semaine, consécutives ou non ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">soit une combinaison des 2° et 3°.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
