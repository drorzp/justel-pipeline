  "transformedHtml": "<article class=\"legal-article\" id=\"art-70\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 70</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Un article 9bis, rédigé comme suit, est inséré dans la même loi :</p>\n            <blockquote class=\"article-quote\">\n                <p class=\"quote-text\">\" Art. 9bis . L'officier auxiliaire est démis d'office de son emploi sans l'intervention d'un conseil d'enquête s'il est condamné sans sursis à l'interdiction, même temporaire, d'un des droits visés à l'article 31,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\">\n                        <span class=\"provision-text\">et</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"6°\">\n                        <span class=\"provision-text\">du Code pénal.</span>\n                    </li>\n                </ol>\n            </blockquote>\n        </div>\n    </div>\n</article>",
