  "transformedHtml": "<article class=\"legal-article\" id=\"art-12\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 12</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'approbation par le Ministre du Budget et des Comptes de la Section Ière, auxquels sont joints les budgets des sections II, III, VI et les comptes des sections II à VI, implique l'approbation des transferts ainsi que des produits et des charges visés à l'article 5,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">,</span></li>\n            </ol>\n            <p class=\"intro-text\">et à l'article 6, § 1er,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\"></span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
