  "transformedHtml": "<article class=\"legal-article\" id=\"art-R12\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article R12</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Loi du 9 août 1963, article 8, remplacé par la loi du 15 février 1993, article 7, les mots &quot;par la présente loi&quot; sont remplaces par les mots &quot;par ou en vertu de la présente loi coordonnée&quot;; les mots &quot;l'Administrateur général peut introduire l'action en justice&quot; sont remplaces par les mots &quot;l'Administrateur général peut décider l'action en justice&quot;; les références &quot;l'article 93&quot; et &quot;l'article 121, 1°,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">à</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">à</span></li>\n                <li class=\"provision\" data-number=\"18°\"><span class=\"provision-text\">sont remplacées par les références &quot;l'article 161&quot; et &quot;l'article 191, alinéa 1er,</span></li>\n            </ol>\n            <p class=\"intro-text\">1°,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">à</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"11°\"><span class=\"provision-text\">à</span></li>\n            </ol>\n            <p class=\"closing-text\">9° et 11° à 20°&quot;.</p>\n        </div>\n    </div>\n</article>",
