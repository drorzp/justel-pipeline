  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2000-03-24/50\" data-law-type=\"L\" data-article-number=\"4\">1</span>.</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 3, § 1er, de l'arrêté royal du 17 janvier 1995 relatif au recrutement de personnel statutaire dans certains services publics, remplacé par l'arrêté royal du 19 juin 1998 et modifié par l'arrêté royal du 16 juin 1999, sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au point 1°, les mots \" (sans préjudice des points 2° et 3° suivants\" sont supprimés;</span>\n                    <span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"Erratum\" data-law-type=\"voir\" data-article-number=\"M.B.\">Erratum, voir M.B. 30.11.2000, Ed. 2, p. 40.241</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">le point 2° est supprimé.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
