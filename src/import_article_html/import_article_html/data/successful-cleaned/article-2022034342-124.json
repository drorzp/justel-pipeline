  "transformedHtml": "<article class=\"legal-article\" id=\"art-124\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 124</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les articles 77 et 78 entrent en vigueur le 1er janvier 2023.</p>\n      <p class=\"intro-text\">L'article 30 entre en vigueur le 1er septembre 2023.</p>\n      <p class=\"intro-text\">Les articles 12, 43, a), 48, 2° et 3°, 53 à 76 et 81 à 110 entrent en vigueur le 1er janvier 2024.</p>\n      <p class=\"intro-text\">Le Roi peut fixer une date d'entrée en vigueur antérieure à celle mentionnée à l'alinéa 3.</p>\n      <p class=\"note-text\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2023-06-07/04\" data-law-type=\"AR\" data-article-number=\"2\">\n          NOTE : Entrée en vigueur de l'article 12 fixée au 26-06-2023 par AR\n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2023060704\">2023-06-07/04</a>, art. 2\n        </span>\n      </p>\n      <p class=\"note-text\">\n        <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2023-10-12/04\" data-law-type=\"AR\" data-article-number=\"2\">\n          NOTE : Entrée en vigueur de l'article 61 fixée au 18-10-2023 par AR\n          <a href=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2023101204\">2023-10-12/04</a>, art. 2\n        </span>\n      </p>\n    </div>\n  </div>\n</article>",
