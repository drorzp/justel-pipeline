  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 28</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Le Ministre retire le label de diversité octroyé lorsque :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">il a été octroyé sur base de déclarations fausses, incomplètes ou inexactes;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">l'entreprise, organisation ou institution se trouve dans une des circonstances visées aux articles 5, 1° à 5° et 13, 1° et 3°;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">l'entreprise, organisation ou institution <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2016-06-09/15\" data-law-type=\"ARR\" data-article-number=\"40\">empêche le contrôle</span>.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
