  "transformedHtml": "<article class=\"legal-article\" id=\"art-13\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 13</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Les articles 78 et 79 du même arrêté sont remplacés par ce qui suit :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">Art. 78.</h3>\n                <div class=\"paragraph-content\">\n                    <p>En application de l'article 138 du décret, les frais de fonctionnement, de promotion, de formation ou de personnel supplémentaire au cadre minimum visé à l'article 63 du décret et qui sont liées aux missions visées à l'article 31, § 1er,</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">1° et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">2° ainsi que § 2,</span>\n                        </li>\n                    </ol>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">1° et</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">2° du décret s'élèvent à 132.760 euros.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
