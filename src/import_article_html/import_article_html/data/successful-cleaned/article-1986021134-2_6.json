  "transformedHtml": "<article class=\"legal-article\" id=\"art-2/6\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2/6</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n          <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2012-12-13/13\" data-law-type=\"L\" data-article-number=\"11\">\n            Le versement de la cotisation personnelle visée aux articles 2, § 3, alinéa 2, 2/2, § 2, \n            <ol class=\"numbered-provisions\">\n              <li class=\"provision\" data-number=\"2°\">\n                <span class=\"provision-text\">et 2/4,</span>\n              </li>\n            </ol>\n            n'est pas requis durant vingt-quatre mois au maximum pour l'ensemble de la carrière, pour les périodes pendant lesquelles l'agent ou son conjoint habitant sous le même toit a perçu des allocations familiales pour un enfant de moins de 6 ans.\n          </span>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
