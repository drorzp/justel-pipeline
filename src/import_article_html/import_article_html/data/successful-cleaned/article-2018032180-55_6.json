  "transformedHtml": "<article class=\"legal-article\" id=\"art-55/6\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 55/6</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2019-05-17/71\" data-law-type=\"AGF\" data-article-number=\"4\" data-direct-article-url=\"https://www.ejustice.just.fgov.be/cgi_loi/article.pl?language=fr&lg_txt=f&cn_search=2019051771\" data-referenced-text=\"Pour chaque enseignant, les données suivantes sont collectées : 1° le numéro du registre national ; 2° le nom et les prénoms ; 3° l'adresse ; 4° l'adresse e-mail ; 5° une copie du permis de conduire ; 6° les documents prouvant que les conditions visées à l'article 39, 1°, 2° et 3° et à l'article 40, sont remplies ou les documents prouvant que les conditions visées à l'article 39, 1°, 2° et 3° et à l'article 41, sont remplies ; 7° une preuve de l'agrément tel que visé à l'article 42, alinéa 9.\">\n        <p class=\"intro-text\">Pour chaque enseignant, les données suivantes sont collectées :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">le numéro du registre national ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"2°\">\n            <span class=\"provision-text\">le nom et les prénoms ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"3°\">\n            <span class=\"provision-text\">l'adresse ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"4°\">\n            <span class=\"provision-text\">l'adresse e-mail ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">une copie du permis de conduire ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"6°\">\n            <span class=\"provision-text\">les documents prouvant que les conditions visées à l'article 39, 1°, 2° et 3° et à l'article 40, sont remplies ou les documents prouvant que les conditions visées à l'article 39, 1°, 2° et 3° et à l'article 41, sont remplies ;</span>\n          </li>\n          <li class=\"provision\" data-number=\"7°\">\n            <span class=\"provision-text\">une preuve de l'agrément tel que visé à l'article 42, alinéa 9.</span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
