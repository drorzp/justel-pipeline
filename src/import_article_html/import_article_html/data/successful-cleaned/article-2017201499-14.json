  "transformedHtml": "<article class=\"legal-article\" id=\"art-14\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 14</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 13, alinéa 2, du même arrêté est remplacé par ce qui suit : &quot; L'aide n'est pas accessible sur les surfaces pouvant bénéficier de l'indemnité Natura 2000 prévue par l'arrêté du Gouvernement wallon du 14 juillet 2016 pour les unités de gestion &quot; milieux ouverts prioritaires &quot;, &quot; prairies habitats d'espèces &quot;, &quot; bandes extensives &quot;, &quot; zones sous statut de protection &quot; et &quot; zones à gestion publiques &quot;, visées à l'article 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\"></span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\"></span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\"></span>\n                </li>\n                <li class=\"provision\" data-number=\"14°\">\n                    <span class=\"provision-text\"></span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">15°, de l'arrêté du Gouvernement wallon 19 mai 2011.</p>\n        </div>\n    </div>\n</article>",
