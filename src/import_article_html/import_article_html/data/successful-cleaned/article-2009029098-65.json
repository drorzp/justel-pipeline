  "transformedHtml": "<article class=\"legal-article\" id=\"art-65\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 65</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 88 du même décret est complété par l'alinéa suivant :</p>\n            <p class=\"intro-text\">\" Nul n'est admis à la formation visée à l'alinéa 1er,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"6°\">\n                    <span class=\"provision-text\">s'il ne remplit, à la date d'introduction de la demande de participation, les conditions énoncées à l'alinéa 1er,</span>\n                </li>\n            </ol>\n            <p class=\"intro-text\">1°, 2°,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">et 5°.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
