  "transformedHtml": "<article class=\"legal-article\" id=\"art-20\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 20</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Les infractions visées à l'article 6.2.2,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">,</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">, du Code flamand de l'aménagement du territoire sont exclues comme base de l'application d'une contrainte administrative ou d'une charge sous astreinte.</span></li>\n            </ol>\n            <p class=\"intro-text\">Le même principe s'applique vis-à-vis du propriétaire visé à l'article 6.2.2,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">, du code précité, lorsqu'il s'agit des infractions visées aux points</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">et</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">de l'article précité.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
