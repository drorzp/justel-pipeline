  "transformedHtml": "<article class=\"legal-article\" id=\"art-21\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 21</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 48, § 3, les modifications suivantes sont apportées :</p>\n            <ol class=\"sub-provisions\">\n                <li class=\"sub-provision\" data-marker=\"a)\">\n                    <span class=\"sub-provision-text\">A l'alinéa 1er, les mots \" Les prestations réduites pour raisons médicales \" sont remplacés par les mots \" Les prestations réduites pour raisons médicales, visées à l' article 46, 2°\";</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"b)\">\n                    <span class=\"sub-provision-text\">l'alinéa 1er, est complété par les 8° et 9° rédigés comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"8°\">\n                            <span class=\"provision-text\">la semaine de quatre jours avec ou sans prime;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"9°\">\n                            <span class=\"provision-text\">le travail à mi-temps à partir de 50 ou 55 ans.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
