  "transformedHtml": "<article class=\"legal-article\" id=\"art-1er\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1er</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A L'article 2 § 1 de l'arrêté royal du 23 mai 2001 portant création du Service public fédéral Justice, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">Dans le point 4° dans le texte néerlandais le mot \" strafinrichtingen \" est remplacé par les mots \" penitentiaire inrichtingen \";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">Les points 5° et 6° sont abrogés.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
