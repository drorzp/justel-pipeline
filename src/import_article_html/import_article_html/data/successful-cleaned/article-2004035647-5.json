  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 5 du même décret sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">le 2° est remplacé par la disposition suivante :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">le contenu et la fréquence de l'examen médico-sportif et de l'examen de santé préventif;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">il est ajouté un 5° et un 6°, rédigés comme suit :</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"5°\">\n                            <span class=\"provision-text\">conditions minimales de la formation des sportifs en vue de sa participation aux manifestations sportives;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"6°\">\n                            <span class=\"provision-text\">conditions minimales de l'examen de santé préventif des sportifs en vue de leur participation aux manifestations sportives.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
