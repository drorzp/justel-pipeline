  "transformedHtml": "<article class=\"legal-article\" id=\"art-190\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 190</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 2, § 1er, de la loi du 20 juillet 2001 visant à favoriser le développement de services et d'emplois de proximité, modifié par les lois du 22 décembre 2003 et 9 juillet 2004, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">dans le premier alinéa, les 7° et 8° sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">les alinéas 2 et 3 sont abrogés.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
