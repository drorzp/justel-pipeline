  "transformedHtml": "<article class=\"legal-article\" id=\"art-174\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 174</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 61, § 2, de la même loi est complété comme suit :</p>\n            <blockquote class=\"quoted-text\">\n                <p class=\"intro-text\">\"ou à l'article 2, §§ 3,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">5°</span></li>\n                    <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">et</span></li>\n                </ol>\n                <p class=\"intro-text\">et 3bis de l'arrêté-loi précité du 10 janvier 1945, à l'article 56,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">et</span></li>\n                    <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">des lois relatives à la réparation des dommages résultant des maladies professionnelles, coordonnées le 3 juin 1970</span></li>\n                </ol>\n                <p class=\"closing-text\">et à l'article 59, 1°, de la loi du 10 avril 1971 sur les accidents du travail.\"</p>\n            </blockquote>\n        </div>\n    </div>\n</article>",
