  "transformedHtml": "<article class=\"legal-article\" id=\"art-10\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 10</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans le même arrêté, il est inséré un article 52/2, rédigé comme suit :</p>\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">Art. 52/2.</h3>\n                <div class=\"paragraph-content\">\n                    <p>La première promotion barémique qui suit l'entrée en vigueur du présent arrêté royal, a un effet rétroactif à partir de la date à laquelle le membre du personnel satisfaisait aux conditions prévues aux</p>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">1°</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">3° des articles 12 à 19, lorsqu'il obtient au moins la mention <code>satisfaisant</code> lors de la première évaluation.</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
