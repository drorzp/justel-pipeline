  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 6</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <h3 class=\"paragraph-marker\">§ 1er.</h3>\n                <div class=\"paragraph-content\">\n                    <p>A l'article 107 du même Code, insérer les mots <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-06-28/04\" data-law-type=\"L\" data-article-number=\"107\">\"et le directeur général adjoint\"</span> après les mots \"le directeur général\".</p>\n                    <p>Aux points <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"1°\">\n                            <span class=\"provision-text\">remplacer le mot \"exécute\" par le mot \"exécutent\"</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"2°\">\n                            <span class=\"provision-text\">remplacer le mot \"assure\" par le mot \"assurent\"</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"3°\">\n                            <span class=\"provision-text\">remplacer le mot \"exerce\" par le mot \"exercent\"</span>\n                        </li>\n                    </ol> du même article.</p>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
