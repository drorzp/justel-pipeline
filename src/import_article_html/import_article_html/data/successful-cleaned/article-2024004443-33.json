  "transformedHtml": "<article class=\"legal-article\" id=\"art-33\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 33</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Par dérogation à l'article 8, l'octroi des bourses de résidence visées à l'article 30,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">et</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">ne fait pas l'objet d'un avis préalable de la Commission.</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\">Pour ces bourses, les demandes recevables sont traitées dans l'ordre de leur arrivée, jusqu'à épuisement des crédits affectés.</p>\n        </div>\n    </div>\n</article>",
