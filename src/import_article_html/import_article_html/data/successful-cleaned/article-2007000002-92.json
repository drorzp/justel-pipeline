  "transformedHtml": "<article class=\"legal-article\" id=\"art-92\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 92</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Après réception complète des données, (visées respectivement aux articles 89,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">et 90), l'administration délivre à l'expéditeur un numéro d'attestation, pour chaque candidat ayant réussi. Aucune attestation ne peut être délivrée sans mention de ce numéro d'attestation.</span>\n                </li>\n            </ol>\n            <p class=\"closing-text\"><span class=\"legal-citation legal-citation-standard\" data-dossier-number=\"23-02-2007\" data-law-type=\"M.B.\">&lt;Erratum, voir M.B. 23-02-2007, p. 8822&gt;</span></p>\n        </div>\n    </div>\n</article>",
