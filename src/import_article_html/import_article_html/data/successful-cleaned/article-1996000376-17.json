  "transformedHtml": "<article class=\"legal-article\" id=\"art-17\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 17</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 19 de la même loi, modifié par la loi du 6 mai 1993, sont apportées les modifications suivantes :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">à l'alinéa 3 du texte néerlandais, le mot \" toegelaten \" est remplacé par le mot \" gemachtigd \";</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">à l'alinéa 4, les mots \" article 3, 2°, 3° et 4° \" sont remplacés par les mots \" article 3, alinéa 1er, 5° à 8° \".</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
