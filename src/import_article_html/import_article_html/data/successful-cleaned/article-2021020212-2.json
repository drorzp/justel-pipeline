  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <section class=\"paragraph\">\n        <h3 class=\"paragraph-marker\">§ 1er.</h3>\n        <div class=\"paragraph-content\">\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"1°\">\n              <span class=\"provision-text\">Au paragraphe 2, alinéa 1er, les points 1° et 2° sont remplacés par ce qui suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"1°\">\n                  <span class=\"provision-text\">Un m-ticket : 2 euros ;</span>\n                </li>\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">Un ticket ou un ticket SMS : 2,5 euros ;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"2°\">\n              <span class=\"provision-text\">Au paragraphe 2, alinéa 1er, le point 3° est abrogé ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"3°\">\n              <span class=\"provision-text\">Au paragraphe 2, alinéa 1er, le point 4° est remplacé par ce qui suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"4°\">\n                  <span class=\"provision-text\">Une m-card10 : 16 euros ou 1,60 euros par voyage ;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"4°\">\n              <span class=\"provision-text\">Au paragraphe 2, l'alinéa 4 est abrogé ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"5°\">\n              <span class=\"provision-text\">Au paragraphe 3, 1°, a), le montant \"55 euros\" est remplacé par le montant \"56 euros\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"6°\">\n              <span class=\"provision-text\">Au paragraphe 3, 1°, b), 3), le montant \"55 euros\" est remplacé par le montant \"56 euros\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"7°\">\n              <span class=\"provision-text\">Au paragraphe 3, 2°, a), le montant \"329 euros\" est remplacé par le montant \"339 euros\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"8°\">\n              <span class=\"provision-text\">Au paragraphe 3, 2°, b), le montant \"128 euros\" est remplacé par le montant \"132 euros\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"9°\">\n              <span class=\"provision-text\">Au paragraphe 3, 2°, d), le montant \"55 euros\" est remplacé par le montant \"56 euros\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"10°\">\n              <span class=\"provision-text\">Au paragraphe 3, 3°, le tableau est remplacé par ce qui suit :</span>\n              <div class=\"missing-table-placeholder\">\n                <table border=\"1\" class=\"legal-table\">\n                  <tr>\n                    <td valign=\"top\"> </td>\n                    <td valign=\"top\">Buzzy Pazz<br />12 - 24 ans</td>\n                    <td valign=\"top\">Omnipas<br />25 - 64 ans</td>\n                  </tr>\n                  <tr>\n                    <td valign=\"top\">un mois</td>\n                    <td valign=\"top\">29 euros</td>\n                    <td valign=\"top\">45 euros</td>\n                  </tr>\n                  <tr>\n                    <td valign=\"top\">trois mois</td>\n                    <td valign=\"top\">67 euros</td>\n                    <td valign=\"top\">118 euros</td>\n                  </tr>\n                  <tr>\n                    <td valign=\"top\">douze mois</td>\n                    <td valign=\"top\">175 euros</td>\n                    <td valign=\"top\">299 euros</td>\n                  </tr>\n                </table>\n              </div>\n            </li>\n            <li class=\"provision\" data-number=\"11°\">\n              <span class=\"provision-text\">Au paragraphe 4, le mot \"Snellijnbiljet\" est remplacé par les mots \"SMS-Snellijnbiljet\" ;</span>\n            </li>\n            <li class=\"provision\" data-number=\"12°\">\n              <span class=\"provision-text\">Au paragraphe 4, le point 2° est remplacé par ce qui suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">SMS-snellijnbiljet \"courtes distances\" : 2,50 euros ;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"13°\">\n              <span class=\"provision-text\">Dans le paragraphe 4, il est inséré un point 2° /1, rédigé comme suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"2° /1\">\n                  <span class=\"provision-text\">SMS-snellijnbiljet \"longues distances\" : 7,50 euros ;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"14°\">\n              <span class=\"provision-text\">Au paragraphe 4, le point 5° est remplacé par ce qui suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"5°\">\n                  <span class=\"provision-text\">Snellijnkaarten \"pour les distances plus courtes : le prix est calculé sur la base de la distance conformément aux tarifs visés aux points 3° et 4°\" ;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"provision\" data-number=\"15°\">\n              <span class=\"provision-text\">Le paragraphe 4 est complété par un alinéa 2, rédigé comme suit :</span>\n              <p>Pour chaque demande d'un titre de transport SMS, 0,15 euros de frais d'opérateur seront facturés au client.</p>\n            </li>\n          </ol>\n        </div>\n      </section>\n    </div>\n  </div>\n</article>",
