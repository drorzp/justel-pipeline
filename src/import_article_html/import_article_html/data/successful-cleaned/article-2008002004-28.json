  "transformedHtml": "<article class=\"legal-article\" id=\"art-28\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 28</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'annexe Ire du même arrêté, secteur IV, Affaires économiques, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à la rubrique B., le 4°, le 9° et le 10° sont abrogés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">à la rubrique B., 13°, les mots \"et les Chambres des Métiers et Négoces \" sont supprimés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">la rubrique B. est complétée comme suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"16°\">\n              <span class=\"provision-text\">Le Bureau de Normalisation.</span>\n            </li>\n            <li class=\"provision\" data-number=\"17°\">\n              <span class=\"provision-text\">APETRA.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
