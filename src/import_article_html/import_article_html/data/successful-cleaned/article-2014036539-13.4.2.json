  "transformedHtml": "<article class=\"legal-article\" id=\"art-13-4-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 13.4.2</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 12.2.1, 3°, du décret relatif au patrimoine immobilier du 12 juillet 2013 entre en vigueur le 1er janvier 2015 à l'exception de l'article 1er, de l'article 3, 1°, 2°, 3°,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">inclus,</span></li>\n        <li class=\"provision\" data-number=\"10°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">à</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">inclus,</span></li>\n        <li class=\"provision\" data-number=\"13°\"><span class=\"provision-text\">et</span></li>\n      </ol>\n      <p class=\"closing-text\">14°, de l'article 36 et de l'article 37 du décret du 30 juin 1993 portant protection du patrimoine archéologique.</p>\n    </div>\n  </div>\n</article>",
