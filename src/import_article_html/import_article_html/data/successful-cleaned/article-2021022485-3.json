  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 3</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 4 du même arrêté, remplacé par l'arrêté royal du 21 mai 2013, est remplacé par ce qui suit:</p>\n            <p class=\"intro-text\">\" Art. 4. Les membres visés à l'article 3,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"c)\">\n                            <span class=\"provision-text\">et leurs suppléants sont proposés par le Ministre ayant l'Environnement dans ses attributions.</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">et son suppléant sont proposés par l'administrateur délégué de l'AFSCA.</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">et son suppléant sont proposés par le Ministre qui a le Budget dans ses attributions..</span>\n                </li>\n                <li class=\"provision\" data-number=\"4°\">\n                    <span class=\"provision-text\">à</span>\n                </li>\n                <li class=\"provision\" data-number=\"10°\">\n                    <span class=\"provision-text\">et leurs suppléants sont proposés par les associations professionnelles concernées.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
