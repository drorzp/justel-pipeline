  "transformedHtml": "<article class=\"legal-article\" id=\"art-II-1-8\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article II.1-8</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Chez les employeurs des groupes A et B, les missions et les tâches suivantes sont toujours remplies par le service interne :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les missions visées à l'article II.1-4, alinéa 1er et alinéa 2, 1°, 5°, 7°, 8°, 9°, 10°, 11°, 12°, 13°, 14°, 15° et 16° ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">les tâches visées à l'article II.1-6, § 1er, 1°,</span>\n          <ol class=\"sub-provisions\">\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"sub-provision-text\">a)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"sub-provision-text\">b)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"c)\">\n              <span class=\"sub-provision-text\">c)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"e)\">\n              <span class=\"sub-provision-text\">e)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"f)\">\n              <span class=\"sub-provision-text\">f)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"g)\">\n              <span class=\"sub-provision-text\">g)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"h)\">\n              <span class=\"sub-provision-text\">h)</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"i)\">\n              <span class=\"sub-provision-text\">i)</span>\n            </li>\n          </ol>\n          <span class=\"provision-text\">, 2°, 3°, 4° et 5° ;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">les missions et les tâches visées à l'article II.1-11, s'il est fait appel à un service externe.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
