  "transformedHtml": "<article class=\"legal-article\" id=\"art-23\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 23</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Dans l'article 58 du même arrêté sont apportées les modifications suivantes:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au § 2, alinéa 1er, </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"1°\"><span class=\"provision-text\">et </span></li>\n                        <li class=\"sub-provision\" data-marker=\"2°\"><span class=\"provision-text\">, les mots \" avis indicatif \" sont remplacés par les mots \" avis de pré-information \";</span></li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">au § 4, alinéa 2, </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"4°\"><span class=\"provision-text\">, les mots \" à l'annexe 4, C, 13°, ou 4, D, 12° \" sont remplacés par les mots \" au modèle d'avis figurant à l'annexe 2, B, III, 2 et 3 \".</span></li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
