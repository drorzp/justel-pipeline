  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 2</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <section class=\"paragraph\">\n                <div class=\"paragraph-content\">\n                    A l'article 66, § 1er, du même arrêté les modifications suivantes sont apportées :\n                    <ol class=\"sub-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"a)\">\n                            <span class=\"provision-text\">la disposition suivante est ajoutée aux 1° et 2° : \"Les porteurs d'un diplôme délivré par une école de bibliothécaires sont dispensés de l'obtention d'un certificat d'aptitude.\";</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"b)\">\n                            <span class=\"provision-text\">aux 3°, 4°, 5° et 6°, les mots suivants sont supprimés : \"et un certificat d'aptitude à gérer une bibliothèque publique\".</span>\n                        </li>\n                    </ol>\n                </div>\n            </section>\n        </div>\n    </div>\n</article>",
