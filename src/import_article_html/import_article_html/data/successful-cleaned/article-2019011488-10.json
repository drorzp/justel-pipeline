  "transformedHtml": "<article class=\"legal-article\" id=\"art-10\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 10</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 29, alinéa 4 du même arrêté, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">est remplacé par ce qui suit :</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"provision-text\">Le 2° est remplacé par ce qui suit :</span>\n              <ol>\n                <li class=\"sub-provision\" data-marker=\"2°\">\n                  <span class=\"provision-text\">La catégorie de bureau d'accueil et le nombre de dossiers individuels pour le traitement annuel desquels l'agrément sera délivré</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"provision-text\">L'énumération reprise au 4° est remplacée par les lettres a, b, c, d, e, en lieu et place des 1°, 2°, 2°, 3° et 4°.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
