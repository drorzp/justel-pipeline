  "transformedHtml": "<article class=\"legal-article\" id=\"art-35\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 35</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p>A la fin de la formation de promotion CDP, les élèves présentent un examen <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2017-10-09/07\" data-law-type=\"AR\" data-article-number=\"25\"></span>. Cet examen comprend :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">une épreuve écrite intégrée relative aux volets de formation visés à l'article 29, alinéa 1er, 1° et 2°;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">une épreuve orale <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2017-10-09/07\" data-law-type=\"AR\" data-article-number=\"25\">présentée devant le jury,</span> comprenant :</span>\n                    <ol class=\"sub-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"a)\">\n                            <span class=\"provision-text\">la défense de l'épreuve écrite intégrée, visée au 1°;</span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"b)\">\n                            <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2017-10-09/07\" data-law-type=\"AR\" data-article-number=\"25\">des questions complémentaires portant sur la matière reprise dans le programme de formation, sur le rapport d'activités et le rapport de stage ainsi que sur le déroulement du stage.</span></span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n            <p><span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-07-18/14\" data-law-type=\"AR\" data-article-number=\"5\">L'examen comporte deux sessions. La participation à la première session est obligatoire.</span></p>\n        </div>\n    </div>\n</article>",
