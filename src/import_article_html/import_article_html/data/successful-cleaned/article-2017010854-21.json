  "transformedHtml": "<article class=\"legal-article\" id=\"art-21\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 21</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 11 de la même loi, les modifications suivantes sont apportées :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">dans l'alinéa 1er le chiffre \"14\" est abrogé;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">l'article est complété par les 15° et 16°, rédigés comme suit:</span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"provision\" data-number=\"15°\">\n                            <span class=\"provision-text\">la garantie financière pour le rapatriement;</span>\n                        </li>\n                        <li class=\"provision\" data-number=\"16°\">\n                            <span class=\"provision-text\">la garantie financière relative à la responsabilité de l'armateur.</span>\n                        </li>\n                    </ol>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
