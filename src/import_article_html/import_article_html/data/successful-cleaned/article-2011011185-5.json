  "transformedHtml": "<article class=\"legal-article\" id=\"art-5\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 5</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 5 du même arrêté, remplacé par l'arrêté royal du 24 septembre 2006, est remplacé par ce qui suit :</p>\n            <p class=\"intro-text\">\" Art. 5. Les intérêts de retard sont calculés d'après la même méthode que celle conforme à l'article 14, §§ 2,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"8°\">\n                    <span class=\"provision-text\">et 3,</span>\n                </li>\n            </ol>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"7°\">\n                    <span class=\"provision-text\">de la loi, contractuellement prévue pour le calcul des intérêts débiteurs. \"</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
