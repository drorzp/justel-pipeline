  "transformedHtml": "<article class=\"legal-article\" id=\"art-24\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 24</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A la même annexe, secteur XII, Affaires sociales, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">la rubrique B. est supprimée;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">à la rubrique C., le</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">3°, le</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"9°\">\n              <span class=\"provision-text\">9° et le</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"23°\">\n              <span class=\"provision-text\">23° sont supprimés;</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">la rubrique C. est complétée comme suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"24°\">\n              <span class=\"provision-text\">\" 24° L'Agence Fédérale pour la Sécurité de la Chaîne Alimentaire.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
