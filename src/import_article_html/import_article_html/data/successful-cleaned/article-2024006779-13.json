  "transformedHtml": "<article class=\"legal-article\" id=\"art-13\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 13</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">En ce qui concerne les instruments de subvention, visés à l'article 4, alinéa 4,</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1°</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">2°</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">4°</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5°</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">6°</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">7°</span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">8°</span></li>\n            </ol>\n            <p class=\"closing-text\">du Décret culturel supralocal du 8 mars 2024, les coûts subventionnables sont les coûts pour la réalisation d'activités subventionnées.</p>\n        </div>\n    </div>\n</article>",
