  "transformedHtml": "<article class=\"legal-article\" id=\"art-9/1-1-4\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 9/1.1.4</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2020-12-18/13\" data-law-type=\"AGF\" data-article-number=\"25\">\n        Les obligations visées aux articles 9/1.1.1 et 9/1.1.3 ne s'appliquent pas aux bâtiments ou aux bâtiments de parking pour lesquels une demande de permis d'environnement telle que visée à l'article 4.2.1,\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"1°\">\n            <span class=\"provision-text\">1°</span>\n          </li>\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">5°</span>\n          </li>\n          <li class=\"provision\" data-number=\"6°\">\n            <span class=\"provision-text\">6° du Code flamand de l'aménagement du territoire du 15 mai 2009 a été introduite avant le 11 mars 2021.</span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
