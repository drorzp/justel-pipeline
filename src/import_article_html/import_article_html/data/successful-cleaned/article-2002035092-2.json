  "transformedHtml": "<article class=\"legal-article\" id=\"art-2\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 2</h2>\n  </header>\n  <div class=\"article-content\">\n    <p class=\"intro-text\">A l'article 5 du même arrêté sont apportées les modifications suivantes :</p>\n    <ol class=\"numbered-provisions\">\n      <li class=\"provision\" data-number=\"1°\">\n        <span class=\"provision-text\">Au § 1er, 2°, sont ajoutés un septième et un huitième tiret, rédigés comme suit :</span>\n        <ul class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">instrument/jazz et musique légère,</span></li>\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">chant/jazz et musique légère;</span></li>\n        </ul>\n      </li>\n      <li class=\"provision\" data-number=\"2°\">\n        <span class=\"provision-text\">Au § 1er, 3°, sont ajoutés un huitième, neuvième, dixième, onzième et douzième tiret, rédigés comme suit :</span>\n        <ul class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">théorie musicale/jazz et musique légère,</span></li>\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">instrument/jazz et musique légère,</span></li>\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">jeu d'ensemble/jazz et musique légère,</span></li>\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">chant/jazz et musique légère,</span></li>\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">formation de la voix/jazz et musique légère;</span></li>\n        </ul>\n      </li>\n      <li class=\"provision\" data-number=\"3°\">\n        <span class=\"provision-text\">Au § 2 de la version néerlandaise du texte, le mot \"woord\" est remplacé par \"woordkunst\";</span>\n      </li>\n      <li class=\"provision\" data-number=\"4°\">\n        <span class=\"provision-text\">Au § 2, le point 1° est remplacé par ce qui suit :</span>\n        <ul class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"1°\"><span class=\"provision-text\">Au degré inférieur : arts de la parole, section \"jeunes\";</span></li>\n        </ul>\n      </li>\n      <li class=\"provision\" data-number=\"5°\">\n        <span class=\"provision-text\">Au § 2, le point 2° est remplacé par ce qui suit :</span>\n        <ol class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"a)\">\n            <span class=\"provision-text\">section \"jeunes\" : arts de la parole;</span>\n          </li>\n          <li class=\"sub-provision\" data-marker=\"b)\">\n            <span class=\"provision-text\">section \"adultes\" :</span>\n            <ul class=\"sub-provisions\">\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">théâtre;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">déclamation;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">éloquence.</span></li>\n            </ul>\n          </li>\n        </ol>\n      </li>\n      <li class=\"provision\" data-number=\"6°\">\n        <span class=\"provision-text\">Au § 2, 3°, est ajouté un quatrième tiret, rédigé ainsi qu'il suit :</span>\n        <ul class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">création littéraire;</span></li>\n        </ul>\n      </li>\n      <li class=\"provision\" data-number=\"7°\">\n        <span class=\"provision-text\">Au § 3, les points 2° et 3° sont remplacés par ce qui suit :</span>\n        <ol class=\"sub-provisions\">\n          <li class=\"sub-provision\" data-marker=\"2°\">\n            <span class=\"provision-text\">Au degré moyen :</span>\n            <ul class=\"sub-provisions\">\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse classique;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse contemporaine;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse et musique.</span></li>\n            </ul>\n          </li>\n          <li class=\"sub-provision\" data-marker=\"3°\">\n            <span class=\"provision-text\">Au degré supérieur :</span>\n            <ul class=\"sub-provisions\">\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse contemporaine;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse classique;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">danse et musique;</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"provision-text\">théorie de la danse.</span></li>\n            </ul>\n          </li>\n        </ol>\n      </li>\n    </ol>\n  </div>\n</article>",
