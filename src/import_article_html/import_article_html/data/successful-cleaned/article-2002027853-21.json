  "transformedHtml": "<article class=\"legal-article\" id=\"art-21\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 21</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 8, alinéa 2, du même arrêté est remplacé par la disposition suivante :</p>\n            <blockquote class=\"quoted-text\">\n                <p>Les services résidentiels de transition, les services d'aide à l'intégration et les services de placement familial ne sont pas tenus de fournir les documents prévus à l'alinéa 1er,</p>\n                <ol class=\"numbered-provisions\">\n                    <li class=\"provision\" data-number=\"6°\">\n                        <span class=\"provision-text\">6°</span>\n                    </li>\n                    <li class=\"provision\" data-number=\"7°\">\n                        <span class=\"provision-text\">7°, sauf s'ils accueillent de manière collective et permanente des bénéficiaires dans leurs locaux.</span>\n                    </li>\n                </ol>\n            </blockquote>\n        </div>\n    </div>\n</article>",
