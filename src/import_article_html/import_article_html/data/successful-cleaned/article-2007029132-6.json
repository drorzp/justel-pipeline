  "transformedHtml": "<article class=\"legal-article\" id=\"art-6\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 6</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 9 du même décret, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">Dans l'alinéa 1er, les mots \" un mois \" sont remplacés par les mots \" deux mois \";</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">Dans l'alinéa 2, sont apportées les modifications suivantes :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"provision-text\">Les 4° et 5° sont remplacés comme suit :</span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"4°\">\n                  <span class=\"provision-text\">les mesures prévues pour assurer la sécurité des participants;</span>\n                </li>\n                <li class=\"provision\" data-number=\"5°\">\n                  <span class=\"provision-text\">L'indication du (ou des) lieu(x) où se dérouleront les activités;</span>\n                </li>\n              </ol>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"provision-text\">Le 7° est abrogé.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
