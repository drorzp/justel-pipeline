  "transformedHtml": "<article class=\"legal-article\" id=\"art-10\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 10</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Le présent arrêté entre en vigueur le 1er juillet 2022, à l'exception de :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">l'article 2, l'article 3, 1° et 5°, et l'article 4, 3°,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"a)\">\n              <span class=\"sub-provision-text\">qui entrent en vigueur le 1er janvier 2022</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">l'article 3, 8° qui est d'application à partir du flux proactif de l'année 2022</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">l'article 4, 3°,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"b)\">\n              <span class=\"sub-provision-text\">qui entre en vigueur le 1er janvier 2023</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">l'article 4, 3°,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"c)\">\n              <span class=\"sub-provision-text\">qui entre en vigueur le 1er janvier 2024</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
