  "transformedHtml": "<article class=\"legal-article\" id=\"art-3\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 3</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 6, § 1er, du même arrêté, modifié par l'arrêté royal du 16 mars 1999 et par la loi du 10 décembre 2008, sont apportées les modifications suivantes:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">à l'alinéa 1er, 3°, 4°, 5° et 6°, les mots \" sur une liste double \" sont chaque fois supprimés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">\n            <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2022-10-26/06\" data-law-type=\"AR\" data-article-number=\"7\">...</span>\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">à l'alinéa 3, qui devient l'alinéa 4, les mots \" effectifs et suppléants \" sont ajoutés après les mots \" les membres \".</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
