  "transformedHtml": "<article class=\"legal-article\" id=\"art-45\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 45</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 38 du même décret, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">dans l'alinéa 2, 1°, les mots \"des comptes d'exécution du budget visés à l'article 16 et\" sont abrogés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">l'alinéa 3 est complété par les 5° et 6°, rédigés comme suit :</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"5°\">\n              <span class=\"provision-text\">les comptes d'exécution du budget visés à l'article 16;</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"6°\">\n              <span class=\"provision-text\">un récapitulatif des engagements ouverts au 31 décembre.</span>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
