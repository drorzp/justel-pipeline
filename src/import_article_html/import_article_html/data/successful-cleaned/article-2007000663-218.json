  "transformedHtml": "<article class=\"legal-article\" id=\"art-218\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 218</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p>Pour l'apport des biens meubles et <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"121\">...</span> visés <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"121\">à l'article 210, § 2</span>, <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"121\">...</span>, les communes perçoivent une indemnité qui est calculée sur la base des règles d'estimation visées <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-12-21/22\" data-law-type=\"L\" data-article-number=\"121\">à l'article 212</span>.</p>\n    </div>\n  </div>\n</article>",
