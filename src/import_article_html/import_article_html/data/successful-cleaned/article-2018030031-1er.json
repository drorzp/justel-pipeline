  "transformedHtml": "<article class=\"legal-article\" id=\"art-1er\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1er</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">Sont abrogées les dispositions suivantes de la loi du 13 juin 2006 modifiant la législation relative à la protection de la jeunesse et à la prise en charge des mineurs ayant commis un fait qualifié infraction :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">l'article 7, </span>\n                    <ol class=\"numbered-provisions\">\n                        <li class=\"sub-provision\" data-marker=\"2°\">\n                            <span class=\"provision-text\">en ce qu'il concerne le § 2, alinéa 1er, </span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"5°\">\n                            <span class=\"provision-text\"></span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"6°\">\n                            <span class=\"provision-text\"></span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"9°\">\n                            <span class=\"provision-text\"></span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"10°\">\n                            <span class=\"provision-text\">et </span>\n                        </li>\n                        <li class=\"sub-provision\" data-marker=\"11°\">\n                            <span class=\"provision-text\">, de l'article 37 de la loi du 8 avril 1965 ;</span>\n                        </li>\n                    </ol>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    