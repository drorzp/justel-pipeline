  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 1</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Pour l'application du présent arrêté, il faut entendre par :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">\"la loi\" : la loi du 28 février 2007 fixant le statut des militaires <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-10-14/13\" data-law-type=\"AR\" data-article-number=\"7\">et candidats militaires</span> du cadre actif des forces armées;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">\"l'instance\" : une des instances visées à l'article 2;</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">\"le comparant\" : <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-10-14/13\" data-law-type=\"AR\" data-article-number=\"7\">la personne</span> qui doit comparaître devant l'instance;</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">\"le défenseur\" : la personne désignée par le comparant pour l'assister ou le représenter pendant l'audience;</span>\n        </li>\n      </ol>\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2013-10-14/13\" data-law-type=\"AR\" data-article-number=\"7\">\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"5°\">\n            <span class=\"provision-text\">\"le stagiaire\" : le militaire ou le civil qui suit une formation continuée visée aux articles 111, 2° et 3°, et 112 de la loi;</span>\n          </li>\n          <li class=\"provision\" data-number=\"6°\">\n            <span class=\"provision-text\">\"le secrétariat permanent\" : le secrétariat mis en place de manière permanente auprès d'une instance.</span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
