  "transformedHtml": "<article class=\"legal-article\" id=\"art-55\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 55</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">L'article 48 du même arrêté royal, remplacé par le décret du 23 juin 2008 et modifié par le décret du 11 mai 2009, est remplacé par ce qui suit :</p>\n      <p class=\"intro-text\">\" L'article 168,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\"></span></li>\n        <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">et</span></li>\n        <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">, de l'arrêté royal du 22 mars 1969 fixant le statut des membres du personnel de l'enseignement communautaire est applicable aux membres du personnel visés à l'article 1er. \"</span></li>\n      </ol>\n    </div>\n  </div>\n</article>",
