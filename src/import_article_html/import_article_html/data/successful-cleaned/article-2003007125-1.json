  "transformedHtml": "<article class=\"legal-article\" id=\"art-1\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 1</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">A l'article 1er de l'arrêté royal du 10 juillet 2002 accordant une prime de restructuration à certains militaires, sont apportées les modifications suivantes:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\">\n                    <span class=\"provision-text\">au § 1er, alinéa 2, les 1° et 2° sont abrogés;</span>\n                </li>\n                <li class=\"provision\" data-number=\"2°\">\n                    <span class=\"provision-text\">au § 3, l'alinéa 1er est remplacé par l'alinéa suivant:<br>\" Le pourcentage visé au § 2, 2°, est fixé à 92 %. \" ;</span>\n                </li>\n                <li class=\"provision\" data-number=\"3°\">\n                    <span class=\"provision-text\">au § 3, les alinéas 4 et 5 sont abrogés.</span>\n                </li>\n            </ol>\n        </div>\n    </div>\n</article>",
