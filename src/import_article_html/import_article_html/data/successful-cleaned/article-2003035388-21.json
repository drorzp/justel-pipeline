  "transformedHtml": "<article class=\"legal-article\" id=\"art-21\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 21</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 14, § 3, du même arrêté, modifié par l'arrêté du Gouvernement flamand du 10 mars 1998, sont apportées les modifications suivantes :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">aux 10° et 11° les mots suivants sont chaque fois ajoutés dans la colonne droite : \"\n            <ul class=\"sub-provisions\">\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"sub-provision-text\">étude de répertoire arts de la parole'</span></li>\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"sub-provision-text\">drame</span></li>\n            </ul>\n            \";\n          </span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au 12° les mots suivants sont ajoutés dans la colonne droite : \"\n            <ul class=\"sub-provisions\">\n              <li class=\"sub-provision\" data-marker=\"-\"><span class=\"sub-provision-text\">etude de répertoire arts de la parole'</span></li>\n            </ul>\n            \".\n          </span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
