  "transformedHtml": "<article class=\"legal-article\" id=\"art-25\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 25</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Les résultats des épreuves de sélection sont communiqués par écrit au postulant endéans les cinq jours ouvrables suivant la date à laquelle les résultats sont fixés. Sont toutefois communiqués en même temps que la décision d'attribution ou non d'un poste vacant :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">les résultats des épreuves visées aux articles 32, <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2019-07-03/09\" data-law-type=\"AR\" data-article-number=\"2\">5°, 7° et 10°</span>, 33, <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2013-11-07/51\" data-law-type=\"AR\" data-article-number=\"22\">...</span> 35 et 36, 1°;</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\"><span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2013-11-07/51\" data-law-type=\"AR\" data-article-number=\"22\">le résultat de l'épreuve visée aux articles 32, 6°, et 41.</span> -1</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
