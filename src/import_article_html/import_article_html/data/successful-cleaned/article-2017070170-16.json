  "transformedHtml": "<article class=\"legal-article\" id=\"art-16\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 16</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">L'article 23 du même arrêté est remplacé par la disposition suivante :</p>\n            <p class=\"intro-text\">\" Art. 23. Outre les secteurs exclus à l'article 9, sont également exclus, pour les types de coûts admissibles visés à l'article 24, § 2, 1° à 3° et 5°, les secteurs visés suivants :</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">61.10;</span></li>\n                <li class=\"provision\" data-number=\"2°\"><span class=\"provision-text\">61.20;</span></li>\n                <li class=\"provision\" data-number=\"3°\"><span class=\"provision-text\">61.30;</span></li>\n                <li class=\"provision\" data-number=\"4°\"><span class=\"provision-text\">62.01;</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">62.02;</span></li>\n                <li class=\"provision\" data-number=\"6°\"><span class=\"provision-text\">62.03;</span></li>\n                <li class=\"provision\" data-number=\"7°\"><span class=\"provision-text\">62.09;</span></li>\n                <li class=\"provision\" data-number=\"8°\"><span class=\"provision-text\">63.12.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
