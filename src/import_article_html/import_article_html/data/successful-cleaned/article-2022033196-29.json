  "transformedHtml": "<article class=\"legal-article\" id=\"art-29\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 29</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans l'article 72, § 1er, du même arrêté royal, les modifications suivantes sont apportées:</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"a)\">\n          <span class=\"provision-text\">les 8° et 9° sont abrogés;</span>\n        </li>\n        <li class=\"provision\" data-number=\"b)\">\n          <span class=\"provision-text\">le 10° est remplacé par ce qui suit:</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"provision\" data-number=\"10°\">\n              <span class=\"provision-text\">lorsque le président le juge nécessaire et selon le cas:</span>\n              <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"a)\">\n                  <span class=\"provision-text\">les directeurs des cursus supérieurs de la formation continuée;</span>\n                </li>\n                <li class=\"provision\" data-number=\"b)\">\n                  <span class=\"provision-text\">le directeur de la formation pour candidat officier supérieur;</span>\n                </li>\n                <li class=\"provision\" data-number=\"c)\">\n                  <span class=\"provision-text\">le médecin du travail de l'établissement militaire où le stagiaire suit sa formation.</span>\n                </li>\n              </ol>\n            </li>\n          </ol>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
