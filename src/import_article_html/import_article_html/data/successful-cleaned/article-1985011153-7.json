  "transformedHtml": "<article class=\"legal-article\" id=\"art-7\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 7</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Hormis les cas prévus à l'article 5,</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">1°</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">3°</span>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">4°</span>\n        </li>\n      </ol>\n      <p class=\"closing-text\">les porteurs d'actions privilégiées sans droit de vote, sont considérés comme des tiers au regard des dispositions des articles 62, deuxième alinéa, et 64octies, deuxième alinéa, des lois coordonnées sur les sociétés commerciales.</p>\n    </div>\n  </div>\n</article>",
