  "transformedHtml": "<article class=\"legal-article\" id=\"art-34\">\n    <header class=\"article-header\">\n        <h2 class=\"article-number\">Article 34</h2>\n    </header>\n    <div class=\"article-content\">\n        <div class=\"article-text\">\n            <p class=\"intro-text\">La présente ordonnance entre en vigueur le premier jour du mois qui suit l'expiration d'un délai de dix jours prenant cours le jour suivant sa publication au Moniteur belge, à l'exception de l'article 4, points:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1° à 3°</span></li>\n                <li class=\"provision\" data-number=\"5°\"><span class=\"provision-text\">5° à 7°</span></li>\n                <li class=\"provision\" data-number=\"9°\"><span class=\"provision-text\">9° et 10°</span></li>\n            </ol>\n            <p class=\"intro-text\">des articles 5 à 11, 14, 15, 25, 26, 29, 31 et 32 qui entrent en vigueur le 1er janvier 2019 et de l'article 12,:</p>\n            <ol class=\"numbered-provisions\">\n                <li class=\"provision\" data-number=\"1°\"><span class=\"provision-text\">1° qui produit ses effets au 1er juillet 2017.</span></li>\n            </ol>\n        </div>\n    </div>\n</article>",
