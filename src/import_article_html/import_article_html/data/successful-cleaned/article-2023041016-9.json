  "transformedHtml": "<article class=\"legal-article\" id=\"art-9\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 9</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">A l'article 13 de la même loi, modifié par la loi du 4 juillet 2005, les modifications suivantes sont apportées :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">au paragraphe 1er, les points</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\">1°</span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\">2° sont abrogés</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">au paragraphe 1er,</span>\n          <ol>\n            <li class=\"sub-provision\" data-marker=\"3°\">\n              <span class=\"provision-text\">les mots \" ou celles qui sont mentionnées dans leur autorisation \" sont abrogés</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">le paragraphe 2, alinéa 1er, est abrogé.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
