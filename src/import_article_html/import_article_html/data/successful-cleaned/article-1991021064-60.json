  "transformedHtml": "<article class=\"legal-article\" id=\"art-60\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article 60</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <p class=\"intro-text\">Dans la loi du 19 juillet 1930 créant la Régie des télégraphes et des téléphones, sont abrogés :</p>\n      <ol class=\"numbered-provisions\">\n        <li class=\"provision\" data-number=\"1°\">\n          <span class=\"provision-text\">l'article 3, modifié par l'arrêté royal n° 91 du 11 novembre 1967</span>\n        </li>\n        <li class=\"provision\" data-number=\"2°\">\n          <span class=\"provision-text\">l'article 8, alinéas 2 et 3 et alinéa 4, modifié par l'arrêté royal n° 91 du 11 novembre 1967</span>\n        </li>\n        <li class=\"provision\" data-number=\"3°\">\n          <span class=\"provision-text\">l'article 10,</span>\n          <ol class=\"numbered-provisions\">\n            <li class=\"sub-provision\" data-marker=\"1°\">\n              <span class=\"provision-text\"></span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"2°\">\n              <span class=\"provision-text\"></span>\n            </li>\n            <li class=\"sub-provision\" data-marker=\"4°\">\n              <span class=\"provision-text\">et 5°, modifié par la loi du 18 janvier 1962</span>\n            </li>\n          </ol>\n        </li>\n        <li class=\"provision\" data-number=\"4°\">\n          <span class=\"provision-text\">les articles 11, 12 et 14</span>\n        </li>\n        <li class=\"provision\" data-number=\"5°\">\n          <span class=\"provision-text\">l'article 14bis, inséré par la loi du 18 janvier 1962</span>\n        </li>\n        <li class=\"provision\" data-number=\"6°\">\n          <span class=\"provision-text\">l'article 15, modifié par la loi du 23 décembre 1937</span>\n        </li>\n        <li class=\"provision\" data-number=\"7°\">\n          <span class=\"provision-text\">l'article 16</span>\n        </li>\n        <li class=\"provision\" data-number=\"8°\">\n          <span class=\"provision-text\">l'article 18, remplacé par la loi du 23 décembre 1937</span>\n        </li>\n        <li class=\"provision\" data-number=\"9°\">\n          <span class=\"provision-text\">l'article 19</span>\n        </li>\n        <li class=\"provision\" data-number=\"10°\">\n          <span class=\"provision-text\">l'article 20, remplacé par la loi du 23 décembre 1937.</span>\n        </li>\n      </ol>\n    </div>\n  </div>\n</article>",
