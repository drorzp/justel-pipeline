  "transformedHtml": "<article class=\"legal-article\" id=\"art-D49\">\n  <header class=\"article-header\">\n    <h2 class=\"article-number\">Article D49</h2>\n  </header>\n  <div class=\"article-content\">\n    <div class=\"article-text\">\n      <span class=\"footnote footnote-reference\" data-footnote-id=\"1\" data-dossier-number=\"2007-05-31/46\" data-law-type=\"DRW\" data-article-number=\"11\">\n        <p class=\"intro-text\">Pour l'application de la présente partie, on entend par \" permis \" :</p>\n        <ol class=\"numbered-provisions\">\n          <li class=\"provision\" data-number=\"a.\">\n            <span class=\"provision-text\">les permis d'environnement et les permis uniques;</span>\n          </li>\n          <li class=\"provision\" data-number=\"b.\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"5\" data-dossier-number=\"2016-07-20/46\" data-law-type=\"DRW\" data-article-number=\"9\">\n                les permis et les certificats d'urbanisme n° 2 accordés en vertu du CoDT;\n              </span>\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"c.\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"7\" data-dossier-number=\"2024-03-14/32\" data-law-type=\"DRW\" data-article-number=\"11\">...</span>;\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"d.\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"2\" data-dossier-number=\"2008-12-05/75\" data-law-type=\"DRW\" data-article-number=\"81\">\n                les projets d'assainissement \n                <span class=\"footnote footnote-reference\" data-footnote-id=\"6\" data-dossier-number=\"2018-03-01/32\" data-law-type=\"DRW\" data-article-number=\"90\">\n                  au sens du décret relatif du 1er mars 2018 à la gestion et à l'assainissement des sols\n                </span>;\n              </span>\n              [2 e.]2 les actes administratifs, enumérés par le Gouvernement, pris en application des lois, décrets et règlements, décidant de réaliser ou de permettre de réaliser un projet en tout ou partie;\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"f.\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"3\" data-dossier-number=\"2013-07-10/39\" data-law-type=\"DRW\" data-article-number=\"39\">\n                Les permis de stockage délivrés en vertu \n                <span class=\"footnote footnote-reference\" data-footnote-id=\"7\" data-dossier-number=\"2024-03-14/32\" data-law-type=\"DRW\" data-article-number=\"11\">\n                  Code de la gestion des ressources du sous-sol\n                </span>;\n              </span>\n            </span>\n          </li>\n          <li class=\"provision\" data-number=\"g)\">\n            <span class=\"provision-text\">\n              <span class=\"footnote footnote-reference\" data-footnote-id=\"4\" data-dossier-number=\"2015-02-05/07\" data-law-type=\"DRW\" data-article-number=\"108\">\n                les permis d'implantation commerciale et les permis intégrés au sens de l'article 1er, 4° et 5°, du décret relatif aux implantations commerciales.\n              </span>\n            </span>\n          </li>\n        </ol>\n      </span>\n    </div>\n  </div>\n</article>",
